<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CapstoneProjectPUSH.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CapstoneProjectPUSH"
    
    xmlns:admin="clr-namespace:CapstoneProjectPUSH.Views.Admin"
    xmlns:auth="clr-namespace:CapstoneProjectPUSH.Views.Auth"
    xmlns:base="clr-namespace:CapstoneProjectPUSH.Views.Base"
    xmlns:community="clr-namespace:CapstoneProjectPUSH.Views.Community"
    xmlns:exercises="clr-namespace:CapstoneProjectPUSH.Views.Exercises"
    xmlns:home="clr-namespace:CapstoneProjectPUSH.Views.Home"
    xmlns:profile="clr-namespace:CapstoneProjectPUSH.Views.Profile"
    xmlns:stats="clr-namespace:CapstoneProjectPUSH.Views.Stats"
    xmlns:trainers="clr-namespace:CapstoneProjectPUSH.Views.Trainers"
    xmlns:workouts="clr-namespace:CapstoneProjectPUSH.Views.Workouts"

    Title="CapstoneProjectPUSH">

    <ShellContent
        Title="FirstLoadingPage"
        ContentTemplate="{DataTemplate base:FirstLoadingPage}"
        Route="FirstLoadingPage"
        FlyoutItemIsVisible="False"/>

    <ShellContent
        Title="LandingPage"
        ContentTemplate="{DataTemplate base:LandingPage}"
        Route="LandingPage"
        FlyoutItemIsVisible="False"/>

    <FlyoutItem
        Icon="house.svg"
        Title="Home">

        <Tab>

            <ShellContent
                ContentTemplate="{DataTemplate home:HomePage}"
                Route="HomePage"/>

        </Tab>

    </FlyoutItem>


    <FlyoutItem
        Icon="stopwatch.svg"
        Title="Workouts">

        <Tab>

            <ShellContent
                ContentTemplate="{DataTemplate workouts:WorkoutsPage}"
                Route="WorkoutsPage"/>

        </Tab>

    </FlyoutItem>

    <FlyoutItem
        Icon="people.svg"
        Title="Community Workouts">

        <Tab>

            <ShellContent
                ContentTemplate="{DataTemplate community:CommunityWorkoutsPage}"
                Route="CommunityWorkoutsPage"/>

        </Tab>

    </FlyoutItem>

    <FlyoutItem
        Icon="person_walking.svg"
        Title="Exercises">

        <Tab>

            <ShellContent
                ContentTemplate="{DataTemplate exercises:ExercisesPage}"
                Route="ExercisesPage"/>

        </Tab>

    </FlyoutItem>

    <FlyoutItem
        Icon="graph_up.svg"
        Title="Stats">

        <Tab>

            <ShellContent
                ContentTemplate="{DataTemplate stats:StatsPage}"
                Route="StatsPage"/>

        </Tab>

    </FlyoutItem>

    <FlyoutItem
        Icon="person_vcard.svg"
        Title="Trainers">

        <Tab>

            <ShellContent
                ContentTemplate="{DataTemplate trainers:TrainersPage}"
                Route="TrainersPage"/>

        </Tab>

    </FlyoutItem>

    <FlyoutItem
        Icon="person.svg"
        Title="Profile">

        <Tab>

            <ShellContent
                ContentTemplate="{DataTemplate profile:ProfilePage}"
                Route="ProfilePage"/>

        </Tab>

    </FlyoutItem>

</Shell>