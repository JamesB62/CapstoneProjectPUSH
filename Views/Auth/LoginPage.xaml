<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CapstoneProjectPUSH.Views.Auth.LoginPage"
             Title="">

    <ScrollView>
        
        <Grid
            Padding="20,0,20,20"
            VerticalOptions="Center">

            <Border
                Padding="30"
                StrokeShape="RoundRectangle 10">

                <VerticalStackLayout
                    Spacing="15">

                    <!-- Branding -->
                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="10">

                        <!-- Placeholder logo -->
                        <Border
                            HeightRequest="50"
                            StrokeShape="RoundRectangle 10"
                            WidthRequest="50">

                            <Label
                                FontAttributes="Bold"
                                FontSize="10"
                                HorizontalOptions="Center"
                                Text="Logo"
                                VerticalOptions="Center"/>

                        </Border>

                        <Label
                            FontSize="26"
                            FontAttributes="Bold"
                            Text="PUSH"
                            VerticalOptions="Center"/>

                    </HorizontalStackLayout>

                    <Label
                        HorizontalOptions="Center"
                        Text="Log in to your PUSH account"/>

                    <!-- Login form -->
                    <Entry
                        Keyboard="Email"
                        Margin="0,-10,0,-5"
                        Placeholder="Enter your email address here"
                        Text="{Binding Email}"/>

                    <Entry
                        IsPassword="True"
                        Margin="0,-10,0,-5"
                        Placeholder="Enter your password here"
                        Text="{Binding Password}"/>

                    <!-- Error message -->
                    <Label
                        IsVisible="{Binding HasErrorMessage}"
                        Text="{Binding ErrorMessage}"
                        TextColor="Red"/>

                    <Button
                        Command="{Binding LoginCommand}"
                        FontAttributes="Bold"
                        IsEnabled="{Binding IsNotBusy}"
                        Text="Log In"/>

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"/>

                    <Label
                        Text="Don't have an account? Tap here to register">

                        <Label.GestureRecognizers>

                            <TapGestureRecognizer
                                Command="{Binding GoToRegisterCommand}"/>

                        </Label.GestureRecognizers>

                    </Label>

                </VerticalStackLayout>
                
            </Border>
            
        </Grid>
        
    </ScrollView>

</ContentPage>