<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Auth"
             x:Class="CapstoneProjectPUSH.Views.Auth.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="">

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30,20,30,20"
            Spacing="20"
            VerticalOptions="Center">

            <!-- Branding -->
            <VerticalStackLayout
                Spacing="10">

                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="10">

                    <!-- Logo placeholder -->
                    <Border
                        Style="{StaticResource LogoFrame}">

                        <Label
                            Style="{StaticResource LogoPlaceholderLabel}"
                            Text="Logo"/>

                    </Border>

                    <Label
                        Style="{StaticResource BrandTitle}"
                        Text="PUSH"/>

                </HorizontalStackLayout>

                <Label
                    HorizontalOptions="Center"
                    Style="{StaticResource CardBody}"
                    Text="Log in to your PUSH account"/>

            </VerticalStackLayout>

            <!-- Email -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Email"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Entry
                        IsEnabled="{Binding IsNotBusy}"
                        Keyboard="Email"
                        Placeholder="Enter your email address here"
                        ReturnType="Next"
                        SemanticProperties.Hint="Email"
                        Text="{Binding Email}"/>

                </Border>

            </VerticalStackLayout>

            <!-- Password -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Password"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Entry
                        IsEnabled="{Binding IsNotBusy}"
                        IsPassword="True"
                        Placeholder="Enter your password here"
                        ReturnCommand="{Binding LoginCommand}"
                        ReturnType="Done"
                        SemanticProperties.Hint="Password"
                        Text="{Binding Password}"/>

                </Border>

            </VerticalStackLayout>

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"/>

            <!-- Buttons -->
            <VerticalStackLayout
                Spacing="10">

                <!-- Login button -->
                <Button
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Text="Log In"/>

                <Button
                    Command="{Binding GoToForgotPasswordCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource SecondaryButton}"
                    Text="Forgot password?"/>

            </VerticalStackLayout>

            <!-- Register link -->
            <Label
                HorizontalTextAlignment="Center"
                SemanticProperties.Hint="Opens the registration page"
                Style="{StaticResource LinkLabel}"
                Text="Don't have an account? Tap here to register">

                <Label.GestureRecognizers>

                    <TapGestureRecognizer
                        Command="{Binding GoToRegisterCommand}"/>

                </Label.GestureRecognizers>

            </Label>

            <!-- Loading indicator -->
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                SemanticProperties.Description="Logging in"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>