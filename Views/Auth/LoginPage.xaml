<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Auth"
             x:Class="CapstoneProjectPUSH.Views.Auth.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="">

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30,0,30,30"
            Spacing="20"
            VerticalOptions="Center">

            <!-- Branding -->
            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="10">

                <!-- Logo placeholder -->
                <Border
                    HeightRequest="50"
                    StrokeShape="RoundRectangle 10"
                    WidthRequest="50">

                    <Label
                        FontAttributes="Bold"
                        FontSize="10"
                        HorizontalOptions="Center"
                        Text="Logo"
                        VerticalOptions="Center"/>

                </Border>

                <Label
                    FontSize="21"
                    FontAttributes="Bold"
                    Text="PUSH"
                    VerticalOptions="Center"/>

            </HorizontalStackLayout>

            <Label
                HorizontalOptions="Center"
                Text="Log in to your PUSH account"/>

            <!-- Login form -->
            <VerticalStackLayout
                Spacing="5">

                <Entry
                    IsEnabled="{Binding IsNotBusy}"
                    Keyboard="Email"
                    Placeholder="Enter your email address here"
                    Text="{Binding Email}"/>

                <Entry
                    IsEnabled="{Binding IsNotBusy}"
                    IsPassword="True"
                    Placeholder="Enter your password here"
                    Text="{Binding Password}"/>

            </VerticalStackLayout>

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Text="{Binding ErrorMessage}"
                TextColor="Red"/>

            <!-- Login button -->
            <Button
                Command="{Binding LoginCommand}"
                FontAttributes="Bold"
                IsEnabled="{Binding IsNotBusy}"
                Text="Log In"/>

            <!-- Register link -->
            <Label
                Text="Don't have an account? Tap here to register"
                TextDecorations="Underline">

                <Label.GestureRecognizers>

                    <TapGestureRecognizer
                        Command="{Binding GoToRegisterCommand}"/>

                </Label.GestureRecognizers>

            </Label>

            <!-- Loading circle -->
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                Margin="0,10,0,0"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>