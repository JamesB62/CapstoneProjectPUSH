<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CapstoneProjectPUSH.Views.Auth.RegisterPage"
             Title="">

    <ScrollView>
        
        <Grid
            Padding="20,0,20,20"
            VerticalOptions="Center">
            
            <Border
                Padding="30"
                StrokeShape="RoundRectangle 10">

                <VerticalStackLayout
                    Spacing="15">

                    <!-- Branding -->
                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="10">

                        <!-- Placeholder logo -->
                        <Border
                            HeightRequest="50"
                            StrokeShape="RoundRectangle 12"
                            WidthRequest="50">

                            <Label
                                FontAttributes="Bold"
                                FontSize="10"
                                HorizontalOptions="Center"
                                Text="Logo"
                                VerticalOptions="Center"/>

                        </Border>

                        <Label
                            FontSize="26"
                            FontAttributes="Bold"
                            Text="PUSH"
                            VerticalOptions="Center"/>

                    </HorizontalStackLayout>

                    <Label
                        HorizontalOptions="Center"
                        Text="Create your PUSH account"/>

                    <VerticalStackLayout
                        Spacing="10">

                        <Entry
                            Placeholder="Enter your display name here"
                            Text="{Binding DisplayName}"/>

                        <Entry
                            Keyboard="Email"
                            Placeholder="Enter your email address here"
                            Text="{Binding Email}"/>

                        <Entry
                            IsPassword="True"
                            Placeholder="Enter your password here"
                            Text="{Binding Password}"/>

                        <Entry
                            IsPassword="True"
                            Placeholder="Confirm your password here"
                            Text="{Binding ConfirmPassword}"/>

                        <Label
                            FontAttributes="Italic"
                            FontSize="14"
                            Text="{Binding PasswordRequirements}"/>

                        <!-- Not implemented yet -->
                        <HorizontalStackLayout>

                            <CheckBox
                                IsChecked="False"/>

                            <Label
                                Text="Privacy Consent"
                                VerticalOptions="Center"/>

                        </HorizontalStackLayout>

                        <!-- Privacy link -->
                        <Label
                            Text="View Privacy Statement">

                            <Label.GestureRecognizers>

                                <TapGestureRecognizer
                                    Command="{Binding GoToPrivacyCommand}"/>

                            </Label.GestureRecognizers>

                        </Label>

                        <Label
                            IsVisible="{Binding HasErrorMessage}"
                            Text="{Binding ErrorMessage}"
                            TextColor="Red"/>

                    </VerticalStackLayout>
                    
                    <Button 
                        Command="{Binding RegisterCommand}"
                        FontAttributes="Bold"
                        IsEnabled="{Binding IsNotBusy}"
                        Text="Register"/>

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"/>

                    <Label
                        Text="Already have an account? Tap here to log in">

                        <Label.GestureRecognizers>

                            <TapGestureRecognizer
                                Command="{Binding GoToLoginCommand}"/>

                        </Label.GestureRecognizers>

                    </Label>

                </VerticalStackLayout>
                
            </Border>
            
        </Grid>
        
    </ScrollView>

</ContentPage>