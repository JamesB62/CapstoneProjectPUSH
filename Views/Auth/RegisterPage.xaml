<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CapstoneProjectPUSH.Views.Auth.RegisterPage"
             Title="">

    <ScrollView>

        <VerticalStackLayout
            Padding="30,0,30,30"
            Spacing="15"
            VerticalOptions="Center">

            <!-- Branding -->
            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="10">

                <!-- Logo placeholder -->
                <Border
                    HeightRequest="50"
                    StrokeShape="RoundRectangle 12"
                    WidthRequest="50">

                    <Label
                        FontAttributes="Bold"
                        FontSize="10"
                        HorizontalOptions="Center"
                        Text="Logo"
                        VerticalOptions="Center"/>

                </Border>

                <Label
                    FontSize="21"
                    FontAttributes="Bold"
                    Text="PUSH"
                    VerticalOptions="Center"/>

            </HorizontalStackLayout>

            <Label
                HorizontalOptions="Center"
                Text="Create your PUSH account"/>

            <!-- Register form -->
            <VerticalStackLayout
                Spacing="5">

                <Entry
                    IsEnabled="{Binding IsNotBusy}"
                    Placeholder="Enter your display name here"
                    Text="{Binding DisplayName}"/>

                <Entry
                    IsEnabled="{Binding IsNotBusy}"
                    Keyboard="Email"
                    Placeholder="Enter your email address here"
                    Text="{Binding Email}"/>

                <Entry
                    IsEnabled="{Binding IsNotBusy}"
                    IsPassword="True"
                    Placeholder="Enter your password here"
                    Text="{Binding Password}"/>

                <Entry
                    IsEnabled="{Binding IsNotBusy}"
                    IsPassword="True"
                    Placeholder="Confirm your password here"
                    Text="{Binding ConfirmPassword}"/>

                <Label
                    FontAttributes="Italic"
                    FontSize="14"
                    Text="{Binding PasswordRequirements}"/>

                <!-- Privacy consent check -->
                <HorizontalStackLayout
                    Margin="0,0,0,-5"
                    Spacing="-5">

                    <CheckBox
                        IsChecked="{Binding HasAcceptedPrivacy}"
                        IsEnabled="{Binding IsNotBusy}"/>

                    <!-- Privacy statement link -->
                    <Label
                        Text="Privacy Consent"
                        TextDecorations="Underline"
                        VerticalOptions="Center">

                        <Label.GestureRecognizers>

                            <TapGestureRecognizer
                                Command="{Binding GoToPrivacyCommand}"/>

                        </Label.GestureRecognizers>

                    </Label>

                </HorizontalStackLayout>

            </VerticalStackLayout>

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Text="{Binding ErrorMessage}"
                TextColor="Red"/>

            <!-- Register button -->
            <Button
                Command="{Binding RegisterCommand}"
                FontAttributes="Bold"
                IsEnabled="{Binding IsNotBusy}"
                Text="Register"/>

            <!-- Login link -->
            <Label
                Text="Already have an account? Tap here to log in"
                TextDecorations="Underline">

                <Label.GestureRecognizers>

                    <TapGestureRecognizer
                        Command="{Binding GoToLoginCommand}"/>

                </Label.GestureRecognizers>

            </Label>

            <!-- Adjust margin value? -->
            <!-- Loading circle -->
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                Margin="0,10,0,0"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>