<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Auth"
             x:Class="CapstoneProjectPUSH.Views.Auth.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="">

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30,20,30,20"
            Spacing="20"
            VerticalOptions="Center">

            <!-- Branding -->
            <VerticalStackLayout
                Spacing="10">

                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="10">

                    <!-- Logo -->
                    <Image
                        AutomationProperties.IsInAccessibleTree="False"
                        HeightRequest="50"
                        Source="push.svg"
                        WidthRequest="50"/>

                    <Label
                        Style="{StaticResource BrandTitle}"
                        Text="PUSH"/>

                </HorizontalStackLayout>

                <Label
                    HorizontalOptions="Center"
                    Style="{StaticResource CardBody}"
                    Text="Create your PUSH account"/>

            </VerticalStackLayout>

            <!-- Display name -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Display Name"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Entry
                        IsEnabled="{Binding IsNotBusy}"
                        Placeholder="Enter your display name here"
                        ReturnType="Next"
                        SemanticProperties.Hint="Display name"
                        Text="{Binding DisplayName}"/>

                </Border>

            </VerticalStackLayout>

            <!-- Email -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Email"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Entry
                        IsEnabled="{Binding IsNotBusy}"
                        Keyboard="Email"
                        Placeholder="Enter your email address here"
                        ReturnType="Next"
                        SemanticProperties.Hint="Email"
                        Text="{Binding Email}"/>

                </Border>

            </VerticalStackLayout>

            <!-- Password -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Password"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Entry
                        IsEnabled="{Binding IsNotBusy}"
                        IsPassword="True"
                        Placeholder="Enter your password here"
                        ReturnType="Next"
                        SemanticProperties.Hint="Password"
                        Text="{Binding Password}"/>

                </Border>

                <Label
                    Style="{StaticResource HintLabel}"
                    Text="{Binding PasswordRequirements}"/>

            </VerticalStackLayout>

            <!-- Confirm password -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Confirm Password"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Entry
                        IsEnabled="{Binding IsNotBusy}"
                        IsPassword="True"
                        Placeholder="Enter your password again"
                        ReturnType="Done"
                        SemanticProperties.Hint="Confirm password"
                        Text="{Binding ConfirmPassword}"/>

                </Border>

            </VerticalStackLayout>

            <!-- Privacy consent -->
            <Grid
                ColumnDefinitions="Auto,Auto,*"
                ColumnSpacing="0">

                <CheckBox
                    Grid.Column="0"
                    IsChecked="{Binding HasAcceptedPrivacy}"
                    IsEnabled="{Binding IsNotBusy}"
                    SemanticProperties.Description="I accept the privacy consent"
                    VerticalOptions="Center"/>

                <Label
                    Grid.Column="1"
                    AutomationProperties.IsInAccessibleTree="False"
                    Text="I accept the "
                    VerticalOptions="Center"/>

                <Label
                    Grid.Column="2"
                    SemanticProperties.Hint="Opens the privacy statement"
                    Style="{StaticResource LinkLabel}"
                    Text="Privacy Consent"
                    VerticalOptions="Center">

                    <Label.GestureRecognizers>

                        <TapGestureRecognizer
                            Command="{Binding GoToPrivacyCommand}"/>

                    </Label.GestureRecognizers>

                </Label>

            </Grid>

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"/>

            <!-- Register button -->
            <Button
                Command="{Binding RegisterCommand}"
                IsEnabled="{Binding IsNotBusy}"
                Text="Register"/>

            <!-- Login link -->
            <Label
                HorizontalOptions="Center"
                SemanticProperties.Hint="Opens the log in page"
                Style="{StaticResource LinkLabel}"
                Text="Already have an account? Tap here to log in">

                <Label.GestureRecognizers>

                    <TapGestureRecognizer
                        Command="{Binding GoToLoginCommand}"/>

                </Label.GestureRecognizers>

            </Label>

            <!-- Loading circle -->
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                SemanticProperties.Description="Creating your account"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>