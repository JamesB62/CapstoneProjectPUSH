<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CapstoneProjectPUSH.Views.Auth.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Auth"
    Title="Reset Password"
    x:DataType="vm:ForgotPasswordViewModel">

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30,20,30,20"
            Spacing="20">

            <!--  Email  -->
            <VerticalStackLayout
                IsVisible="{Binding IsEmailStep}"
                Spacing="20">

                <Label
                    Text="Enter your account email and we'll send you a reset code."/>

                <!-- Email entry -->
                <VerticalStackLayout
                    Spacing="10">

                    <Label
                        Style="{StaticResource FieldLabel}"
                        Text="Email"/>

                    <Border
                        Style="{StaticResource InputFrame}">

                        <Entry
                            Keyboard="Email"
                            Placeholder="Enter your email here"
                            ReturnCommand="{Binding SendCodeCommand}"
                            ReturnType="Send"
                            SemanticProperties.Hint="Email"
                            Text="{Binding Email}"/>

                    </Border>

                </VerticalStackLayout>

                <!-- Error message -->
                <Label
                    IsVisible="{Binding HasErrorMessage}"
                    Style="{StaticResource ErrorLabel}"
                    Text="{Binding ErrorMessage}"/>

                <!-- Button -->
                <Button
                    Command="{Binding SendCodeCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Text="Send Code"/>

            </VerticalStackLayout>

            <!--  Response code  -->
            <VerticalStackLayout
                IsVisible="{Binding IsCodeStep}"
                Spacing="20">

                <Label
                    Text="If an account exists for that email, a 6-digit code has been sent. It expires in 15 minutes." />

                <!-- Code -->
                <VerticalStackLayout
                    Spacing="10">

                    <Label
                        Style="{StaticResource FieldLabel}"
                        Text="Reset Code"/>

                    <Border
                        Style="{StaticResource InputFrame}">

                        <Entry
                            Keyboard="Numeric"
                            MaxLength="6"
                            Placeholder="6-digit code"
                            ReturnType="Next"
                            SemanticProperties.Hint="6-digit reset code"
                            Text="{Binding Code}"/>

                    </Border>

                </VerticalStackLayout>

                <!-- New password -->
                <VerticalStackLayout
                    Spacing="10">

                    <Label
                        Style="{StaticResource FieldLabel}"
                        Text="New Password"/>

                    <Border
                        Style="{StaticResource InputFrame}">

                        <Entry
                            IsPassword="True"
                            Placeholder="Enter a new password"
                            ReturnType="Next"
                            SemanticProperties.Hint="New password"
                            Text="{Binding NewPassword}"/>

                    </Border>

                </VerticalStackLayout>

                <!-- Confirm password -->
                <VerticalStackLayout
                    Spacing="10">

                    <Label
                        Style="{StaticResource FieldLabel}"
                        Text="Confirm New Password"/>

                    <Border
                        Style="{StaticResource InputFrame}">

                        <Entry
                            IsPassword="True"
                            Placeholder="Enter the new password again"
                            ReturnCommand="{Binding ResetPasswordCommand}"
                            ReturnType="Done"
                            SemanticProperties.Hint="Confirm new password"
                            Text="{Binding ConfirmPassword}"/>

                    </Border>

                </VerticalStackLayout>

                <!-- Error message -->
                <Label
                    IsVisible="{Binding HasErrorMessage}"
                    Style="{StaticResource ErrorLabel}"
                    Text="{Binding ErrorMessage}"/>

                <!-- Buttons -->
                <VerticalStackLayout
                    Spacing="10">

                    <Button
                        Command="{Binding ResetPasswordCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        Text="Reset Password"/>

                    <Button
                        Command="{Binding UseDifferentEmailCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        Style="{StaticResource SecondaryButton}"
                        Text="Use a Different Email"/>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>