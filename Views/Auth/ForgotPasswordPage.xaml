<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CapstoneProjectPUSH.Views.Auth.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Auth"
    Title="Reset Password"
    x:DataType="vm:ForgotPasswordViewModel">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,15"
            MaximumWidthRequest="500"
            Spacing="12">

            <!--  email  -->
            <VerticalStackLayout IsVisible="{Binding IsEmailStep}" Spacing="12">
                <Label Text="Enter your account email and we'll send you a reset code." />
                <Entry
                    Keyboard="Email"
                    Placeholder="Email"
                    Text="{Binding Email}" />
                <Button Command="{Binding SendCodeCommand}" Text="Send code" />
            </VerticalStackLayout>

            <!--  code  -->
            <VerticalStackLayout IsVisible="{Binding IsCodeStep}" Spacing="12">
                <Label Text="If an account exists for that email, a 6-digit code has been sent. It expires in 15 minutes." />
                <Entry
                    Keyboard="Numeric"
                    MaxLength="6"
                    Placeholder="6-digit code"
                    Text="{Binding Code}" />
                <Entry
                    IsPassword="True"
                    Placeholder="New password"
                    Text="{Binding NewPassword}" />
                <Entry
                    IsPassword="True"
                    Placeholder="Confirm new password"
                    Text="{Binding ConfirmPassword}" />


                <Button Command="{Binding ResetPasswordCommand}" Text="Reset password" />

                
                <Button
                    BackgroundColor="Transparent"
                    Command="{Binding UseDifferentEmailCommand}"
                    Text="Use a different email" />
            </VerticalStackLayout>

            <Label
                IsVisible="{Binding HasErrorMessage}"
                Text="{Binding ErrorMessage}"
                TextColor="Red" />

        </VerticalStackLayout>
    </ScrollView>


</ContentPage>
