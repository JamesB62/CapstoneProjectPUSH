<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Trainers"
             x:Class="CapstoneProjectPUSH.Views.Trainers.CreateTrainerPage"
             x:DataType="vm:CreateTrainerViewModel"
             Title="{Binding PageTitle}">

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30"
            Spacing="20">

            <!-- Trainer form -->
            <VerticalStackLayout>

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Photo"/>

                <Grid
                    ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="10">

                    <Label
                        Grid.Column="0"
                        FontSize="14"
                        Text="{Binding PhotoStatusText}"
                        VerticalOptions="Center"/>

                    <Button
                        Grid.Column="1"
                        Command="{Binding ChangePhotoCommand}"
                        Text="Change"/>

                    <Button
                        Grid.Column="2"
                        Command="{Binding RemovePhotoCommand}"
                        IsVisible="{Binding HasProfileImage}"
                        Text="Remove"/>

                </Grid>

            </VerticalStackLayout>

            <VerticalStackLayout>

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="First Name"/>

                <Entry
                    MaxLength="60"
                    Placeholder="Enter the trainer's first name here"
                    Text="{Binding FirstName}"/>

            </VerticalStackLayout>

            <VerticalStackLayout>

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Last Name"/>

                <Entry
                    MaxLength="60"
                    Placeholder="Enter the trainer's last name here"
                    Text="{Binding LastName}"/>

            </VerticalStackLayout>

            <!-- Contact (at least one required) -->
            <VerticalStackLayout>

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Contact Details"/>

                <Label
                    FontSize="14"
                    Margin="0,10,0,0"
                    Text="Enter an email address, a phone number, or both."/>

                <VerticalStackLayout
                    Spacing="5">

                    <Entry
                        Keyboard="Email"
                        MaxLength="250"
                        Placeholder="Enter the trainer's email address here"
                        Text="{Binding Email}"/>

                    <Entry
                        Keyboard="Telephone"
                        MaxLength="20"
                        Placeholder="Enter the trainer's phone number here"
                        Text="{Binding PhoneNumber}"/>

                </VerticalStackLayout>

            </VerticalStackLayout>

            <VerticalStackLayout>

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Specialty"/>

                <Picker
                    ItemDisplayBinding="{Binding Title, x:DataType=models:Category}"
                    ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding SelectedCategory}"
                    Title="Choose a specialty"/>

            </VerticalStackLayout>

            <VerticalStackLayout>

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Gym"/>

                <Picker
                    ItemDisplayBinding="{Binding NameAndCity, x:DataType=models:Gym}"
                    ItemsSource="{Binding Gyms}"
                    SelectedItem="{Binding SelectedGym}"
                    Title="Choose a gym"/>

            </VerticalStackLayout>

            <VerticalStackLayout>

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="About"/>

                <Editor
                    AutoSize="TextChanges"
                    MaxLength="1000"
                    MinimumHeightRequest="100"
                    Placeholder="Write a short description (optional)"
                    Text="{Binding Description}"/>

            </VerticalStackLayout>

            <!-- Availability -->
            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="10"
                Margin="0,-15">

                <Label
                    Grid.Column="0"
                    FontSize="14"
                    Text="Available for new clients"
                    VerticalOptions="Center"/>

                <Switch
                    Grid.Column="1"
                    IsToggled="{Binding Available}"
                    VerticalOptions="Center"/>

            </Grid>

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Text="{Binding ErrorMessage}"
                TextColor="Red"/>

            <!-- Buttons -->
            <VerticalStackLayout
                Margin="0,5,0,0"
                Spacing="10">

                <Button
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Text="{Binding SaveButtonText}"/>

                <Button
                    Command="{Binding CancelCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Text="Cancel"/>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>