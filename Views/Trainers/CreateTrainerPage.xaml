<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Trainers"
             x:Class="CapstoneProjectPUSH.Views.Trainers.CreateTrainerPage"
             x:DataType="vm:CreateTrainerViewModel"
             Title="{Binding PageTitle}">

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30,20,30,20"
            Spacing="20">

            <!-- Photo -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Photo"/>

                <Grid
                    ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="10">

                    <Label
                        Grid.Column="0"
                        Style="{StaticResource CardBody}"
                        Text="{Binding PhotoStatusText}"
                        VerticalOptions="Center"/>

                    <Button
                        Command="{Binding ChangePhotoCommand}"
                        Grid.Column="1"
                        SemanticProperties.Description="Change photo"
                        Style="{StaticResource SecondaryButton}"
                        Text="Change"/>

                    <Button
                        Command="{Binding RemovePhotoCommand}"
                        Grid.Column="2"
                        IsVisible="{Binding HasProfileImage}"
                        SemanticProperties.Description="Remove photo"
                        Style="{StaticResource SecondaryButton}"
                        Text="Remove"/>

                </Grid>

            </VerticalStackLayout>

            <!-- First name -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="First Name"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Entry
                        MaxLength="60"
                        Placeholder="Enter the trainer's first name here"
                        ReturnType="Next"
                        SemanticProperties.Hint="First name"
                        Text="{Binding FirstName}"/>

                </Border>

            </VerticalStackLayout>

            <!-- Last name -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Last Name"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Entry
                        MaxLength="60"
                        Placeholder="Enter the trainer's last name here"
                        ReturnType="Next"
                        SemanticProperties.Hint="Last name"
                        Text="{Binding LastName}"/>

                </Border>

            </VerticalStackLayout>

            <!-- Contact (at least one required) -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Contact Details"/>

                <Label
                    Style="{StaticResource HintLabel}"
                    Text="Enter an email address, a phone number, or both."/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Entry
                        Keyboard="Email"
                        MaxLength="250"
                        Placeholder="Enter the trainer's email address here"
                        ReturnType="Next"
                        SemanticProperties.Hint="Email address"
                        Text="{Binding Email}"/>

                </Border>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Entry
                        Keyboard="Telephone"
                        MaxLength="20"
                        Placeholder="Enter the trainer's phone number here"
                        ReturnType="Next"
                        SemanticProperties.Hint="Phone number"
                        Text="{Binding PhoneNumber}"/>

                </Border>

            </VerticalStackLayout>

            <!-- Specialty -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Specialty"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Picker
                        ItemDisplayBinding="{Binding Title, x:DataType=models:Category}"
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory}"
                        SemanticProperties.Hint="Specialty"
                        Title="Choose a specialty"/>

                </Border>

            </VerticalStackLayout>

            <!-- Gym -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Gym"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Picker
                        ItemDisplayBinding="{Binding NameAndCity, x:DataType=models:Gym}"
                        ItemsSource="{Binding Gyms}"
                        SelectedItem="{Binding SelectedGym}"
                        SemanticProperties.Hint="Gym"
                        Title="Choose a gym"/>

                </Border>

            </VerticalStackLayout>

            <!-- About -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="About"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Editor
                        AutoSize="TextChanges"
                        MaxLength="1000"
                        MinimumHeightRequest="100"
                        Placeholder="Write a short description (optional)"
                        SemanticProperties.Hint="Short description (optional)"
                        Text="{Binding Description}"/>

                </Border>

            </VerticalStackLayout>

            <!-- Availability -->
            <VerticalStackLayout
                Spacing="10">

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="10">

                    <Label
                        AutomationProperties.IsInAccessibleTree="False"
                        Grid.Column="0"
                        Style="{StaticResource FieldLabel}"
                        Text="Available for New Clients"
                        VerticalOptions="Center"/>

                    <Switch
                        Grid.Column="1"
                        IsToggled="{Binding Available}"
                        SemanticProperties.Description="Available for new clients"
                        SemanticProperties.Hint="Turn on if the trainer is available for new clients"
                        VerticalOptions="Center"/>

                </Grid>

                <Label
                    AutomationProperties.IsInAccessibleTree="False"
                    Style="{StaticResource HintLabel}"
                    Text="Turn on if the trainer is available for new clients"/>

            </VerticalStackLayout>

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"/>

            <!-- Buttons -->
            <VerticalStackLayout
                Spacing="10">

                <Button
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Text="{Binding SaveButtonText}"/>

                <Button
                    Command="{Binding CancelCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource SecondaryButton}"
                    Text="Cancel"/>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>