<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Trainers"
             x:Class="CapstoneProjectPUSH.Views.Trainers.TrainerDetailsPage"
             x:DataType="vm:TrainerDetailsViewModel"
             Title="PUSH Trainer Details">

    <ContentPage.ToolbarItems>

        <ToolbarItem
            x:Name="EditToolbarItem"
            Command="{Binding EditTrainerCommand}"
            Order="Secondary"
            Text="Edit Trainer"/>

        <ToolbarItem
            x:Name="DeleteToolbarItem"
            Command="{Binding DeleteTrainerCommand}"
            Order="Secondary"
            Text="Delete Trainer"/>

    </ContentPage.ToolbarItems>

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30"
            Spacing="15">

            <Border
                HeightRequest="100"
                HorizontalOptions="Center"
                StrokeShape="Ellipse"
                StrokeThickness="0"
                WidthRequest="100">

                <Image
                    Aspect="AspectFill"
                    Source="{Binding Trainer.ProfileImage}"/>

            </Border>

            <VerticalStackLayout
                HorizontalOptions="Center"
                Margin="0,0,0,10"
                Spacing="10">

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    HorizontalOptions="Center"
                    Text="{Binding Trainer.FullName}"/>

                <Border
                    HorizontalOptions="Center"
                    Style="{StaticResource Pill}">

                    <Label
                        FontSize="12"
                        Text="{Binding Trainer.AvailableText}"/>

                </Border>

            </VerticalStackLayout>

            <Label
                FontAttributes="Bold"
                FontSize="16"
                Text="About Me"/>

            <Label
                Text="{Binding Trainer.Description}"/>

            <VerticalStackLayout
                Spacing="5">

                <Label
                    Text="{Binding Trainer.CategoryTitle, StringFormat='• Specialty: {0}'}"/>

                <Label
                    Text="{Binding Trainer.GymDetailsLabel, StringFormat='• Gym: {0}'}"/>

            </VerticalStackLayout>

            <Label
                FontAttributes="Bold"
                FontSize="16"
                IsVisible="{Binding HasContactDetails}"
                Margin="0,0,0,4"
                Text="Contact Me"/>

            <VerticalStackLayout
                IsVisible="{Binding HasContactDetails}"
                Spacing="10">

                <Button
                    Command="{Binding CallTrainerCommand}"
                    IsEnabled="{Binding IsTrainerAvailable}"
                    IsVisible="{Binding HasPhone}"
                    Text="Call"/>

                <Button
                    Command="{Binding EmailTrainerCommand}"
                    IsEnabled="{Binding IsTrainerAvailable}"
                    IsVisible="{Binding HasEmail}"
                    Text="Email"/>

            </VerticalStackLayout>

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Text="{Binding ErrorMessage}"
                TextColor="Red"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>