<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Trainers"
             x:Class="CapstoneProjectPUSH.Views.Trainers.TrainerDetailsPage"
             x:DataType="vm:TrainerDetailsViewModel"
             Title="PUSH Trainer Details">

    <ContentPage.ToolbarItems>

        <ToolbarItem
            x:Name="EditToolbarItem"
            Command="{Binding EditTrainerCommand}"
            Order="Secondary"
            Text="Edit Trainer"/>

        <ToolbarItem
            x:Name="DeleteToolbarItem"
            Command="{Binding DeleteTrainerCommand}"
            Order="Secondary"
            Text="Delete Trainer"/>

    </ContentPage.ToolbarItems>

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30,20,30,20"
            Spacing="20">

            <!-- Image -->
            <Border
                AutomationProperties.IsInAccessibleTree="False"
                BackgroundColor="{StaticResource CardBackground}"
                HeightRequest="100"
                HorizontalOptions="Center"
                Stroke="{StaticResource Accent}"
                StrokeShape="Ellipse"
                StrokeThickness="2"
                WidthRequest="100">

                <Image
                    Aspect="AspectFill"
                    AutomationProperties.IsInAccessibleTree="False"
                    Source="{Binding Trainer.ProfileImage}"/>

            </Border>

            <!-- Full name, availability and info -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource DetailTitle}"
                    Text="{Binding Trainer.FullName}"/>

                <Border
                    HorizontalOptions="Center"
                    Style="{StaticResource Pill}">

                    <Label
                        Style="{StaticResource PillLabel}"
                        Text="{Binding Trainer.AvailableText}"/>

                </Border>

                <VerticalStackLayout
                    Spacing="5">

                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource CardBody}"
                        Text="{Binding Trainer.CategoryTitle, StringFormat='Specialty: {0}'}"/>

                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource CardBody}"
                        Text="{Binding Trainer.GymDetailsLabel, StringFormat='Gym: {0}'}"/>

                </VerticalStackLayout>

            </VerticalStackLayout>

            <!-- About -->
            <VerticalStackLayout
                IsVisible="{Binding Trainer.HasDescription}"
                Spacing="10">

                <Label
                    Style="{StaticResource SectionHeader}"
                    Text="About Me"/>

                <Label
                    Style="{StaticResource LongText}"
                    Text="{Binding Trainer.Description}"/>

            </VerticalStackLayout>

            <!-- Contact -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    IsVisible="{Binding HasContactDetails}"
                    Style="{StaticResource SectionHeader}"
                    Text="Contact Me"/>

                <!-- Error message -->
                <Label
                    IsVisible="{Binding HasErrorMessage}"
                    Style="{StaticResource ErrorLabel}"
                    Text="{Binding ErrorMessage}"/>

                <!-- Buttons -->
                <VerticalStackLayout
                    IsVisible="{Binding HasContactDetails}"
                    Margin="0,5,0,0"
                    Spacing="10">

                    <Label
                        IsVisible="{Binding IsTrainerUnavailable}"
                        Style="{StaticResource HintLabel}"
                        Text="This trainer isn't taking on new clients right now."/>

                    <Button
                        Command="{Binding CallTrainerCommand}"
                        IsEnabled="{Binding IsTrainerAvailable}"
                        IsVisible="{Binding HasPhone}"
                        SemanticProperties.Hint="Opens your phone app to call this trainer"
                        Style="{StaticResource SecondaryButton}"
                        Text="Call"/>

                    <Button
                        Command="{Binding EmailTrainerCommand}"
                        IsEnabled="{Binding IsTrainerAvailable}"
                        IsVisible="{Binding HasEmail}"
                        SemanticProperties.Hint="Opens your email app to email this trainer"
                        Style="{StaticResource SecondaryButton}"
                        Text="Email"/>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>