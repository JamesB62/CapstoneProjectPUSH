<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Trainers"
             x:Class="CapstoneProjectPUSH.Views.Trainers.TrainerDetailsPage"
             x:DataType="vm:TrainerDetailsViewModel"
             Title="PUSH Trainer Details">

    <ScrollView>

        <VerticalStackLayout
            Padding="30,15,30,0"
            Spacing="15">

            <Border
                Grid.Column="0"
                HeightRequest="100"
                HorizontalOptions="Center"
                StrokeShape="Ellipse"
                StrokeThickness="0"
                WidthRequest="100">

                <!-- Profile picture placeholder - sourced from Wikipedia -->
                <Image
                    Aspect="AspectFill"
                    Source="profile_picture_placeholder.png"/>

            </Border>

            <VerticalStackLayout
                HorizontalOptions="Center"
                Margin="0,0,0,10"
                Spacing="10">

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    HorizontalOptions="Center"
                    Text="{Binding Trainer.FullName}"/>

                <Border
                    HorizontalOptions="Center"
                    Padding="10,5"
                    Stroke="#E5E7EB"
                    StrokeShape="RoundRectangle 50">

                    <Label
                        FontSize="12"
                        Text="{Binding Trainer.AvailableText}"/>

                </Border>

            </VerticalStackLayout>

            <Label
                FontAttributes="Bold"
                FontSize="16"
                Text="About Me"/>

            <Label
                Text="{Binding Trainer.Description}"/>

            <!-- Keep formatting? -->
            <VerticalStackLayout
                Spacing="5">

                <Label
                    Text="{Binding Trainer.CategoryName, StringFormat='•  Specialty: {0}'}"/>

                <Label>

                    <Label.Text>

                        <MultiBinding
                            StringFormat="•  Gym: {0} – {1}">

                            <Binding
                                Path="Trainer.GymName"/>

                            <Binding
                                Path="Trainer.GymFullAddress"/>

                        </MultiBinding>

                    </Label.Text>

                </Label>

            </VerticalStackLayout>

            <Label
                FontAttributes="Bold"
                FontSize="16"
                IsVisible="{Binding HasContactDetails}"
                Margin="0,0,0,7"
                Text="Contact Me"/>

            <VerticalStackLayout
                IsVisible="{Binding HasContactDetails}"
                Spacing="10">

                <Button
                    Command="{Binding CallTrainerCommand}"
                    IsEnabled="{Binding IsTrainerAvailable}"
                    IsVisible="{Binding HasPhone}"
                    Text="Call"/>

                <Button
                    Command="{Binding EmailTrainerCommand}"
                    IsEnabled="{Binding IsTrainerAvailable}"
                    IsVisible="{Binding HasEmail}"
                    Text="Email"/>

            </VerticalStackLayout>
            
        </VerticalStackLayout>
        
    </ScrollView>

</ContentPage>