<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Trainers"
             x:Class="CapstoneProjectPUSH.Views.Trainers.TrainersPage"
             x:DataType="vm:TrainersViewModel"
             Title="PUSH Trainers">

    <ContentPage.ToolbarItems>

        <ToolbarItem
            x:Name="AddTrainerToolbarItem"
            Command="{Binding AddTrainerCommand}"
            Order="Secondary"
            Text="Add Trainer"/>

    </ContentPage.ToolbarItems>

    <Grid
        MaximumWidthRequest="500"
        Padding="30,20,30,0"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="20">

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="20">

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"/>

            <!-- Search bar -->
            <Border
                Style="{StaticResource InputFrame}">

                <SearchBar
                    Placeholder="Search by name, specialty or gym..."
                    SemanticProperties.Hint="Search trainers"
                    Text="{Binding SearchText}"/>

            </Border>

        </VerticalStackLayout>

        <!-- Count, available filter and swipe hint -->
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="5">

            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="10">

                <!-- Trainer count -->
                <Label
                    Grid.Column="0"
                    Style="{StaticResource StatusLabel}"
                    Text="{Binding StatusMessage}"
                    VerticalOptions="Center"/>

                <HorizontalStackLayout
                    Grid.Column="1"
                    Margin="0,-15,0,-15"
                    Spacing="5">

                    <Label
                        AutomationProperties.IsInAccessibleTree="False"
                        Style="{StaticResource StatusLabel}"
                        Text="Available Only"
                        VerticalOptions="Center"/>

                    <Switch
                        IsToggled="{Binding ShowAvailableOnly}"
                        SemanticProperties.Description="Show available trainers only"
                        VerticalOptions="Center"/>

                </HorizontalStackLayout>

            </Grid>

            <Label
                IsVisible="{Binding IsCurrentUserAdmin}"
                Style="{StaticResource HintLabel}"
                Text="Swipe right to edit or left to delete."/>

        </VerticalStackLayout>

        <RefreshView
            Command="{Binding LoadTrainersCommand}"
            Grid.Row="2"
            IsRefreshing="{Binding IsBusy}">
            
            <CollectionView
                ItemsSource="{Binding Trainers}"
                SelectedItem="{Binding SelectedTrainer, Mode=TwoWay}"
                SelectionMode="Single">

                <!-- Empty view -->
                <CollectionView.EmptyView>

                    <Grid>

                        <VerticalStackLayout
                            HorizontalOptions="Center"
                            Spacing="5"
                            VerticalOptions="Center">

                            <Label
                                Style="{StaticResource EmptyLabel}"
                                Text="No trainers found."/>

                            <Label
                                Style="{StaticResource EmptyLabel}"
                                Text="Pull down to try again."/>

                        </VerticalStackLayout>

                    </Grid>

                </CollectionView.EmptyView>

                <!-- Items layout -->
                <CollectionView.ItemsLayout>

                    <LinearItemsLayout
                        ItemSpacing="15"
                        Orientation="Vertical"/>

                </CollectionView.ItemsLayout>

                <!-- Item template -->
                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:Trainer">

                        <Border
                            Style="{StaticResource SwipeClip}">

                            <SwipeView>

                                <!-- Swipe actions (admins only) -->
                                <SwipeView.LeftItems>

                                    <SwipeItems>

                                        <SwipeItem
                                            BackgroundColor="{StaticResource SwipeEdit}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TrainersViewModel}}, Path=EditTrainerCommand}"
                                            CommandParameter="{Binding .}"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:TrainersViewModel}}, Path=IsCurrentUserAdmin}"
                                            Text="Edit"/>

                                    </SwipeItems>

                                </SwipeView.LeftItems>

                                <SwipeView.RightItems>

                                    <SwipeItems>

                                        <SwipeItem
                                            BackgroundColor="{StaticResource SwipeDelete}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TrainersViewModel}}, Path=DeleteTrainerCommand}"
                                            CommandParameter="{Binding .}"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:TrainersViewModel}}, Path=IsCurrentUserAdmin}"
                                            Text="Delete"/>

                                    </SwipeItems>

                                </SwipeView.RightItems>

                                <!-- Card -->
                                <Border
                                    Style="{StaticResource SwipeCard}">

                                    <Grid
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="15">

                                        <!-- Photo -->
                                        <Border
                                            AutomationProperties.IsInAccessibleTree="False"
                                            BackgroundColor="{StaticResource CardBackground}"
                                            Grid.Column="0"
                                            HeightRequest="50"
                                            HorizontalOptions="Center"
                                            Stroke="{StaticResource Accent}"
                                            StrokeShape="Ellipse"
                                            StrokeThickness="2"
                                            VerticalOptions="Center"
                                            WidthRequest="50">

                                            <Image
                                                Aspect="AspectFill"
                                                AutomationProperties.IsInAccessibleTree="False"
                                                Source="{Binding ProfileImage}"/>

                                        </Border>

                                        <!-- Trainer details -->
                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="10">

                                            <Grid
                                                ColumnDefinitions="*,Auto"
                                                ColumnSpacing="10">

                                                <Label
                                                    Grid.Column="0"
                                                    LineBreakMode="TailTruncation"
                                                    MaxLines="2"
                                                    Style="{StaticResource CardTitle}"
                                                    Text="{Binding FullName}"
                                                    VerticalOptions="Center"/>

                                                <Border
                                                    Grid.Column="1"
                                                    Style="{StaticResource Pill}"
                                                    VerticalOptions="Start">

                                                    <Label
                                                        Style="{StaticResource PillLabel}"
                                                        Text="{Binding AvailableText}"/>

                                                </Border>

                                            </Grid>

                                            <!-- About preview -->
                                            <Label
                                                AutomationProperties.IsInAccessibleTree="False"
                                                IsVisible="{Binding HasDescription}"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="2"
                                                Style="{StaticResource CardBody}"
                                                Text="{Binding Description}"/>

                                            <VerticalStackLayout
                                                Spacing="5">

                                                <Label
                                                    Style="{StaticResource CardCredit}"
                                                    Text="{Binding CategoryTitle, StringFormat='Specialty: {0}'}"/>

                                                <Label
                                                    Style="{StaticResource CardCredit}"
                                                    Text="{Binding GymLabel, StringFormat='Gym: {0}'}"/>

                                            </VerticalStackLayout>

                                            <!-- Favourite gym -->
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                IsVisible="{Binding IsAtFavouriteGym}"
                                                Text="At your favourite gym"
                                                TextColor="{StaticResource Accent}"/>

                                        </VerticalStackLayout>

                                    </Grid>

                                </Border>
                            
                            </SwipeView>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>