<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Trainers"
             x:Class="CapstoneProjectPUSH.Views.Trainers.TrainersPage"
             x:DataType="vm:TrainersViewModel"
             Title="PUSH Trainers">

    <ContentPage.ToolbarItems>

        <ToolbarItem
            x:Name="AddTrainerToolbarItem"
            Command="{Binding AddTrainerCommand}"
            Text="+ Add"/>

    </ContentPage.ToolbarItems>

    <Grid
        MaximumWidthRequest="500"
        Padding="30,15,30,0"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="20">

        <!-- Search bar -->
        <SearchBar
            Grid.Row="0"
            Placeholder="Search by name, specialty or gym..."
            Text="{Binding SearchText}"/>

        <VerticalStackLayout
            Grid.Row="1"
            Spacing="15">

            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="10">

                <!-- Status message -->
                <Label
                    Grid.Column="0"
                    Text="{Binding StatusMessage}"
                    VerticalOptions="Center"/>

                <!-- Availability toggle -->
                <HorizontalStackLayout
                    Grid.Column="1"
                    Margin="0,-15,0,-15"
                    Spacing="5">

                    <Label
                        Text="Available Only"
                        VerticalOptions="Center"/>

                    <Switch
                        IsToggled="{Binding ShowAvailableOnly}"
                        VerticalOptions="Center"/>


                </HorizontalStackLayout>

            </Grid>

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Text="{Binding ErrorMessage}"
                TextColor="Red"/>

        </VerticalStackLayout>

        <RefreshView
            Command="{Binding LoadTrainersCommand}"
            Grid.Row="2"
            IsRefreshing="{Binding IsBusy}">
            
            <CollectionView
                ItemsSource="{Binding Trainers}"
                SelectedItem="{Binding SelectedTrainer, Mode=TwoWay}"
                SelectionMode="Single">

                <!-- Empty view -->
                <CollectionView.EmptyView>

                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Label
                            FontAttributes="Italic"
                            HorizontalTextAlignment="Center"
                            Text="No trainers found."/>

                        <Label
                            FontAttributes="Italic"
                            HorizontalTextAlignment="Center"
                            Text="Pull down to try again."/>

                    </VerticalStackLayout>

                </CollectionView.EmptyView>

                <!-- Item layout -->
                <CollectionView.ItemsLayout>

                    <LinearItemsLayout
                        ItemSpacing="10"
                        Orientation="Vertical"/>

                </CollectionView.ItemsLayout>

                <!-- Item template -->
                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:Trainer">

                        <SwipeView>

                            <!-- Swipe actions (admins only) -->
                            <SwipeView.LeftItems>

                                <SwipeItems>

                                    <SwipeItem
                                        BackgroundColor="#6B7280"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TrainersViewModel}}, Path=EditTrainerCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:TrainersViewModel}}, Path=IsCurrentUserAdmin}"
                                        Text="Edit"/>

                                </SwipeItems>

                            </SwipeView.LeftItems>

                            <SwipeView.RightItems>

                                <SwipeItems>

                                    <SwipeItem
                                        BackgroundColor="Red"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TrainersViewModel}}, Path=DeleteTrainerCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:TrainersViewModel}}, Path=IsCurrentUserAdmin}"
                                        Text="Delete"/>

                                </SwipeItems>

                            </SwipeView.RightItems>

                            <Border
                                Style="{StaticResource Card}">

                                <Grid
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="15">

                                    <Border
                                        Grid.Column="0"
                                        HeightRequest="50"
                                        HorizontalOptions="Center"
                                        StrokeShape="Ellipse"
                                        StrokeThickness="0"
                                        WidthRequest="50">

                                        <Image
                                            Aspect="AspectFill"
                                            Source="{Binding ProfileImage}"/>

                                    </Border>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="10">

                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="10">

                                            <Label
                                                Grid.Column="0"
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding FullName}"
                                                VerticalOptions="Center"/>

                                            <Border
                                                Grid.Column="1"
                                                Style="{StaticResource Pill}">

                                                <Label
                                                    FontSize="12"
                                                    LineBreakMode="TailTruncation"
                                                    Text="{Binding AvailableText}"/>

                                            </Border>

                                        </Grid>

                                        <Label
                                            MaxLines="2"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Description}"/>

                                        <VerticalStackLayout
                                            Spacing="3">

                                            <Label
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding CategoryTitle, StringFormat='• Specialty: {0}'}"/>

                                            <Label
                                                LineBreakMode="TailTruncation">

                                                <Label.Text>

                                                    <MultiBinding
                                                        StringFormat="• Gym: {0}, {1}">

                                                        <Binding
                                                            Path="GymName"/>

                                                        <Binding
                                                            Path="GymCity"/>

                                                    </MultiBinding>

                                                </Label.Text>

                                            </Label>

                                        </VerticalStackLayout>

                                        <!-- Favourite gym -->
                                        <Label
                                            FontAttributes="Italic"
                                            FontSize="12"
                                            IsVisible="{Binding IsAtFavouriteGym}"
                                            Text="At your favourite gym"/>

                                    </VerticalStackLayout>

                                </Grid>

                            </Border>
                            
                        </SwipeView>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>