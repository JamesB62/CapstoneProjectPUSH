<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Trainers"
             x:Class="CapstoneProjectPUSH.Views.Trainers.TrainerPage"
             x:DataType="vm:TrainerViewModel"
             Title="">

    <Grid
        Padding="20,0,20,20"
        RowDefinitions="Auto,*"
        RowSpacing="15"
        VerticalOptions="Center">

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="15">

            <Label
                FontAttributes="Bold"
                FontSize="26"
                Text="PUSH Trainers"/>

            <Label
                Text="Get into contact with personal trainers that can support you along your physical wellbeing journey."/>

            <!-- SETUP SEARCH BAR -->
            
            <Picker
                Title="Filter by city..."/>

            <!-- AVAILABILITY TOGGLE? -->
            
            <Label
                FontAttributes="Italic"
                FontSize="14"
                Text="{Binding StatusMessage}"/>

        </VerticalStackLayout>

        <RefreshView
            Command="{Binding LoadTrainersCommand}"
            Grid.Row="1"
            IsRefreshing="{Binding IsBusy, Mode=OneWay}">
            
            <CollectionView
                ItemsSource="{Binding Trainers}">

                <CollectionView.EmptyView>

                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Label
                            FontAttributes="Italic"
                            HorizontalTextAlignment="Center"
                            Text="No trainers found."/>

                        <Label
                            FontAttributes="Italic"
                            HorizontalTextAlignment="Center"
                            Text="Pull down to try again."/>

                    </VerticalStackLayout>

                </CollectionView.EmptyView>

                <CollectionView.ItemsLayout>

                    <LinearItemsLayout
                        ItemSpacing="15"
                        Orientation="Vertical"/>

                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:Trainer">

                        <Border
                            Padding="15"
                            StrokeShape="RoundRectangle 10">

                            <VerticalStackLayout
                                Spacing="5">

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding FullName}"/>

                                <Label
                                    Text="{Binding GymName}"/>

                                <Label
                                    Text="{Binding Specialty}"/>

                                <Label
                                    Text="{Binding AvailableText}"/>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>