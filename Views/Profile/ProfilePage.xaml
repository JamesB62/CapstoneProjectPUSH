<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Profile"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             x:Class="CapstoneProjectPUSH.Views.Profile.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="My PUSH Profile">

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30,15"
            Spacing="15">

            <Border
                HeightRequest="100"
                HorizontalOptions="Center"
                StrokeShape="Ellipse"
                StrokeThickness="0"
                WidthRequest="100">

                <Image
                    Aspect="AspectFill"
                    Source="{Binding ProfileImage}"/>

            </Border>

            <VerticalStackLayout
                HorizontalOptions="Center"
                Margin="0,0,0,10"
                Spacing="5">

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    HorizontalOptions="Center"
                    Text="{Binding DisplayName}"/>

                <Label
                    HorizontalOptions="Center"
                    Text="{Binding Email}"/>

            </VerticalStackLayout>

            <!-- My gyms -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="My Gyms"/>

                <!-- Gyms not linked yet -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="10"
                    IsVisible="{Binding HasGymChoices}">

                    <Picker
                        Grid.Column="0"
                        ItemsSource="{Binding GymChoices}"
                        SelectedIndex="{Binding SelectedGymIndex}"
                        Title="Choose a gym"/>

                    <Button
                        Grid.Column="1"
                        Command="{Binding AddGymCommand}"
                        Text="Add"/>

                </Grid>

                <Label
                    IsVisible="{Binding HasStatusMessage}"
                    Text="{Binding StatusMessage}"/>

                <Label
                    IsVisible="{Binding HasNoGyms}"
                    Text="You haven't added any gyms yet."/>

                <!-- Linked gyms -->
                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding MyGyms}"
                    Spacing="10">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Gym">

                            <Border Style="{StaticResource Card}">

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="10">

                                    <VerticalStackLayout
                                        Grid.Column="0"
                                        Spacing="2"
                                        VerticalOptions="Center">

                                        <Label
                                            FontAttributes="Bold"
                                            Text="{Binding Name}"/>

                                        <Label
                                            FontSize="12"
                                            Text="{Binding FullAddress}"/>

                                    </VerticalStackLayout>

                                    <Button
                                        Grid.Column="1"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=RemoveGymCommand}"
                                        CommandParameter="{Binding .}"
                                        Text="Remove"/>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </BindableLayout.ItemTemplate>

                </VerticalStackLayout>

            </VerticalStackLayout>

            <!-- Buttons -->
            <VerticalStackLayout
                Spacing="10">

                <Button
                    Command="{Binding GoToUpdateDetailsCommand}"
                    Text="Update Details"/>

                <Button
                    Command="{Binding GoToMyWorkoutsCommand}"
                    Text="My Workouts"/>

                <Button
                    Command="{Binding GoToMyNotesCommand}"
                    Text="My Notes"/>

                <Button
                    Command="{Binding GoToAdminDashboardCommand}"
                    IsVisible="{Binding IsAdmin}"
                    Text="Admin Dashboard"/>

                <Button
                    Command="{Binding LogoutCommand}"
                    Text="Logout"/>

            </VerticalStackLayout>

            <!-- Privacy statement link -->
            <Label
                Text="Privacy Statement"
                TextDecorations="Underline">

                <Label.GestureRecognizers>

                    <TapGestureRecognizer
                       Command="{Binding GoToPrivacyCommand}"/>

                </Label.GestureRecognizers>

            </Label>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>