<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Profile"
             x:Class="CapstoneProjectPUSH.Views.Profile.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="My PUSH Profile">

    <ScrollView>

        <VerticalStackLayout
            Padding="30,15,30,0"
            Spacing="15">

            <Border
                HeightRequest="100"
                HorizontalOptions="Center"
                StrokeShape="Ellipse"
                StrokeThickness="0"
                WidthRequest="100">

                <!-- Profile picture placeholder - sourced from Wikipedia -->
                <Image
                    Aspect="AspectFill"
                    Source="profile_picture_placeholder.png"/>

            </Border>

            <VerticalStackLayout
                HorizontalOptions="Center"
                Margin="0,0,0,10"
                Spacing="5">

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    HorizontalOptions="Center"
                    Text="{Binding DisplayName}"/>

                <Label
                    HorizontalOptions="Center"
                    Text="{Binding Email}"/>

            </VerticalStackLayout>

            <!-- Buttons -->

            <VerticalStackLayout
                Spacing="10">

                <Button
                    Command="{Binding GoToUpdateDetailsCommand}"
                    Text="Update Details"/>

                <Button
                    Command="{Binding GoToMyWorkoutsCommand}"
                    Text="My Workouts"/>

                <Button
                    Command="{Binding GoToMyNotesCommand}"
                    Text="My Notes"/>

                <Button
                    Command="{Binding GoToAdminDashboardCommand}"
                    IsVisible="{Binding IsAdmin}"
                    Text="Admin Dashboard"/>

                <Button
                    Command="{Binding LogoutCommand}"
                    Text="Logout"/>

            </VerticalStackLayout>

            <!-- Privacy statement link -->
            <Label
                Text="Privacy Statement"
                TextDecorations="Underline">

                <Label.GestureRecognizers>

                    <TapGestureRecognizer
                       Command="{Binding GoToPrivacyCommand}"/>

                </Label.GestureRecognizers>

            </Label>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>