<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Profile"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             x:Class="CapstoneProjectPUSH.Views.Profile.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="My PUSH Profile">

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30,20,30,20"
            Spacing="20">

            <!-- Profile image -->
            <Border
                AutomationProperties.IsInAccessibleTree="False"
                BackgroundColor="{StaticResource CardBackground}"
                HeightRequest="100"
                HorizontalOptions="Center"
                Stroke="{StaticResource Accent}"
                StrokeShape="Ellipse"
                StrokeThickness="2"
                WidthRequest="100">

                <Image
                    Aspect="AspectFill"
                    AutomationProperties.IsInAccessibleTree="False"
                    Source="{Binding ProfileImage}"/>

            </Border>

            <!-- Profile details -->
            <VerticalStackLayout
                Spacing="5">

                <Label
                    HorizontalOptions="Center"
                    Style="{StaticResource DetailTitle}"
                    Text="{Binding DisplayName}"/>

                <Label
                    HorizontalOptions="Center"
                    Style="{StaticResource CardBody}"
                    Text="{Binding Email}"/>

                <Label
                    HorizontalOptions="Center"
                    IsVisible="{Binding HasFavouriteGym}"
                    Style="{StaticResource CardBody}"
                    Text="{Binding FavouriteGymText, StringFormat='Favourite gym: {0}'}"/>
                
            </VerticalStackLayout>

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"/>

            <!-- Buttons -->
            <VerticalStackLayout
                Spacing="10">

                <Button
                    Command="{Binding GoToUpdateDetailsCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Text="Update Details"/>

                <Button
                    Command="{Binding GoToMyWorkoutsCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Text="My Workouts"/>

                <Button
                    Command="{Binding GoToMyNotesCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Text="My Notes"/>

                <Button
                    Command="{Binding GoToAdminDashboardCommand}"
                    IsVisible="{Binding IsAdmin}"
                    Style="{StaticResource SecondaryButton}"
                    Text="Admin Dashboard"/>

                <Button
                    Command="{Binding LogoutCommand}"
                    Style="{StaticResource TertiaryButton}"
                    Text="Logout"/>

                <Button
                    Command="{Binding DeleteAccountCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    IsVisible="{Binding CanDeleteAccount}"
                    SemanticProperties.Hint="Permanently deletes your account and everything you've created"
                    Style="{StaticResource DangerButton}"
                    Text="Delete Account"/>

            </VerticalStackLayout>

            <!-- Privacy statement link -->
            <Label
                HorizontalTextAlignment="Center"
                SemanticProperties.Hint="Opens the privacy statement"
                Style="{StaticResource LinkLabel}"
                Text="Privacy Statement">

                <Label.GestureRecognizers>

                    <TapGestureRecognizer
                        Command="{Binding GoToPrivacyCommand}"/>

                </Label.GestureRecognizers>

            </Label>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>