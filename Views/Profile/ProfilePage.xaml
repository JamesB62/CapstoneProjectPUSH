<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CapstoneProjectPUSH.Views.Profile.ProfilePage"
             Title="">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="15">

            <Label
                FontAttributes="Bold"
                FontSize="18"
                Text="My PUSH Profile"/>

            <!-- Profile picture placeholder -->
            <Border
                HeightRequest="100"
                HorizontalOptions="Center"
                StrokeShape="RoundRectangle 50"
                WidthRequest="100">

                <Label
                    FontAttributes="Bold"
                    FontSize="10"
                    HorizontalOptions="Center"
                    Text="PFP"
                    VerticalOptions="Center"/>

            </Border>

            <Label
                FontAttributes="Bold"
                FontSize="18"
                Margin="0,0,0,-5"
                HorizontalOptions="Center"
                Text="{Binding DisplayName}"/>
            
            <Label
                Margin="0,0,0,10"
                HorizontalOptions="Center"
                Text="{Binding Email}"/>

            <!-- Buttons -->

            <VerticalStackLayout
                Spacing="10">

                <Button
                    Command="{Binding GoToUpdateDetailsCommand}"
                    FontAttributes="Bold"
                    Text="Update Details"/>

                <Button
                    Command="{Binding MyWorkoutsCommand}"
                    FontAttributes="Bold"
                    Text="My Workouts"/>

                <Button
                    Command="{Binding MyNotesCommand}"
                    FontAttributes="Bold"
                    Text="My Notes"/>

                <Button
                    Command="{Binding AdminCommand}"
                    FontAttributes="Bold"
                    Text="Admin Dashboard"/>

                <Button
                    Command="{Binding LogoutCommand}"
                    FontAttributes="Bold"
                    Text="Logout"/>

            </VerticalStackLayout>

            <!-- Privacy statement link -->
            <Label
                Text="View Privacy Statement">

                <Label.GestureRecognizers>

                    <TapGestureRecognizer
                       Command="{Binding GoToPrivacyCommand}"/>

                </Label.GestureRecognizers>

            </Label>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
