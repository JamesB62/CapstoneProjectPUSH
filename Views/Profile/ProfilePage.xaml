<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Profile"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             x:Class="CapstoneProjectPUSH.Views.Profile.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="My PUSH Profile">

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30"
            Spacing="15">

            <!-- Profile image -->
            <Border
                HeightRequest="100"
                HorizontalOptions="Center"
                StrokeShape="Ellipse"
                StrokeThickness="0"
                WidthRequest="100">

                <Image
                    Aspect="AspectFill"
                    Source="{Binding ProfileImage}"/>

            </Border>

            <!-- Profile details -->
            <VerticalStackLayout
                HorizontalOptions="Center"
                Spacing="5">

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    HorizontalOptions="Center"
                    Text="{Binding DisplayName}"/>

                <Label
                    HorizontalOptions="Center"
                    Text="{Binding Email}"/>

                <Label
                    HorizontalOptions="Center"
                    IsVisible="{Binding HasFavouriteGym}"
                    Text="{Binding FavouriteGymText, StringFormat='Favourite gym: {0}'}"/>
                
            </VerticalStackLayout>

            <!-- Buttons -->
            <VerticalStackLayout
                Spacing="10">

                <Button
                    Command="{Binding GoToLoginOrRegisterCommand}"
                    IsVisible="{Binding IsGuest}"
                    Text="Log In or Register"/>
                
                <Button
                    Command="{Binding GoToUpdateDetailsCommand}"
                    Text="Update Details"/>

                <Button
                    Command="{Binding GoToMyWorkoutsCommand}"
                    Text="My Workouts"/>

                <Button
                    Command="{Binding GoToMyNotesCommand}"
                    Text="My Notes"/>

                <Button
                    Command="{Binding GoToAdminDashboardCommand}"
                    IsVisible="{Binding IsAdmin}"
                    Text="Admin Dashboard"/>

                <Button
                    Command="{Binding LogoutCommand}"
                    Text="Logout"/>

            </VerticalStackLayout>

            <!-- Privacy statement link -->
            <Label
                Text="Privacy Statement"
                TextDecorations="Underline">

                <Label.GestureRecognizers>
                    
                    <TapGestureRecognizer
                        Command="{Binding GoToPrivacyCommand}"/>

                </Label.GestureRecognizers>

            </Label>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>