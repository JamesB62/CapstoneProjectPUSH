<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Profile"
             x:Class="CapstoneProjectPUSH.Views.Profile.MyWorkoutsPage"
             x:DataType="vm:MyWorkoutsViewModel"
             Title="My PUSH Workouts">

    <Grid
        MaximumWidthRequest="500"
        Padding="30,15,30,0"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="20">

        <!-- Search bar -->
        <SearchBar
            Grid.Row="0"
            Placeholder="Search by title or category..."
            Text="{Binding SearchText}"/>

        <VerticalStackLayout
            Grid.Row="1"
            Spacing="15">

            <!-- Status message -->
            <Label
                Text="{Binding StatusMessage}"/>

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Text="{Binding ErrorMessage}"
                TextColor="Red"/>

        </VerticalStackLayout>

        <RefreshView
            Command="{Binding LoadMyWorkoutsCommand}"
            Grid.Row="2"
            IsRefreshing="{Binding IsBusy}">

            <CollectionView
                ItemsSource="{Binding Workouts}" 
                SelectedItem="{Binding SelectedWorkout, Mode=TwoWay}"
                SelectionMode="Single">

                <!-- Empty view -->
                <CollectionView.EmptyView>

                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Label
                            FontAttributes="Italic"
                            HorizontalTextAlignment="Center"
                            Text="No workouts found."/>

                        <Label
                            FontAttributes="Italic"
                            HorizontalTextAlignment="Center"
                            Text="Pull down to try again."/>

                    </VerticalStackLayout>

                </CollectionView.EmptyView>

                <!-- Item layout -->
                <CollectionView.ItemsLayout>

                    <LinearItemsLayout
                        ItemSpacing="10"
                        Orientation="Vertical"/>

                </CollectionView.ItemsLayout>

                <!-- Item template -->
                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:Workout">

                        <SwipeView>

                            <!-- Swipe actions -->
                            <SwipeView.LeftItems>

                                <SwipeItems>

                                    <SwipeItem
                                        BackgroundColor="#6B7280"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MyWorkoutsViewModel}}, Path=EditWorkoutCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:MyWorkoutsViewModel}}, Path=IsLoggedIn}"
                                        Text="Edit"/>

                                </SwipeItems>

                            </SwipeView.LeftItems>

                            <SwipeView.RightItems>

                                <SwipeItems>

                                    <SwipeItem
                                        BackgroundColor="Red"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MyWorkoutsViewModel}}, Path=DeleteWorkoutCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:MyWorkoutsViewModel}}, Path=IsLoggedIn}"
                                        Text="Delete"/>

                                </SwipeItems>

                            </SwipeView.RightItems>

                            <Border
                                Style="{StaticResource Card}">

                                <VerticalStackLayout
                                    Spacing="10">

                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="10">

                                        <Label
                                            Grid.Column="0"
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Title}"
                                            VerticalOptions="Center"/>

                                        <Border
                                            Grid.Column="1"
                                            Style="{StaticResource Pill}">

                                            <Label
                                                FontSize="12"
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding CategoryTitle}"/>

                                        </Border>

                                    </Grid>

                                    <!-- Info -->
                                    <VerticalStackLayout
                                        Spacing="3">

                                        <Label
                                            Text="{Binding ExerciseCount, StringFormat='• Exercises: {0}'}"/>

                                        <Label
                                            IsVisible="{Binding HasSets}"
                                            Text="{Binding SetCount, StringFormat='• Sets: {0}'}"/>

                                        <Label
                                            IsVisible="{Binding HasMinutes}"
                                            Text="{Binding TotalMinutes, StringFormat='• Time: {0} min'}"/>

                                    </VerticalStackLayout>

                                    <Label
                                        FontAttributes="Italic"
                                        FontSize="12"
                                        Text="{Binding DateTimeCreated, StringFormat='Created on {0:d MMM yyyy}'}"/>

                                </VerticalStackLayout>

                            </Border>

                        </SwipeView>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>