<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Profile"
             x:Class="CapstoneProjectPUSH.Views.Profile.MyNotesPage"
             x:DataType="vm:MyNotesViewModel"
             Title="My PUSH Notes">

    <Grid
        MaximumWidthRequest="500"
        Padding="30,20,30,0"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="20">

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="20">

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"/>

            <!-- Search bar -->
            <Border
                Style="{StaticResource InputFrame}">

                <SearchBar
                    Placeholder="Search by title, content or workout..."
                    SemanticProperties.Hint="Search notes"
                    Text="{Binding SearchText}"/>

            </Border>

        </VerticalStackLayout>

        <!-- Count and swipe hint (registered accounts only) -->
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="5">

            <Label
                Style="{StaticResource StatusLabel}"
                Text="{Binding StatusMessage}"/>

            <Label
                IsVisible="{Binding IsLoggedIn}"
                Style="{StaticResource HintLabel}"
                Text="Swipe right to edit or left to delete."/>

        </VerticalStackLayout>

        <RefreshView
            Command="{Binding LoadMyNotesCommand}"
            Grid.Row="2"
            IsRefreshing="{Binding IsBusy}">

            <CollectionView
                ItemsSource="{Binding Notes}"
                SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                SelectionMode="Single">

                <!-- Empty view -->
                <CollectionView.EmptyView>

                    <Grid>

                        <VerticalStackLayout
                            HorizontalOptions="Center"
                            Spacing="5"
                            VerticalOptions="Center">

                            <Label
                                Style="{StaticResource EmptyLabel}"
                                Text="No notes found."/>

                            <Label
                                Style="{StaticResource EmptyLabel}"
                                Text="Pull down to try again."/>

                        </VerticalStackLayout>

                    </Grid>

                </CollectionView.EmptyView>

                <!-- Items layout -->
                <CollectionView.ItemsLayout>

                    <LinearItemsLayout
                        ItemSpacing="15"
                        Orientation="Vertical"/>

                </CollectionView.ItemsLayout>

                <!-- Item template -->
                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:Note">

                        <Border
                            Style="{StaticResource SwipeClip}">
                        
                            <SwipeView>

                                <!-- Swipe actions (registered accounts only) -->
                                <SwipeView.LeftItems>

                                    <SwipeItems>

                                        <SwipeItem
                                            BackgroundColor="{StaticResource SwipeEdit}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MyNotesViewModel}}, Path=EditNoteCommand}"
                                            CommandParameter="{Binding .}"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:MyNotesViewModel}}, Path=IsLoggedIn}"
                                            Text="Edit"/>

                                    </SwipeItems>

                                </SwipeView.LeftItems>

                                <SwipeView.RightItems>

                                    <SwipeItems>

                                        <SwipeItem
                                            BackgroundColor="{StaticResource SwipeDelete}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MyNotesViewModel}}, Path=DeleteNoteCommand}"
                                            CommandParameter="{Binding .}"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:MyNotesViewModel}}, Path=IsLoggedIn}"
                                            Text="Delete"/>

                                    </SwipeItems>

                                </SwipeView.RightItems>

                                <Border
                                    Style="{StaticResource SwipeCard}">

                                    <VerticalStackLayout
                                        Spacing="10">

                                        <!-- Title and workout pill -->
                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="10">

                                            <Label
                                                Grid.Column="0"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="2"
                                                Style="{StaticResource CardTitle}"
                                                Text="{Binding Title}"/>

                                            <Border
                                                Grid.Column="1"
                                                Style="{StaticResource Pill}"
                                                VerticalOptions="Start">

                                                <Label
                                                    Style="{StaticResource PillLabel}"
                                                    Text="{Binding WorkoutTitle}"/>

                                            </Border>

                                        </Grid>

                                        <!-- Content -->
                                        <Label
                                            Style="{StaticResource CardBody}"
                                            Text="{Binding Content}"/>

                                        <!-- Credit -->
                                        <Label
                                            Style="{StaticResource CardCredit}"
                                            Text="{Binding DateTimeCreated, StringFormat='Created on {0:d MMM yyyy}'}"/>

                                    </VerticalStackLayout>

                                </Border>

                            </SwipeView>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>