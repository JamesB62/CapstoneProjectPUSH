<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Profile"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             x:Class="CapstoneProjectPUSH.Views.Profile.UpdateProfilePage"
             x:DataType="vm:UpdateProfileViewModel"
             Title="Update PUSH Account Details">

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30"
            Spacing="15">

            <!-- Update details forms -->
            <VerticalStackLayout>

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Display Name"/>

                <Entry
                    Placeholder="Enter your new display name here"
                    Text="{Binding DisplayName}"/>

            </VerticalStackLayout>

            <VerticalStackLayout>

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Email Address"/>

                <Entry
                    Keyboard="Email"
                    Placeholder="Enter your new email address here"
                    Text="{Binding Email}"/>

            </VerticalStackLayout>

            <VerticalStackLayout>

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Favourite Gym"/>

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="10">

                    <Picker
                        Grid.Column="0"
                        ItemDisplayBinding="{Binding NameAndCity, x:DataType=models:Gym}"
                        ItemsSource="{Binding Gyms}"
                        SelectedItem="{Binding SelectedGym}"
                        Title="Choose your favourite gym (optional)"/>

                    <Button
                        Grid.Column="1"
                        Command="{Binding ClearGymCommand}"
                        IsVisible="{Binding HasSelectedGym}"
                        Text="Clear"/>

                </Grid>

            </VerticalStackLayout>

            <VerticalStackLayout
                Margin="0,0,0,-5">

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Change Password"/>

                <Label
                    FontSize="14"
                    Margin="0,10,0,0"
                    Text="Optional. Leave these blank to keep your current password."/>

                <VerticalStackLayout
                    Spacing="5">

                    <Entry
                        IsPassword="True"
                        Placeholder="Enter your current password here"
                        Text="{Binding CurrentPassword}"/>

                    <Entry
                        IsPassword="True"
                        Placeholder="Enter your new password here"
                        Text="{Binding NewPassword}"/>

                    <Entry
                        IsPassword="True"
                        Placeholder="Confirm your new password here"
                        Text="{Binding ConfirmPassword}"/>

                </VerticalStackLayout>

            </VerticalStackLayout>

            <!-- Password requirements -->
            <Label
                FontAttributes="Italic"
                Text="{Binding PasswordRequirements}"/>

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Text="{Binding ErrorMessage}"
                TextColor="Red"/>

            <!-- Buttons -->
            <VerticalStackLayout
                Margin="0,5,0,0"
                Spacing="10">

                <Button
                    Command="{Binding SaveProfileCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Text="Save"/>

                <Button
                    Command="{Binding CancelProfileCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Text="Cancel"/>

            </VerticalStackLayout>

            <!-- Loading circle -->
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                Margin="0,10,0,0"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>