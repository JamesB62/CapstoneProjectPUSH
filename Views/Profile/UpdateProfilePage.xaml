<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Profile"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             x:Class="CapstoneProjectPUSH.Views.Profile.UpdateProfilePage"
             x:DataType="vm:UpdateProfileViewModel"
             Title="Update PUSH Account Details">

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30,20,30,20"
            Spacing="20">

            <!-- Profile picture -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Profile Picture"/>

                <Grid
                    ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="10">

                    <Label
                        Grid.Column="0"
                        Style="{StaticResource CardBody}"
                        Text="{Binding PhotoStatusText}"
                        VerticalOptions="Center"/>

                    <Button
                        Grid.Column="1"
                        Command="{Binding ChangePhotoCommand}"
                        SemanticProperties.Description="Change profile picture"
                        Style="{StaticResource SecondaryButton}"
                        Text="Change"/>

                    <Button
                        Grid.Column="2"
                        Command="{Binding RemovePhotoCommand}"
                        IsVisible="{Binding HasProfileImage}"
                        SemanticProperties.Description="Remove profile picture"
                        Style="{StaticResource SecondaryButton}"
                        Text="Remove"/>

                </Grid>

            </VerticalStackLayout>

            <!-- Display Name -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Display Name"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Entry
                        Placeholder="Enter your new display name here"
                        ReturnType="Next"
                        SemanticProperties.Hint="Display name"
                        Text="{Binding DisplayName}"/>

                </Border>

            </VerticalStackLayout>

            <!-- Email address -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Email Address"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Entry
                        Keyboard="Email"
                        Placeholder="Enter your new email address here"
                        ReturnType="Next"
                        SemanticProperties.Hint="Email address"
                        Text="{Binding Email}"/>

                </Border>

            </VerticalStackLayout>

            <!-- Favourite gym -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Favourite Gym"/>

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="10">

                    <Border
                        Grid.Column="0"
                        Style="{StaticResource InputFrame}">

                        <Picker
                            ItemDisplayBinding="{Binding NameAndCity, x:DataType=models:Gym}"
                            ItemsSource="{Binding Gyms}"
                            SelectedItem="{Binding SelectedGym}"
                            SemanticProperties.Hint="Favourite gym, optional"
                            Title="Choose your favourite gym (optional)"/>

                    </Border>

                    <Button
                        Grid.Column="1"
                        Command="{Binding ClearGymCommand}"
                        IsVisible="{Binding HasSelectedGym}"
                        SemanticProperties.Description="Clear favourite gym"
                        Style="{StaticResource SecondaryButton}"
                        Text="Clear"/>

                </Grid>

            </VerticalStackLayout>

            <!-- Change password -->
            <VerticalStackLayout
                Spacing="5">

                <Label
                    Style="{StaticResource SectionHeader}"
                    Text="Change Password"/>

                <Label
                    Style="{StaticResource HintLabel}"
                    Text="Optional. Leave these blank to keep your current password."/>

            </VerticalStackLayout>

            <!-- Current password -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Current Password"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Entry
                        IsPassword="True"
                        Placeholder="Enter your current password here"
                        ReturnType="Next"
                        SemanticProperties.Hint="Current password"
                        Text="{Binding CurrentPassword}"/>

                </Border>

            </VerticalStackLayout>

            <!-- New password -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="New Password"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Entry
                        IsPassword="True"
                        Placeholder="Enter your new password here"
                        ReturnType="Next"
                        SemanticProperties.Hint="New password"
                        Text="{Binding NewPassword}"/>

                </Border>

                <Label
                    Style="{StaticResource HintLabel}"
                    Text="{Binding PasswordRequirements}"/>

            </VerticalStackLayout>

            <!-- Confirm new password -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Confirm New Password"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Entry
                        IsPassword="True"
                        Placeholder="Enter your new password again"
                        ReturnType="Done"
                        SemanticProperties.Hint="Confirm new password"
                        Text="{Binding ConfirmPassword}"/>

                </Border>

            </VerticalStackLayout>

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"/>

            <!-- Buttons -->
            <VerticalStackLayout
                Spacing="10">

                <Button
                    Command="{Binding SaveProfileCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Text="Save"/>

                <Button
                    Command="{Binding CancelProfileCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource SecondaryButton}"
                    Text="Cancel"/>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>