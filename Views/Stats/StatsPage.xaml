<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:charts="clr-namespace:CapstoneProjectPUSH.Models.Charts"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Stats"
             x:Class="CapstoneProjectPUSH.Views.Stats.StatsPage"
             x:DataType="vm:StatsViewModel"
             Title="My PUSH Stats">

    <RefreshView
        Command="{Binding LoadStatsCommand}"
        IsRefreshing="{Binding IsBusy}">

        <ScrollView>

            <VerticalStackLayout
                MaximumWidthRequest="500"
                Padding="30,15"
                Spacing="15">

                <!-- Time filters -->
                <Grid
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="10">

                    <Button
                        Grid.Column="0"
                        Command="{Binding SelectFilterCommand}"
                        CommandParameter="Week"
                        Opacity="0.5"
                        Text="Week">

                        <Button.Triggers>

                            <DataTrigger
                                Binding="{Binding SelectedFilter}"
                                TargetType="Button"
                                Value="Week">
                                
                                <Setter
                                    Property="Opacity"
                                    Value="1"/>
                                
                            </DataTrigger>

                        </Button.Triggers>

                    </Button>

                    <Button
                        Grid.Column="1"
                        Command="{Binding SelectFilterCommand}"
                        CommandParameter="Month"
                        Opacity="0.5"
                        Text="Month">

                        <Button.Triggers>

                            <DataTrigger
                                Binding="{Binding SelectedFilter}"
                                TargetType="Button"
                                Value="Month">

                                <Setter
                                    Property="Opacity"
                                    Value="1"/>
                                
                            </DataTrigger>

                        </Button.Triggers>

                    </Button>

                    <Button
                        Grid.Column="2"
                        Command="{Binding SelectFilterCommand}"
                        CommandParameter="Year"
                        Opacity="0.5"
                        Text="Year">

                        <Button.Triggers>

                            <DataTrigger
                                Binding="{Binding SelectedFilter}"
                                TargetType="Button"
                                Value="Year">

                                <Setter
                                    Property="Opacity"
                                    Value="1"/>
                                
                            </DataTrigger>

                        </Button.Triggers>

                    </Button>

                </Grid>

                <!-- Top stats -->
                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="10"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="10">

                    <Border
                        Grid.Column="0"
                        Grid.Row="0"
                        Style="{StaticResource Card}">

                        <VerticalStackLayout>

                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                HorizontalOptions="Center"
                                Text="{Binding WorkoutCountText}"/>

                            <Label
                                HorizontalOptions="Center"
                                Text="Workouts"/>

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Grid.Column="1"
                        Grid.Row="0"
                        Style="{StaticResource Card}">

                        <VerticalStackLayout>

                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                HorizontalOptions="Center"
                                Text="{Binding TotalTimeText}"/>

                            <Label
                                HorizontalOptions="Center"
                                Text="Total Time"/>

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Grid.Column="0"
                        Grid.Row="1"
                        Style="{StaticResource Card}">

                        <VerticalStackLayout>

                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                HorizontalOptions="Center"
                                Text="{Binding AvgDurationText}"/>

                            <Label
                                HorizontalOptions="Center"
                                Text="Avg. Duration"/>

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Grid.Column="1"
                        Grid.Row="1"
                        Style="{StaticResource Card}">

                        <VerticalStackLayout>

                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                HorizontalOptions="Center"
                                Text="{Binding StreakText}"/>

                            <Label
                                HorizontalOptions="Center"
                                Text="Current Streak"/>

                        </VerticalStackLayout>

                    </Border>

                </Grid>

                <!-- Minutes trained chart -->
                <Label
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="Minutes Trained"/>

                <Border
                    Style="{StaticResource Card}">

                    <FlexLayout
                        BindableLayout.ItemsSource="{Binding Bars}"
                        Direction="Row"
                        JustifyContent="SpaceEvenly">

                        <BindableLayout.ItemTemplate>

                            <DataTemplate
                                x:DataType="charts:ChartBar">

                                <VerticalStackLayout
                                    Spacing="4"
                                    VerticalOptions="End">

                                    <Label
                                        FontSize="10"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding ValueText}"/>

                                    <BoxView
                                        Color="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}"
                                        CornerRadius="0"
                                        HeightRequest="{Binding BarHeight}"
                                        WidthRequest="14"/>

                                    <Label
                                        FontSize="12"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding Label}"/>

                                </VerticalStackLayout>

                            </DataTemplate>

                        </BindableLayout.ItemTemplate>

                    </FlexLayout>

                </Border>

                <!-- Weigh-in chart -->
                <Label
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="Weigh-In"/>

                <Border
                    Style="{StaticResource Card}">

                    <VerticalStackLayout
                        Spacing="10">

                        <Label
                            FontAttributes="Italic"
                            FontSize="14"
                            Text="{Binding LatestWeightText}"/>

                        <GraphicsView
                            Drawable="{Binding WeightChart}"
                            HeightRequest="160"/>

                    </VerticalStackLayout>

                </Border>

                <Button
                    Command="{Binding AddWeighInCommand}"
                    Text="Add Today's Weigh-in"/>

            </VerticalStackLayout>

        </ScrollView>

    </RefreshView>

</ContentPage>