<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:charts="clr-namespace:CapstoneProjectPUSH.Models.Charts"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Stats"
             x:Class="CapstoneProjectPUSH.Views.Stats.StatsPage"
             x:DataType="vm:StatsViewModel"
             Title="My PUSH Stats">

    <RefreshView
        Command="{Binding LoadStatsCommand}"
        IsRefreshing="{Binding IsBusy}">

        <ScrollView>

            <VerticalStackLayout
                MaximumWidthRequest="500"
                Padding="30,20,30,20"
                Spacing="20">

                <!-- Time filters -->
                <Grid
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="10">

                    <Button
                        Grid.Column="0"
                        Command="{Binding SelectFilterCommand}"
                        CommandParameter="Week"
                        Style="{StaticResource SecondaryButton}"
                        Text="Week">

                        <Button.Triggers>

                            <DataTrigger
                                Binding="{Binding SelectedFilter}"
                                TargetType="Button"
                                Value="Week">

                                <Setter
                                    Property="BackgroundColor"
                                    Value="{StaticResource Accent}"/>

                                <Setter
                                    Property="TextColor"
                                    Value="{StaticResource OnAccent}"/>

                                <Setter
                                    Property="SemanticProperties.Description"
                                    Value="Week, selected"/>

                            </DataTrigger>

                        </Button.Triggers>

                    </Button>

                    <Button
                        Grid.Column="1"
                        Command="{Binding SelectFilterCommand}"
                        CommandParameter="Month"
                        Style="{StaticResource SecondaryButton}"
                        Text="Month">

                        <Button.Triggers>

                            <DataTrigger
                                Binding="{Binding SelectedFilter}"
                                TargetType="Button"
                                Value="Month">

                                <Setter
                                    Property="BackgroundColor"
                                    Value="{StaticResource Accent}"/>

                                <Setter
                                    Property="TextColor"
                                    Value="{StaticResource OnAccent}"/>

                                <Setter
                                    Property="SemanticProperties.Description"
                                    Value="Month, selected"/>

                            </DataTrigger>

                        </Button.Triggers>

                    </Button>

                    <Button
                        Grid.Column="2"
                        Command="{Binding SelectFilterCommand}"
                        CommandParameter="Year"
                        Style="{StaticResource SecondaryButton}"
                        Text="Year">

                        <Button.Triggers>

                            <DataTrigger
                                Binding="{Binding SelectedFilter}"
                                TargetType="Button"
                                Value="Year">

                                <Setter
                                    Property="BackgroundColor"
                                    Value="{StaticResource Accent}"/>

                                <Setter
                                    Property="TextColor"
                                    Value="{StaticResource OnAccent}"/>

                                <Setter
                                    Property="SemanticProperties.Description"
                                    Value="Year, selected"/>

                            </DataTrigger>

                        </Button.Triggers>

                    </Button>

                </Grid>

                <!-- Top stats -->
                <Label
                    Style="{StaticResource SectionHeader}"
                    Text="Overview"/>
                
                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="15"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="15">

                    <Border
                        Grid.Column="0"
                        Grid.Row="0"
                        Style="{StaticResource Card}">

                        <VerticalStackLayout
                            Spacing="5">

                            <Label
                                SemanticProperties.Description="{Binding WorkoutCountText, StringFormat='Workouts: {0}'}"
                                Style="{StaticResource StatValue}"
                                Text="{Binding WorkoutCountText}"/>

                            <Label
                                AutomationProperties.IsInAccessibleTree="False"
                                Style="{StaticResource StatLabel}"
                                Text="Workouts"/>

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Grid.Column="1"
                        Grid.Row="0"
                        Style="{StaticResource Card}">

                        <VerticalStackLayout
                            Spacing="5">

                            <Label
                                SemanticProperties.Description="{Binding TotalTimeText, StringFormat='Total time: {0}'}"
                                Style="{StaticResource StatValue}"
                                Text="{Binding TotalTimeText}"/>

                            <Label
                                AutomationProperties.IsInAccessibleTree="False"
                                Style="{StaticResource StatLabel}"
                                Text="Total Time"/>

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Grid.Column="0"
                        Grid.Row="1"
                        Style="{StaticResource Card}">

                        <VerticalStackLayout
                            Spacing="5">

                            <Label
                                SemanticProperties.Description="{Binding AvgDurationText, StringFormat='Average duration: {0}'}"
                                Style="{StaticResource StatValue}"
                                Text="{Binding AvgDurationText}"/>

                            <Label
                                AutomationProperties.IsInAccessibleTree="False"
                                Style="{StaticResource StatLabel}"
                                Text="Avg. Duration"/>

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Grid.Column="1"
                        Grid.Row="1"
                        Style="{StaticResource Card}">

                        <VerticalStackLayout
                            Spacing="5">

                            <Label
                                SemanticProperties.Description="{Binding StreakText, StringFormat='Current streak: {0}'}"
                                Style="{StaticResource StatValue}"
                                Text="{Binding StreakText}"/>

                            <Label
                                AutomationProperties.IsInAccessibleTree="False"
                                Style="{StaticResource StatLabel}"
                                Text="Current Streak"/>

                        </VerticalStackLayout>

                    </Border>

                </Grid>

                <!-- Minutes trained chart -->
                <Label
                    Style="{StaticResource SectionHeader}"
                    Text="Minutes Trained"/>

                <Border
                    Style="{StaticResource Card}">

                    <FlexLayout
                        BindableLayout.ItemsSource="{Binding Bars}"
                        Direction="Row"
                        JustifyContent="SpaceEvenly">

                        <BindableLayout.ItemTemplate>

                            <DataTemplate
                                x:DataType="charts:ChartBar">

                                <VerticalStackLayout
                                    Spacing="5"
                                    VerticalOptions="End">

                                    <!-- Value -->
                                    <Label
                                        AutomationProperties.IsInAccessibleTree="False"
                                        HorizontalTextAlignment="Center"
                                        Style="{StaticResource HintLabel}"
                                        Text="{Binding ValueText}"/>

                                    <!-- Bar -->
                                    <BoxView
                                        AutomationProperties.IsInAccessibleTree="False"
                                        BackgroundColor="Transparent"
                                        Color="{StaticResource Accent}"
                                        CornerRadius="4,4,0,0"
                                        HeightRequest="{Binding BarHeight}"
                                        WidthRequest="14"/>

                                    <!-- Period label -->
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        Style="{StaticResource HintLabel}"
                                        Text="{Binding Label}">

                                        <SemanticProperties.Description>

                                            <MultiBinding
                                                StringFormat="{}{0}, {1}">

                                                <Binding
                                                    Path="Label"/>

                                                <Binding
                                                    Path="ValueText"/>

                                            </MultiBinding>

                                        </SemanticProperties.Description>

                                    </Label>

                                </VerticalStackLayout>

                            </DataTemplate>

                        </BindableLayout.ItemTemplate>

                    </FlexLayout>

                </Border>

                <!-- Weigh-in chart -->
                <Label
                    Style="{StaticResource SectionHeader}"
                    Text="Weigh-In"/>

                <Border
                    Style="{StaticResource Card}">

                    <VerticalStackLayout
                        Spacing="10">

                        <Label
                            Style="{StaticResource CardBody}"
                            Text="{Binding LatestWeightText}"/>

                        <GraphicsView
                            AutomationProperties.IsInAccessibleTree="False"
                            Drawable="{Binding WeightChart}"
                            HeightRequest="160"/>

                    </VerticalStackLayout>

                </Border>

                <!-- Error message -->
                <Label
                    IsVisible="{Binding HasErrorMessage}"
                    Style="{StaticResource ErrorLabel}"
                    Text="{Binding ErrorMessage}"/>

                <Button
                    Command="{Binding AddWeighInCommand}"
                    Text="Add Today's Weigh-in"/>

            </VerticalStackLayout>

        </ScrollView>

    </RefreshView>

</ContentPage>