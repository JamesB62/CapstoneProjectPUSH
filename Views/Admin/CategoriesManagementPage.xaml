<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Admin"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             x:Class="CapstoneProjectPUSH.Views.Admin.CategoriesManagementPage"
             x:DataType="vm:CategoriesManagementViewModel"
             Title="Manage Categories">

    <Grid
        MaximumWidthRequest="500"
        Padding="30,15"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="10">

        <!-- Add / rename form -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">

            <Entry
                MaxLength="50"
                Placeholder="Category title"
                ReturnCommand="{Binding SaveCommand}"
                ReturnType="Done"
                Text="{Binding TitleInput}"/>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                <Button
                    Grid.Column="0"
                    Command="{Binding SaveCommand}"
                    Text="{Binding SaveButtonText}"/>

                <Button
                    Grid.Column="1"
                    Command="{Binding CancelEditCommand}"
                    IsVisible="{Binding IsEditing}"
                    Text="Cancel"/>

            </Grid>

        </VerticalStackLayout>

        <Label
            Grid.Row="1"
            HorizontalOptions="Center"
            IsVisible="{Binding HasStatusMessage}"
            Text="{Binding StatusMessage}"/>

        <RefreshView
            Grid.Row="2"
            Command="{Binding LoadCommand}"
            IsRefreshing="{Binding IsBusy}">

            <CollectionView ItemsSource="{Binding Categories}">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <Label HorizontalOptions="Center" Text="No categories yet."/>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Category">

                        <Border Style="{StaticResource Card}">

                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">

                                <Label
                                    Grid.Column="0"
                                    FontSize="16"
                                    Text="{Binding Title}"
                                    VerticalOptions="Center"/>

                                <Button
                                    Grid.Column="1"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoriesManagementViewModel}}, Path=EditCommand}"
                                    CommandParameter="{Binding .}"
                                    Text="Edit"/>

                                <Button
                                    Grid.Column="2"
                                    BackgroundColor="Firebrick"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoriesManagementViewModel}}, Path=DeleteCommand}"
                                    CommandParameter="{Binding .}"
                                    Text="Delete"
                                    TextColor="White"/>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>
