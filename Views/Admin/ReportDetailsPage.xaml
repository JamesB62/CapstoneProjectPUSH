<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Admin"
             x:Class="CapstoneProjectPUSH.Views.Admin.ReportDetailsPage"
             x:DataType="vm:ReportDetailsViewModel"
             Title="PUSH Report Details">

    <ScrollView>
        
        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30,20,30,20"
            Spacing="20">

            <!-- Report -->
            <Label
                Style="{StaticResource SectionHeader}"
                Text="Report"/>

            <Border
                Style="{StaticResource Card}">

                <VerticalStackLayout
                    Spacing="10">

                    <!-- Title and status pill -->
                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="10">

                        <Label
                            Grid.Column="0"
                            LineBreakMode="TailTruncation"
                            Style="{StaticResource CardTitle}"
                            Text="{Binding Report.Id, StringFormat='Report ID: {0}'}"/>

                        <Border
                            Grid.Column="1"
                            Style="{StaticResource Pill}"
                            VerticalOptions="Start">

                            <Label
                                Style="{StaticResource PillLabel}"
                                Text="{Binding Report.StatusLabel}"/>

                        </Border>

                    </Grid>

                    <!-- Reason -->
                    <Label
                        Style="{StaticResource CardBody}"
                        Text="{Binding Report.Reason}"/>

                    <!-- Credit -->
                    <VerticalStackLayout
                        Spacing="5">

                        <Label
                            Style="{StaticResource CardCredit}">

                            <Label.Text>

                                <MultiBinding
                                    StringFormat="Reported by {0} on {1:d MMM yyyy}">

                                    <Binding
                                        Path="Report.UserDisplayName"/>

                                    <Binding
                                        Path="Report.DateTimeCreated"/>

                                </MultiBinding>

                            </Label.Text>

                        </Label>

                        <!-- Resolved label -->
                        <Label
                            IsVisible="{Binding Report.IsResolved}"
                            Style="{StaticResource CardCredit}"
                            Text="{Binding ResolvedText}"/>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>

            <!-- Reported workout -->
            <Label
                Style="{StaticResource SectionHeader}"
                Text="Reported Workout"/>

            <!-- Card -->
            <Border
                IsVisible="{Binding HasWorkout}"
                Style="{StaticResource Card}">

                <VerticalStackLayout
                    Spacing="10">

                    <!-- Title and pills -->
                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="10">

                        <Label
                            Grid.Column="0"
                            LineBreakMode="TailTruncation"
                            MaxLines="2"
                            Style="{StaticResource CardTitle}"
                            Text="{Binding Workout.Title}"/>

                        <Border
                            Grid.Column="1"
                            Style="{StaticResource Pill}"
                            VerticalOptions="Start">

                            <Label
                                Style="{StaticResource PillLabel}"
                                Text="{Binding Workout.CategoryTitle}"/>

                        </Border>
                        
                    </Grid>

                    <!-- Info -->
                    <VerticalStackLayout
                        Spacing="5">

                        <Label
                            Style="{StaticResource CardBody}"
                            Text="{Binding Workout.ExerciseCount, StringFormat='Exercises: {0}'}"/>

                        <Label
                            IsVisible="{Binding Workout.HasSets}"
                            Style="{StaticResource CardBody}"
                            Text="{Binding Workout.SetCount, StringFormat='Sets: {0}'}"/>

                        <Label
                            IsVisible="{Binding Workout.HasMinutes}"
                            Style="{StaticResource CardBody}"
                            Text="{Binding Workout.TotalMinutes, StringFormat='Time: {0} min'}"/>

                    </VerticalStackLayout>

                    <!-- Credit -->                    
                    <Label
                        Style="{StaticResource CardCredit}">

                        <Label.Text>

                            <MultiBinding
                                    StringFormat="Created by {0} on {1:d MMM yyyy}">

                                <Binding
                                        Path="Workout.UserDisplayName"/>

                                <Binding
                                        Path="Workout.DateTimeCreated"/>

                            </MultiBinding>

                        </Label.Text>

                    </Label>

                </VerticalStackLayout>

            </Border>

            <!-- Removed workout card -->
            <Border
                IsVisible="{Binding HasNoWorkout}"
                Style="{StaticResource Card}">

                <VerticalStackLayout
                    Spacing="10">

                    <Label
                        Style="{StaticResource CardTitle}"
                        Text="Removed workout"/>

                    <Label
                        Style="{StaticResource CardBody}"
                        Text="This workout has been deleted."/>

                </VerticalStackLayout>

            </Border>

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"/>

            <!-- Buttons -->
            <VerticalStackLayout
                Spacing="10">

                <Button
                    Command="{Binding ViewWorkoutCommand}"
                    IsVisible="{Binding CanViewWorkout}"
                    Style="{StaticResource SecondaryButton}"
                    Text="View Workout"/>

                <Button
                    Command="{Binding DismissCommand}"
                    IsVisible="{Binding CanResolve}"
                    SemanticProperties.Hint="Resolves the report and keeps the workout"
                    Text="Dismiss"/>

                <Button
                    Command="{Binding RemoveContentCommand}"
                    IsVisible="{Binding CanResolve}"
                    SemanticProperties.Hint="Deletes the reported workout and resolves the report"
                    Style="{StaticResource DangerButton}"
                    Text="Remove Content"/>

            </VerticalStackLayout>

        </VerticalStackLayout>
        
    </ScrollView>
    
</ContentPage>