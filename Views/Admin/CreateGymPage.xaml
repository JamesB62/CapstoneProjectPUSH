<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Admin"
             x:Class="CapstoneProjectPUSH.Views.Admin.CreateGymPage"
             x:DataType="vm:CreateGymViewModel"
             Title="{Binding PageTitle}">

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30,20,30,20"
            Spacing="20">

            <!-- Gym name -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Gym Name"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Entry
                        MaxLength="250"
                        Placeholder="Enter the gym's name here"
                        ReturnType="Next"
                        SemanticProperties.Hint="Gym name"
                        Text="{Binding Name}"/>

                </Border>

            </VerticalStackLayout>

            <!-- Address -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Address"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Entry
                        MaxLength="250"
                        Placeholder="Enter the gym's street address here"
                        ReturnType="Next"
                        SemanticProperties.Hint="Street address"
                        Text="{Binding Address}"/>

                </Border>

            </VerticalStackLayout>

            <!-- City -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="City"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Entry
                        MaxLength="100"
                        Placeholder="Enter the gym's city here"
                        ReturnCommand="{Binding SaveCommand}"
                        ReturnType="Done"
                        SemanticProperties.Hint="City"
                        Text="{Binding City}"/>

                </Border>

            </VerticalStackLayout>

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"/>

            <!-- Buttons -->
            <VerticalStackLayout
                Spacing="10">

                <Button
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Text="{Binding SaveButtonText}"/>

                <Button
                    Command="{Binding CancelCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource SecondaryButton}"
                    Text="Cancel"/>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>