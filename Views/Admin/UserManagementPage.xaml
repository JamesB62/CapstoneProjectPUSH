<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Admin"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             x:Class="CapstoneProjectPUSH.Views.Admin.UserManagementPage"
             x:DataType="vm:UserManagementViewModel"
             Title="Manage PUSH Users">

    <Grid
        MaximumWidthRequest="500"
        Padding="30,20,30,0"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="20">

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="20">

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"/>

            <!-- Search bar -->
            <Border
                Style="{StaticResource InputFrame}">

                <SearchBar
                    Placeholder="Search by display name or email..."
                    SemanticProperties.Hint="Search users"
                    Text="{Binding SearchText}"/>

            </Border>

        </VerticalStackLayout>

        <!-- Count, active filter and swipe hint -->
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="5">

            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="10">

                <!-- User count -->
                <Label
                    Grid.Column="0"
                    Style="{StaticResource StatusLabel}"
                    Text="{Binding StatusMessage}"
                    VerticalOptions="Center"/>

                <HorizontalStackLayout
                    Grid.Column="1"
                    Margin="0,-15,0,-15"
                    Spacing="5">

                    <Label
                        AutomationProperties.IsInAccessibleTree="False"
                        Style="{StaticResource StatusLabel}"
                        Text="Active Only"
                        VerticalOptions="Center"/>

                    <Switch
                        IsToggled="{Binding ShowActiveOnly}"
                        SemanticProperties.Description="Show active users only"
                        VerticalOptions="Center"/>

                </HorizontalStackLayout>

            </Grid>

            <Label
                Style="{StaticResource HintLabel}"
                Text="Swipe right to change role or left to change status."/>

        </VerticalStackLayout>

        <RefreshView
            Grid.Row="2"
            Command="{Binding LoadCommand}"
            IsRefreshing="{Binding IsBusy}">

            <CollectionView
                ItemsSource="{Binding Users}">

                <!-- Empty view -->
                <CollectionView.EmptyView>

                    <Grid>

                        <VerticalStackLayout
                            HorizontalOptions="Center"
                            Spacing="5"
                            VerticalOptions="Center">

                            <Label
                                Style="{StaticResource EmptyLabel}"
                                Text="No users found."/>

                            <Label
                                Style="{StaticResource EmptyLabel}"
                                Text="Pull down to try again."/>

                        </VerticalStackLayout>

                    </Grid>

                </CollectionView.EmptyView>

                <!-- Items layout -->
                <CollectionView.ItemsLayout>

                    <LinearItemsLayout
                        ItemSpacing="15"
                        Orientation="Vertical"/>

                </CollectionView.ItemsLayout>

                <!-- Item template -->
                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:User">

                        <Border
                            Style="{StaticResource SwipeClip}">

                            <SwipeView>

                                <!-- Swipe actions -->
                                <SwipeView.LeftItems>

                                    <SwipeItem
                                        BackgroundColor="{StaticResource SwipeEdit}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UserManagementViewModel}}, Path=ToggleAdminCommand}"
                                        CommandParameter="{Binding .}"
                                        Text="{Binding RoleActionLabel}"/>

                                </SwipeView.LeftItems>
                            
                                <SwipeView.RightItems>

                                    <SwipeItems>

                                        <SwipeItem
                                            BackgroundColor="{StaticResource SwipeDelete}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UserManagementViewModel}}, Path=ToggleActiveCommand}"
                                            CommandParameter="{Binding .}"
                                            Text="{Binding ActionLabel}"/>

                                    </SwipeItems>

                                </SwipeView.RightItems>

                                <!-- Card -->
                                <Border
                                    Style="{StaticResource SwipeCard}">

                                    <VerticalStackLayout
                                        Spacing="10">

                                        <!-- Title and status pill -->
                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="10">

                                            <Label
                                                Grid.Column="0"
                                                LineBreakMode="TailTruncation"
                                                Style="{StaticResource CardTitle}"
                                                Text="{Binding DisplayName}"/>

                                            <Border
                                                Grid.Column="1"
                                                Style="{StaticResource Pill}"
                                                VerticalOptions="Start">

                                                <Label
                                                    Style="{StaticResource PillLabel}"
                                                    Text="{Binding StatusLabel}"/>

                                            </Border>

                                        </Grid>

                                        <!-- Info -->
                                        <VerticalStackLayout
                                            Spacing="5">

                                            <Label
                                                LineBreakMode="TailTruncation"
                                                Style="{StaticResource CardBody}"
                                                Text="{Binding Email, StringFormat='Email: {0}'}"/>

                                            <Label
                                                Style="{StaticResource CardBody}"
                                                Text="{Binding RoleLabel, StringFormat='Role: {0}'}"/>

                                        </VerticalStackLayout>

                                        <!-- Credit -->
                                        <Label
                                            Style="{StaticResource CardCredit}"
                                            Text="{Binding DateTimeCreated, StringFormat='Joined on {0:d MMM yyyy}'}"/>

                                    </VerticalStackLayout>

                                </Border>

                            </SwipeView>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>