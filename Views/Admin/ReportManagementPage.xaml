<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Admin"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             x:Class="CapstoneProjectPUSH.Views.Admin.ReportManagementPage"
             x:DataType="vm:ReportManagementViewModel"
             Title="Manage PUSH Reports">

    <Grid
        MaximumWidthRequest="500"
        Padding="30,20,30,0"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="20">

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="20">

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"/>

            <!-- Search bar -->
            <Border
                Style="{StaticResource InputFrame}">

                <SearchBar
                    Placeholder="Search by workout, reporter or reason"
                    SemanticProperties.Hint="Search reports"
                    Text="{Binding SearchText}"/>

            </Border>

        </VerticalStackLayout>

        <!-- Count and pending filter -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="10">

            <!-- Status message -->
            <Label
                Grid.Column="0"
                Style="{StaticResource StatusLabel}"
                Text="{Binding StatusMessage}"
                VerticalOptions="Center"/>

            <!-- Availability toggle -->
            <HorizontalStackLayout
                Grid.Column="1"
                Margin="0,-15,0,-15"
                Spacing="5">

                <Label
                    AutomationProperties.IsInAccessibleTree="False"
                    Style="{StaticResource StatusLabel}"
                    Text="Pending Only"
                    VerticalOptions="Center"/>

                <Switch
                    IsToggled="{Binding ShowPendingOnly}"
                    SemanticProperties.Description="Show pending reports only"
                    VerticalOptions="Center"/>

            </HorizontalStackLayout>

        </Grid>

        <RefreshView
            Grid.Row="2"
            IsRefreshing="{Binding IsBusy}"
            Command="{Binding LoadCommand}">

            <CollectionView
                ItemsSource="{Binding Reports}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedReport}">

                <!-- Empty view -->
                <CollectionView.EmptyView>

                    <Grid>

                        <VerticalStackLayout
                            HorizontalOptions="Center"
                            Spacing="5"
                            VerticalOptions="Center">

                            <Label
                                Style="{StaticResource EmptyLabel}"
                                Text="No reports to show."/>

                            <Label
                                Style="{StaticResource EmptyLabel}"
                                Text="Pull down to try again."/>

                        </VerticalStackLayout>

                    </Grid>

                </CollectionView.EmptyView>

                <!-- Items layout -->
                <CollectionView.ItemsLayout>
                    
                    <LinearItemsLayout
                        ItemSpacing="15"
                        Orientation="Vertical"/>
                    
                </CollectionView.ItemsLayout>

                <!-- Item template -->
                <CollectionView.ItemTemplate>
                    
                    <DataTemplate
                        x:DataType="models:Report">
                        
                        <Border
                            Style="{StaticResource Card}">

                            <VerticalStackLayout
                                Spacing="10">

                                <!-- Title and status pill -->
                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="10">
                                    
                                    <Label
                                        Grid.Column="0"
                                        LineBreakMode="TailTruncation"
                                        Style="{StaticResource CardTitle}"
                                        Text="{Binding Id, StringFormat='Report ID: {0}'}"/>

                                    <Border
                                        Grid.Column="1"
                                        Style="{StaticResource Pill}"
                                        VerticalOptions="Start">
                                                                               
                                        <Label
                                            Style="{StaticResource PillLabel}"
                                            Text="{Binding StatusLabel}"/>
                                        
                                    </Border>
                                    
                                </Grid>

                                <!-- Content -->
                                <Label
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2"
                                    Style="{StaticResource CardBody}"
                                    Text="{Binding Reason}"/>

                                <!-- Credit -->
                                <VerticalStackLayout
                                    Spacing="5">

                                    <!-- Footer -->
                                    <Label
                                        Style="{StaticResource CardCredit}">

                                        <Label.Text>

                                            <MultiBinding
                                                StringFormat="Reported by {0} on {1:d MMM yyyy}">

                                                <Binding
                                                    Path="UserDisplayName"/>

                                                <Binding
                                                    Path="DateTimeCreated"/>

                                            </MultiBinding>

                                        </Label.Text>

                                    </Label>

                                    <Label
                                        IsVisible="{Binding IsResolved}"
                                        Style="{StaticResource CardCredit}"
                                        Text="{Binding ResolvedText}"/>

                                </VerticalStackLayout>
                                
                            </VerticalStackLayout>
                            
                        </Border>

                    </DataTemplate>
                    
                </CollectionView.ItemTemplate>
                
            </CollectionView>
            
        </RefreshView>
        
    </Grid>
    
</ContentPage>