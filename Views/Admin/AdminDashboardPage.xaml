<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Admin"
             x:Class="CapstoneProjectPUSH.Views.Admin.AdminDashboardPage"
             x:DataType="vm:AdminDashboardViewModel"
             Title="PUSH Admin Dashboard">

    <RefreshView
        Command="{Binding LoadDashboardCommand}"
        IsRefreshing="{Binding IsBusy}">

        <ScrollView>

            <VerticalStackLayout
                MaximumWidthRequest="500"
                Padding="30,15"
                Spacing="15">

                <!-- Stats -->
                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="10"
                    RowDefinitions="Auto,Auto,Auto,Auto"
                    RowSpacing="10">

                    <Border
                        Grid.Column="0"
                        Grid.Row="0"
                        Style="{StaticResource Card}">

                        <VerticalStackLayout>

                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                HorizontalOptions="Center"
                                Text="{Binding TotalUsers}"/>

                            <Label
                                HorizontalOptions="Center"
                                Text="Users"/>

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Grid.Column="1"
                        Grid.Row="0"
                        Style="{StaticResource Card}">

                        <VerticalStackLayout>

                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                HorizontalOptions="Center"
                                Text="{Binding TotalActiveUsers}"/>

                            <Label
                                HorizontalOptions="Center"
                                Text="Active Users"/>

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Grid.Column="0"
                        Grid.Row="1"
                        Style="{StaticResource Card}">

                        <VerticalStackLayout>

                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                HorizontalOptions="Center"
                                Text="{Binding TotalTrainers}"/>

                            <Label
                                HorizontalOptions="Center"
                                Text="Trainers"/>

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Grid.Column="1"
                        Grid.Row="1"
                        Style="{StaticResource Card}">

                        <VerticalStackLayout>

                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                HorizontalOptions="Center"
                                Text="{Binding AvailableTrainers}"/>

                            <Label
                                HorizontalOptions="Center"
                                Text="Available Trainers"/>

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Grid.Column="0"
                        Grid.Row="2"
                        Style="{StaticResource Card}">

                        <VerticalStackLayout>

                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                HorizontalOptions="Center"
                                Text="{Binding TotalGyms}"/>

                            <Label
                                HorizontalOptions="Center"
                                Text="Gyms"/>

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Grid.Column="1"
                        Grid.Row="2"
                        Style="{StaticResource Card}">

                        <VerticalStackLayout>

                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                HorizontalOptions="Center"
                                Text="{Binding TotalCategories}"/>

                            <Label
                                HorizontalOptions="Center"
                                Text="Categories"/>

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Grid.Row="3"
                        Style="{StaticResource Card}">

                        <VerticalStackLayout>

                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                HorizontalOptions="Center"
                                Text="{Binding TotalExercises}"/>

                            <Label
                                HorizontalOptions="Center"
                                Text="Exercises"/>

                        </VerticalStackLayout>

                    </Border>

                </Grid>

                <Label
                    HorizontalOptions="Center"
                    IsVisible="{Binding HasStatusMessage}"
                    Text="{Binding StatusMessage}"
                    TextColor="Red"/>

                <!-- Management buttons -->
                <VerticalStackLayout
                    Margin="0,10,0,0"
                    Spacing="10">

                    <Button
                        Command="{Binding GoToUserManagementCommand}"
                        Text="Manage Users"/>

                    <Button
                        Command="{Binding GoToCategoryManagementCommand}"
                        Text="Manage Categories"/>

                    <Button
                        Command="{Binding GoToGymManagementCommand}"
                        Text="Manage Gyms"/>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </ScrollView>

    </RefreshView>

</ContentPage>