<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Admin"
             x:Class="CapstoneProjectPUSH.Views.Admin.AdminDashboardPage"
             x:DataType="vm:AdminDashboardViewModel"
             Title="PUSH Admin Dashboard">

    <RefreshView
        Command="{Binding LoadDashboardCommand}"
        IsRefreshing="{Binding IsBusy}">

        <ScrollView>

            <VerticalStackLayout
                MaximumWidthRequest="500"
                Padding="30,20,30,20"
                Spacing="20">

                <!-- Error message -->
                <Label
                    IsVisible="{Binding HasErrorMessage}"
                    Style="{StaticResource ErrorLabel}"
                    Text="{Binding ErrorMessage}"/>

                <!-- Overview -->
                <Label
                    Style="{StaticResource SectionHeader}"
                    Text="Overview"/>

                <!-- Overview stats -->
                <VerticalStackLayout
                    Spacing="10">

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="15"
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        RowSpacing="15">

                        <Border
                            Grid.Column="0"
                            Grid.Row="0"
                            Style="{StaticResource Card}">

                            <VerticalStackLayout
                                Spacing="5">

                                <Label
                                    SemanticProperties.Description="{Binding TotalUsers, StringFormat='{0} users'}"
                                    Style="{StaticResource StatValue}"
                                    Text="{Binding TotalUsers}"/>

                                <Label
                                    AutomationProperties.IsInAccessibleTree="False"
                                    Style="{StaticResource StatLabel}"
                                    Text="Users"/>

                            </VerticalStackLayout>

                        </Border>

                        <Border
                            Grid.Column="1"
                            Grid.Row="0"
                            Style="{StaticResource Card}">

                            <VerticalStackLayout
                                Spacing="5">

                                <Label
                                    SemanticProperties.Description="{Binding TotalActiveUsers, StringFormat='{0} active users'}"
                                    Style="{StaticResource StatValue}"
                                    Text="{Binding TotalActiveUsers}"/>

                                <Label
                                    AutomationProperties.IsInAccessibleTree="False"
                                    Style="{StaticResource StatLabel}"
                                    Text="Active Users"/>

                            </VerticalStackLayout>

                        </Border>

                        <Border
                            Grid.Column="0"
                            Grid.Row="1"
                            Style="{StaticResource Card}">

                            <VerticalStackLayout
                                Spacing="5">

                                <Label
                                    SemanticProperties.Description="{Binding TotalTrainers, StringFormat='{0} trainers'}"
                                    Style="{StaticResource StatValue}"
                                    Text="{Binding TotalTrainers}"/>

                                <Label
                                    AutomationProperties.IsInAccessibleTree="False"
                                    Style="{StaticResource StatLabel}"
                                    Text="Trainers"/>

                            </VerticalStackLayout>

                        </Border>

                        <Border
                            Grid.Column="1"
                            Grid.Row="1"
                            Style="{StaticResource Card}">

                            <VerticalStackLayout
                                Spacing="5">

                                <Label
                                    SemanticProperties.Description="{Binding AvailableTrainers, StringFormat='{0} available trainers'}"
                                    Style="{StaticResource StatValue}"
                                    Text="{Binding AvailableTrainers}"/>

                                <Label
                                    AutomationProperties.IsInAccessibleTree="False"
                                    Style="{StaticResource StatLabel}"
                                    Text="Available Trainers"/>

                            </VerticalStackLayout>

                        </Border>

                        <Border
                            Grid.Column="0"
                            Grid.Row="2"
                            Style="{StaticResource Card}">

                            <VerticalStackLayout
                                Spacing="5">

                                <Label
                                    SemanticProperties.Description="{Binding TotalGyms, StringFormat='{0} gyms'}"
                                    Style="{StaticResource StatValue}"
                                    Text="{Binding TotalGyms}"/>

                                <Label
                                    AutomationProperties.IsInAccessibleTree="False"
                                    Style="{StaticResource StatLabel}"
                                    Text="Gyms"/>

                            </VerticalStackLayout>

                        </Border>

                        <Border
                            Grid.Column="1"
                            Grid.Row="2"
                            Style="{StaticResource Card}">

                            <VerticalStackLayout
                                Spacing="5">

                                <Label
                                    SemanticProperties.Description="{Binding TotalCategories, StringFormat='{0} categories'}"
                                    Style="{StaticResource StatValue}"
                                    Text="{Binding TotalCategories}"/>

                                <Label
                                    AutomationProperties.IsInAccessibleTree="False"
                                    Style="{StaticResource StatLabel}"
                                    Text="Categories"/>

                            </VerticalStackLayout>

                        </Border>

                        <Border
                            Grid.Column="0"
                            Grid.Row="3"
                            Style="{StaticResource Card}">

                            <VerticalStackLayout
                                Spacing="5">

                                <Label
                                    SemanticProperties.Description="{Binding TotalExercises, StringFormat='{0} exercises'}"
                                    Style="{StaticResource StatValue}"
                                    Text="{Binding TotalExercises}"/>

                                <Label
                                    AutomationProperties.IsInAccessibleTree="False"
                                    Style="{StaticResource StatLabel}"
                                    Text="Exercises"/>

                            </VerticalStackLayout>

                        </Border>

                        <Border
                            Grid.Column="1"
                            Grid.Row="3"
                            Style="{StaticResource Card}">

                            <VerticalStackLayout
                                Spacing="5">

                                <Label
                                    SemanticProperties.Description="{Binding PendingReports, StringFormat='{0} pending reports'}"
                                    Style="{StaticResource StatValue}"
                                    Text="{Binding PendingReports}"/>

                                <Label
                                    AutomationProperties.IsInAccessibleTree="False"
                                    Style="{StaticResource StatLabel}"
                                    Text="Pending Reports"/>

                            </VerticalStackLayout>

                        </Border>

                    </Grid>

                </VerticalStackLayout>

                <!-- Manage -->
                <Label
                    Style="{StaticResource SectionHeader}"
                    Text="Manage"/>

                <!-- Management buttons -->
                <VerticalStackLayout
                    Spacing="10">

                    <Button
                        Command="{Binding GoToUserManagementCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Text="Manage Users"/>

                    <Button
                        Command="{Binding GoToCategoryManagementCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Text="Manage Categories"/>

                    <Button
                        Command="{Binding GoToGymManagementCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Text="Manage Gyms"/>

                    <Button
                        Command="{Binding GoToReportsCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Text="Manage Reports"/>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </ScrollView>

    </RefreshView>

</ContentPage>