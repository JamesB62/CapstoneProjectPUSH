<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Admins"
             x:Class="CapstoneProjectPUSH.Views.Admin.AdminDashboard"
             Title="Admin Dashboard">

    <ContentPage.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F2F2F7, Dark=#2C2C2E}" />
        </Style> 
        <Style x:Key="StatValue" TargetType="Label">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>
        <Style x:Key="StatLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">

            <!-- Admin sign in -->
            <VerticalStackLayout IsVisible="{Binding IsSignedOut}" Spacing="12">
                <Label Text="Admin Sign In" FontSize="24" FontAttributes="Bold" />
                <Label Text="Sign in with an administrator account to continue." />

                <Entry Placeholder="Email"
                       Keyboard="Email"
                       ReturnType="Next"
                       Text="{Binding Email}" />

                <Entry Placeholder="Password"
                       IsPassword="True"
                       ReturnType="Done"
                       ReturnCommand="{Binding SignInCommand}"
                       Text="{Binding Password}" />

                <Label Text="{Binding StatusMessage}"
                       TextColor="Red"
                       IsVisible="{Binding HasStatusMessage}" />

                <Button Text="Sign In"
                        Command="{Binding SignInCommand}"
                        IsEnabled="{Binding IsNotBusy}" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}" />

                <Button Text="Back to app"
                        Command="{Binding NavigateToHomeCommand}" />
            </VerticalStackLayout>

            <!-- Dashboard (admins only) -->
            <VerticalStackLayout IsVisible="{Binding IsSignedIn}" Spacing="16">
                <Label Text="{Binding AdminName, StringFormat='Welcome, {0}'}"
                       FontSize="24"
                       FontAttributes="Bold" />

                <Label Text="{Binding StatusMessage}"
                       TextColor="Red"
                       IsVisible="{Binding HasStatusMessage}" />

                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="12">

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="{Binding TotalUsers}" Style="{StaticResource StatValue}" />
                            <Label Text="Users" Style="{StaticResource StatLabel}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="{Binding TotalTrainers}" Style="{StaticResource StatValue}" />
                            <Label Text="Trainers" Style="{StaticResource StatLabel}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="{Binding AvailableTrainers}" Style="{StaticResource StatValue}" />
                            <Label Text="Available trainers" Style="{StaticResource StatLabel}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="{Binding TotalGyms}" Style="{StaticResource StatValue}" />
                            <Label Text="Gyms" Style="{StaticResource StatLabel}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="{Binding TotalExercises}" Style="{StaticResource StatValue}" />
                            <Label Text="Exercises" Style="{StaticResource StatLabel}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="{Binding TotalArticles}" Style="{StaticResource StatValue}" />
                            <Label Text="Articles" Style="{StaticResource StatLabel}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
                
                <!-- User Management -->
                
                <Label Text="User Management" FontSize="20" FontAttributes="Bold" />
                
                <Label Text="No Users found."
                       IsVisible="{Binding HasNoUsers}" />


                <VerticalStackLayout Spacing="10"
                                     BindableLayout.ItemsSource="{Binding Users}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding DisplayName}" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="{Binding Email}" />

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,8,0,0">
                                        <Button Grid.Column="0"
                            Text="Toggle Status"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminDashboardViewModel}}, Path=ToggleStatusCommand}"
                            CommandParameter="{Binding .}" />
                                        <Button Grid.Column="1"
                            Text="Delete"
                            BackgroundColor="Firebrick"
                            TextColor="White"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminDashboardViewModel}}, Path=DeleteUserCommand}"
                            CommandParameter="{Binding .}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>




                <!-- Trainer management -->
                <Label Text="Manage Trainers" FontSize="20" FontAttributes="Bold" />

                <Label Text="No trainers found."
                       IsVisible="{Binding HasNoTrainers}" />

                <VerticalStackLayout Spacing="10"
                                     BindableLayout.ItemsSource="{Binding Trainers}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding FullName}" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="{Binding CategoryName}" />

                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="{Binding GymName}" />
                                        <Label Text="{Binding GymCity, StringFormat='({0})'}" />
                                    </HorizontalStackLayout>

                                    <Label Text="{Binding AvailableText}" FontAttributes="Italic" />

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,8,0,0">
                                        <Button Grid.Column="0"
                                                Text="Toggle availability"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminDashboardViewModel}}, Path=ToggleAvailabilityCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="1"
                                                Text="Delete"
                                                BackgroundColor="Firebrick"
                                                TextColor="White"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminDashboardViewModel}}, Path=DeleteTrainerCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Navigation / session -->
                <Button Text="Refresh" Command="{Binding RefreshCommand}" />
                <Button Text="Open Trainers page" Command="{Binding NavigateToTrainersCommand}" />
                <Button Text="Open Users page" Command="{Binding NavigateToUsersCommand}" />
                <Button Text="Back to app" Command="{Binding NavigateToHomeCommand}" />
                <Button Text="Sign out"
                        Command="{Binding SignOutCommand}"
                        BackgroundColor="Firebrick"
                        TextColor="White" />
            </VerticalStackLayout>

        </VerticalStackLayout>
            
    </ScrollView>
</ContentPage>
