<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Admin"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             x:Class="CapstoneProjectPUSH.Views.Admin.GymsManagementPage"
             x:DataType="vm:GymsManagementViewModel"
             Title="Manage Gyms">

    <Grid
        MaximumWidthRequest="500"
        Padding="30,15"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="10">

        <!-- Add / edit form -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">

            <Entry
                MaxLength="250"
                Placeholder="Gym name"
                Text="{Binding NameInput}"/>

            <Entry
                MaxLength="250"
                Placeholder="Address"
                Text="{Binding AddressInput}"/>

            <Entry
                MaxLength="100"
                Placeholder="City"
                ReturnCommand="{Binding SaveCommand}"
                ReturnType="Done"
                Text="{Binding CityInput}"/>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                <Button
                    Grid.Column="0"
                    Command="{Binding SaveCommand}"
                    Text="{Binding SaveButtonText}"/>

                <Button
                    Grid.Column="1"
                    Command="{Binding CancelEditCommand}"
                    IsVisible="{Binding IsEditing}"
                    Text="Cancel"/>

            </Grid>

        </VerticalStackLayout>

        <Label
            Grid.Row="1"
            HorizontalOptions="Center"
            IsVisible="{Binding HasStatusMessage}"
            Text="{Binding StatusMessage}"/>

        <RefreshView
            Grid.Row="2"
            Command="{Binding LoadCommand}"
            IsRefreshing="{Binding IsBusy}">

            <CollectionView ItemsSource="{Binding Gyms}">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <Label HorizontalOptions="Center" Text="No gyms yet."/>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Gym">

                        <Border Style="{StaticResource Card}">

                            <VerticalStackLayout Spacing="4">

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding Name}"/>

                                <Label Text="{Binding FullAddress}"/>

                                <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="8"
                                    Margin="0,8,0,0">

                                    <Button
                                        Grid.Column="0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GymsManagementViewModel}}, Path=EditCommand}"
                                        CommandParameter="{Binding .}"
                                        Text="Edit"/>

                                    <Button
                                        Grid.Column="1"
                                        BackgroundColor="Firebrick"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GymsManagementViewModel}}, Path=DeleteCommand}"
                                        CommandParameter="{Binding .}"
                                        Text="Delete"
                                        TextColor="White"/>

                                </Grid>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>
