<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Admin"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             x:Class="CapstoneProjectPUSH.Views.Admin.GymsManagementPage"
             x:DataType="vm:GymsManagementViewModel"
             Title="Manage PUSH Gyms">

    <ContentPage.ToolbarItems>

        <ToolbarItem
            Command="{Binding AddCommand}"
            Order="Secondary"
            Text="Add Gym"/>

    </ContentPage.ToolbarItems>

    <Grid
        MaximumWidthRequest="500"
        Padding="30,20,30,0"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="20">

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="20">

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"/>

            <!-- Search bar -->
            <Border
                Style="{StaticResource InputFrame}">

                <SearchBar
                    Placeholder="Search by name or city..."
                    SemanticProperties.Hint="Search gyms"
                    Text="{Binding SearchText}"/>

            </Border>

        </VerticalStackLayout>

        <!-- Count and swipe hint -->
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="5">

            <!-- Gym count -->
            <Label
                Style="{StaticResource StatusLabel}"
                Text="{Binding StatusMessage}"/>

            <!-- Swipe hint -->
            <Label
                Style="{StaticResource HintLabel}"
                Text="Swipe right to edit or left to delete."/>

        </VerticalStackLayout>

        <RefreshView
            Grid.Row="2"
            Command="{Binding LoadCommand}"
            IsRefreshing="{Binding IsBusy}">

            <CollectionView
                ItemsSource="{Binding Gyms}">

                <!-- Empty view -->
                <CollectionView.EmptyView>

                    <Grid>

                        <VerticalStackLayout
                            HorizontalOptions="Center"
                            Spacing="5"
                            VerticalOptions="Center">

                            <Label
                                Style="{StaticResource EmptyLabel}"
                                Text="No gyms found."/>

                            <Label
                                Style="{StaticResource EmptyLabel}"
                                Text="Pull down to try again."/>

                        </VerticalStackLayout>

                    </Grid>

                </CollectionView.EmptyView>

                <!-- Items layout -->
                <CollectionView.ItemsLayout>

                    <LinearItemsLayout
                        ItemSpacing="15"
                        Orientation="Vertical"/>

                </CollectionView.ItemsLayout>

                <!-- Item template -->
                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:Gym">

                        <Border
                            Style="{StaticResource SwipeClip}">

                            <SwipeView>

                                <!-- Swipe actions -->
                                <SwipeView.LeftItems>

                                    <SwipeItems>

                                        <SwipeItem
                                            BackgroundColor="{StaticResource SwipeEdit}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GymsManagementViewModel}}, Path=EditCommand}"
                                            CommandParameter="{Binding .}"
                                            Text="Edit"/>

                                    </SwipeItems>

                                </SwipeView.LeftItems>

                                <SwipeView.RightItems>

                                    <SwipeItems>

                                        <SwipeItem
                                            BackgroundColor="{StaticResource SwipeDelete}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GymsManagementViewModel}}, Path=DeleteCommand}"
                                            CommandParameter="{Binding .}"
                                            Text="Delete"/>

                                    </SwipeItems>

                                </SwipeView.RightItems>

                                <!-- Card -->
                                <Border
                                    Style="{StaticResource SwipeCard}">

                                    <VerticalStackLayout
                                        Spacing="10">

                                        <!-- Header -->
                                        <Label
                                            LineBreakMode="TailTruncation"
                                            Style="{StaticResource CardTitle}"
                                            Text="{Binding Name}"/>

                                        <!-- Info -->
                                        <Label
                                            LineBreakMode="TailTruncation"
                                            Style="{StaticResource CardBody}"
                                            Text="{Binding FullAddress}"/>

                                    </VerticalStackLayout>

                                </Border>

                            </SwipeView>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>
