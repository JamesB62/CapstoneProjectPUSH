<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Workouts"
             x:Class="CapstoneProjectPUSH.Views.Workouts.WorkoutsPage"
             x:DataType="vm:WorkoutsViewModel"
             Title="PUSH Workouts">

    <ContentPage.ToolbarItems>

        <ToolbarItem
            Command="{Binding AddWorkoutCommand}"
            Order="Secondary"
            Text="Add Workout"/>

    </ContentPage.ToolbarItems>

    <Grid
        MaximumWidthRequest="500"
        Padding="30,20,30,0"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="20">

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="20">

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"/>

            <!-- Search bar -->
            <Border
                Style="{StaticResource InputFrame}">

                <SearchBar
                    Placeholder="Search by title or category..."
                    SemanticProperties.Hint="Search workouts"
                    Text="{Binding SearchText}"/>

            </Border>

        </VerticalStackLayout>

        <!-- Count and swipe hint -->
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="5">

            <Label
                Style="{StaticResource StatusLabel}"
                Text="{Binding StatusMessage}"/>

            <Label
                IsVisible="{Binding IsLoggedIn}"
                Style="{StaticResource HintLabel}"
                Text="Swipe right to edit or left to delete."/>

        </VerticalStackLayout>

        <RefreshView
            Command="{Binding LoadWorkoutsCommand}"
            Grid.Row="2"
            IsRefreshing="{Binding IsBusy}">

            <CollectionView
                ItemsSource="{Binding Workouts}"
                SelectedItem="{Binding SelectedWorkout, Mode=TwoWay}"
                SelectionMode="Single">

                <!-- Empty view -->
                <CollectionView.EmptyView>

                    <Grid>

                        <VerticalStackLayout
                            HorizontalOptions="Center"
                            Spacing="5"
                            VerticalOptions="Center">

                            <Label
                                Style="{StaticResource EmptyLabel}"
                                Text="No workouts found."/>

                            <Label
                                Style="{StaticResource EmptyLabel}"
                                Text="Tap Add Workout to create one, or pull down to try again."/>

                        </VerticalStackLayout>

                    </Grid>

                </CollectionView.EmptyView>

                <!-- Items layout -->
                <CollectionView.ItemsLayout>

                    <LinearItemsLayout
                        ItemSpacing="15"
                        Orientation="Vertical"/>

                </CollectionView.ItemsLayout>

                <!-- Item template -->
                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:Workout">

                        <Border
                            Style="{StaticResource SwipeClip}">

                            <SwipeView>

                                <!-- Swipe actions -->
                                <SwipeView.LeftItems>

                                    <SwipeItems>

                                        <SwipeItem
                                            BackgroundColor="{StaticResource SwipeEdit}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutsViewModel}}, Path=EditWorkoutCommand}"
                                            CommandParameter="{Binding .}"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutsViewModel}}, Path=IsLoggedIn}"
                                            Text="Edit"/>

                                    </SwipeItems>

                                </SwipeView.LeftItems>

                                <SwipeView.RightItems>

                                    <SwipeItems>

                                        <SwipeItem
                                            BackgroundColor="{StaticResource SwipeDelete}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutsViewModel}}, Path=DeleteWorkoutCommand}"
                                            CommandParameter="{Binding .}"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutsViewModel}}, Path=IsLoggedIn}"
                                            Text="Delete"/>

                                    </SwipeItems>

                                </SwipeView.RightItems>

                                <!-- Card -->
                                <Border
                                    Style="{StaticResource SwipeCard}">

                                    <VerticalStackLayout
                                        Spacing="10">

                                        <!-- Title, favourite and category pill -->
                                        <Grid
                                            ColumnDefinitions="*,Auto,Auto"
                                            ColumnSpacing="10">

                                            <Label
                                                Grid.Column="0"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="2"
                                                Style="{StaticResource CardTitle}"
                                                Text="{Binding Title}"
                                                VerticalOptions="Center"/>

                                            <Border
                                                Grid.Column="1"
                                                Style="{StaticResource Pill}"
                                                VerticalOptions="Start">

                                                <Label
                                                    Style="{StaticResource PillLabel}"
                                                    Text="{Binding CategoryTitle}"/>

                                            </Border>

                                            <!-- Favourite star -->
                                            <Label
                                                FontSize="16"
                                                Grid.Column="2"
                                                IsVisible="{Binding IsFavourite}"
                                                SemanticProperties.Description="Favourite"
                                                Text="★"
                                                TextColor="{StaticResource Favourite}"
                                                VerticalOptions="Start"/>

                                        </Grid>

                                        <!-- Info -->
                                        <VerticalStackLayout
                                            Spacing="5">

                                            <Label
                                                Style="{StaticResource CardBody}"
                                                Text="{Binding ExerciseCount, StringFormat='Exercises: {0}'}"/>

                                            <Label
                                                IsVisible="{Binding HasSets}"
                                                Style="{StaticResource CardBody}"
                                                Text="{Binding SetCount, StringFormat='Sets: {0}'}"/>

                                            <Label
                                                IsVisible="{Binding HasMinutes}"
                                                Style="{StaticResource CardBody}"
                                                Text="{Binding TotalMinutes, StringFormat='Time: {0} min'}"/>

                                        </VerticalStackLayout>

                                        <!-- Date time created -->
                                        <Label
                                            Style="{StaticResource CardCredit}"
                                            Text="{Binding DateTimeCreated, StringFormat='Created on {0:d MMM yyyy}'}"/>

                                    </VerticalStackLayout>

                                </Border>

                            </SwipeView>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>