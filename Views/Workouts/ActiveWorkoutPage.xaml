<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Workouts"
             x:Class="CapstoneProjectPUSH.Views.Workouts.ActiveWorkoutPage"
             x:DataType="vm:ActiveWorkoutViewModel"
             Title="Active Workout">

    <Grid
        MaximumWidthRequest="500"
        Padding="30,20,30,20"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="20">

        <!-- Workout title and timer -->
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="5">

            <Label
                HorizontalTextAlignment="Center"
                Style="{StaticResource DetailTitle}"
                Text="{Binding Workout.Title}"/>

            <Label
                HorizontalTextAlignment="Center"
                SemanticProperties.Description="{Binding ElapsedText, StringFormat='Elapsed time: {0}'}"
                Style="{StaticResource TimerLabel}"
                Text="{Binding ElapsedText}"/>

        </VerticalStackLayout>

        <!-- Exercises heading and progress -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="10">

            <Label
                Grid.Column="0"
                Style="{StaticResource SectionHeader}"
                Text="Exercises"
                VerticalOptions="Center"/>

            <Label
                Grid.Column="1"
                Style="{StaticResource StatusLabel}"
                Text="{Binding CompletedText}"
                VerticalOptions="Center"/>

        </Grid>

        <!-- Checklist -->
        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Exercises}"
            SelectedItem="{Binding SelectedExercise, Mode=TwoWay}"
            SelectionMode="Single">

            <!-- Items layout -->
            <CollectionView.ItemsLayout>

                <LinearItemsLayout
                    ItemSpacing="15"
                    Orientation="Vertical"/>

            </CollectionView.ItemsLayout>

            <!-- Item template -->
            <CollectionView.ItemTemplate>

                <DataTemplate
                    x:DataType="vm:ActiveExercise">

                    <!-- Card -->
                    <Border
                        Stroke="{StaticResource Accent}"
                        Style="{StaticResource Card}">

                        <Border.Triggers>

                            <DataTrigger
                                Binding="{Binding IsCompleted}"
                                TargetType="Border"
                                Value="True">

                                <Setter
                                    Property="StrokeThickness"
                                    Value="1"/>

                            </DataTrigger>

                        </Border.Triggers>

                        <Grid
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="15">

                            <!-- Exercise order number -->
                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Grid.Column="0"
                                Text="{Binding WorkoutExercise.DisplayNumber}"
                                TextColor="{StaticResource Accent}"
                                VerticalOptions="Center"/>

                            <!-- Title and target -->
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="5">

                                <Label
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2"
                                    Style="{StaticResource CardTitle}"
                                    Text="{Binding WorkoutExercise.ExerciseTitle}"/>

                                <Label
                                    Style="{StaticResource CardBody}"
                                    Text="{Binding WorkoutExercise.TargetText}"/>

                            </VerticalStackLayout>

                            <!-- Checkbox -->
                            <CheckBox
                                Grid.Column="2"
                                InputTransparent="True"
                                IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                SemanticProperties.Description="Completed"
                                VerticalOptions="Center"/>

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Status and finish -->
        <VerticalStackLayout
            Grid.Row="3"
            Spacing="10">

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"/>

            <Button
                Command="{Binding FinishWorkoutCommand}"
                Text="Finish Workout"/>

        </VerticalStackLayout>

    </Grid>

</ContentPage>