<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Workouts"
             x:Class="CapstoneProjectPUSH.Views.Workouts.SelectExercisesPage"
             x:DataType="vm:SelectExercisesViewModel"
             Title="Select Exercises">

    <Grid
        MaximumWidthRequest="500"
        Padding="30,20,30,20"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="20">

        <!-- Search -->
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="20">

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"/>

            <!-- Search bar -->
            <Border
                Style="{StaticResource InputFrame}">

                <SearchBar
                    Placeholder="Search by title or category..."
                    SemanticProperties.Hint="Search exercises"
                    Text="{Binding SearchText}"/>

            </Border>

        </VerticalStackLayout>

        <VerticalStackLayout
            Grid.Row="1"
            Spacing="5">

            <!-- Status message -->
            <Label
                Style="{StaticResource StatusLabel}"
                Text="{Binding StatusMessage}"/>

            <Label
                Style="{StaticResource HintLabel}"
                Text="Tap an exercise to add or remove it."/>

        </VerticalStackLayout>

        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Exercises}"
            SelectedItem="{Binding SelectedExercise, Mode=TwoWay}"
            SelectionMode="Single">

            <!-- Empty view -->
            <CollectionView.EmptyView>

                <Grid>

                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource EmptyLabel}"
                        Text="No exercises found."
                        VerticalTextAlignment="Center"/>

                </Grid>

            </CollectionView.EmptyView>

            <!-- Items layout -->
            <CollectionView.ItemsLayout>

                <LinearItemsLayout
                    ItemSpacing="15"
                    Orientation="Vertical"/>

            </CollectionView.ItemsLayout>

            <!-- Item template -->
            <CollectionView.ItemTemplate>

                <DataTemplate
                    x:DataType="vm:SelectableExercise">

                    <!-- Card -->
                    <Border
                        Stroke="{StaticResource Accent}"
                        Style="{StaticResource Card}">

                        <Border.Triggers>

                            <DataTrigger
                                Binding="{Binding IsSelected}"
                                TargetType="Border"
                                Value="True">

                                <Setter
                                    Property="StrokeThickness"
                                    Value="1"/>

                            </DataTrigger>

                        </Border.Triggers>

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="10">

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="10">

                                <!-- Title and category pill -->
                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="10">

                                    <Label
                                        Grid.Column="0"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2"
                                        Style="{StaticResource CardTitle}"
                                        Text="{Binding Exercise.Title}"
                                        VerticalOptions="Center"/>

                                    <Border
                                        Grid.Column="1"
                                        Style="{StaticResource Pill}"
                                        VerticalOptions="Start">

                                        <Label
                                            Style="{StaticResource PillLabel}"
                                            Text="{Binding Exercise.CategoryTitle}"/>

                                    </Border>

                                </Grid>

                                <!-- Description preview -->
                                <Label
                                    AutomationProperties.IsInAccessibleTree="False"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2"
                                    Style="{StaticResource CardBody}"
                                    Text="{Binding Exercise.Description}"/>

                                <!-- Difficulty -->
                                <Label
                                    Style="{StaticResource CardCredit}"
                                    Text="{Binding Exercise.DifficultyLabel, StringFormat='Difficulty: {0}'}"/>
                                
                            </VerticalStackLayout>

                            <!-- Checkbox -->
                            <CheckBox
                                Grid.Column="1"
                                InputTransparent="True"
                                IsChecked="{Binding IsSelected, Mode=OneWay}"
                                SemanticProperties.Description="Selected"
                                VerticalOptions="Center"/>

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <Button
            Command="{Binding DoneCommand}"
            Grid.Row="3"
            SemanticProperties.Description="{Binding SelectedCount, StringFormat='Done, {0} selected'}"
            Text="{Binding SelectedCount, StringFormat='Done ({0})'}"/>

    </Grid>

</ContentPage>