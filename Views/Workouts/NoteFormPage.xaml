<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Workouts"
             x:Class="CapstoneProjectPUSH.Views.Workouts.NoteFormPage"
             x:DataType="vm:NoteFormViewModel"
             Title="{Binding PageTitle}">

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30"
            Spacing="20">

            <!-- Note form -->
            <VerticalStackLayout>

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Title"/>

                <Entry
                    MaxLength="100"
                    Placeholder="Enter a title here"
                    Text="{Binding NoteTitle}"/>

            </VerticalStackLayout>

            <VerticalStackLayout>

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Note"/>

                <Editor
                    AutoSize="TextChanges"
                    MaxLength="5000"
                    MinimumHeightRequest="150"
                    Placeholder="Write your note here"
                    Text="{Binding NoteContent}"/>

            </VerticalStackLayout>

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Text="{Binding ErrorMessage}"
                TextColor="Red"/>

            <!-- Buttons -->
            <VerticalStackLayout
                Margin="0,5,0,0"
                Spacing="10">

                <Button
                    Command="{Binding SaveNoteCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Text="{Binding SaveButtonText}"/>

                <Button
                    Command="{Binding CancelCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Text="Cancel"/>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>