<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Workouts"
             x:Class="CapstoneProjectPUSH.Views.Workouts.NoteFormPage"
             x:DataType="vm:NoteFormViewModel"
             Title="{Binding PageTitle}">

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30,20,30,20"
            Spacing="20">

            <!-- Notice -->
            <Border
                Style="{StaticResource NoticeCard}">

                <Label
                    Style="{StaticResource CardBody}"
                    Text="Your notes are private to you, but don't use them to store sensitive information such as passwords, bank account details or health information."/>

            </Border>
            
            <!-- Title-->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Title"/>

                <Border
                    Style="{StaticResource InputFrame}">
                    
                    <Entry
                        MaxLength="100"
                        Placeholder="Enter a title here"
                        ReturnType="Next"
                        SemanticProperties.Hint="Note title"
                        Text="{Binding NoteTitle}"/>

                </Border>

            </VerticalStackLayout>

            <!-- Note -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Note"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Editor
                        AutoSize="TextChanges"
                        MaxLength="5000"
                        MinimumHeightRequest="150"
                        Placeholder="Write your note here"
                        SemanticProperties.Hint="Note"
                        Text="{Binding NoteContent}"/>

                </Border>

            </VerticalStackLayout>

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"/>

            <!-- Buttons -->
            <VerticalStackLayout
                Spacing="10">

                <Button
                    Command="{Binding SaveNoteCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Text="{Binding SaveButtonText}"/>

                <Button
                    Command="{Binding CancelCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource SecondaryButton}"
                    Text="Cancel"/>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>