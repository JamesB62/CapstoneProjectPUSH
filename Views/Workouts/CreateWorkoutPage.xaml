<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Workouts"
             x:Class="CapstoneProjectPUSH.Views.Workouts.CreateWorkoutPage"
             x:DataType="vm:CreateWorkoutViewModel"
             Title="{Binding PageTitle}">

    <Grid
        MaximumWidthRequest="500"
        Padding="30,15"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="15">

        <!-- Title and category -->
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="10">

            <Entry
                MaxLength="100"
                Placeholder="Workout name (e.g. Push Day)"
                Text="{Binding WorkoutTitle}"/>

            <Picker
                ItemDisplayBinding="{Binding Title, x:DataType=models:Category}"
                ItemsSource="{Binding Categories}"
                SelectedItem="{Binding SelectedCategory}"
                Title="Category"/>

            <!-- Community visibility -->
            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="10">

                <Label
                    Grid.Column="0"
                    Text="Share with the PUSH community"
                    VerticalOptions="Center"/>

                <Switch
                    Grid.Column="1"
                    IsToggled="{Binding IsPublic}"
                    VerticalOptions="Center"/>

            </Grid>

        </VerticalStackLayout>

        <Grid
            ColumnDefinitions="*,Auto"
            ColumnSpacing="10"
            Grid.Row="1">

            <Label
                FontAttributes="Bold"
                FontSize="16"
                Grid.Column="0"
                Text="Exercises"
                VerticalOptions="Center"/>

            <Button
                Command="{Binding AddExercisesCommand}"
                Grid.Column="1"
                Text="Add Exercises"/>

        </Grid>

        <!-- Exercise list -->
        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Items}">

            <!-- Empty view -->
            <CollectionView.EmptyView>

                <VerticalStackLayout
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Label
                        FontAttributes="Italic"
                        HorizontalTextAlignment="Center"
                        Text="No exercises added yet."/>

                    <Label
                        FontAttributes="Italic"
                        HorizontalTextAlignment="Center"
                        Text="Tap Add Exercises to pick some."/>

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <!-- Item layout -->
            <CollectionView.ItemsLayout>

                <LinearItemsLayout
                    ItemSpacing="10"
                    Orientation="Vertical"/>

            </CollectionView.ItemsLayout>

            <!-- Item template -->
            <CollectionView.ItemTemplate>

                <DataTemplate
                    x:DataType="vm:WorkoutExerciseDraft">

                    <Border
                        BackgroundColor="#F9FAFB"
                        Padding="15"
                        Stroke="#E5E7EB"
                        StrokeShape="RoundRectangle 12">

                        <VerticalStackLayout
                            Spacing="10">

                            <!-- Title and order/remove -->
                            <Grid
                                ColumnDefinitions="*,Auto,Auto,Auto"
                                ColumnSpacing="5">

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Grid.Column="0"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Exercise.Title}"
                                    VerticalOptions="Center"/>

                                <Button
                                    BackgroundColor="Transparent"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CreateWorkoutViewModel}}, Path=MoveUpCommand}"
                                    CommandParameter="{Binding .}"
                                    Grid.Column="1"
                                    HeightRequest="30"
                                    Padding="0"
                                    Text="▲"
                                    TextColor="Black"
                                    WidthRequest="30"/>

                                <Button
                                    BackgroundColor="Transparent"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CreateWorkoutViewModel}}, Path=MoveDownCommand}"
                                    CommandParameter="{Binding .}"
                                    Grid.Column="2"
                                    HeightRequest="30"
                                    Padding="0"
                                    Text="▼"
                                    TextColor="Black"
                                    WidthRequest="30"/>

                                <Button
                                    BackgroundColor="Transparent"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CreateWorkoutViewModel}}, Path=RemoveItemCommand}"
                                    CommandParameter="{Binding .}"
                                    Grid.Column="3"
                                    HeightRequest="30"
                                    Padding="0"
                                    Text="✕"
                                    TextColor="Red"
                                    WidthRequest="30"/>

                            </Grid>

                            <!-- Sets and reps -->
                            <Grid
                                ColumnDefinitions="Auto,*,Auto,*"
                                ColumnSpacing="10"
                                IsVisible="{Binding IsNotTimed}">

                                <Label
                                    Grid.Column="0"
                                    Text="Sets"
                                    VerticalOptions="Center"/>

                                <Entry
                                    Grid.Column="1"
                                    HorizontalTextAlignment="Center"
                                    Keyboard="Numeric"
                                    MaxLength="2"
                                    Text="{Binding SetsText}"/>

                                <Label
                                    Grid.Column="2"
                                    Text="Reps"
                                    VerticalOptions="Center"/>

                                <Entry
                                    Grid.Column="3"
                                    HorizontalTextAlignment="Center"
                                    Keyboard="Numeric"
                                    MaxLength="3"
                                    Text="{Binding RepsText}"/>

                            </Grid>

                            <!-- Duration -->
                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="10"
                                IsVisible="{Binding IsTimed}">

                                <Label
                                    Grid.Column="0"
                                    Text="Minutes"
                                    VerticalOptions="Center"/>

                                <Entry
                                    Grid.Column="1"
                                    HorizontalTextAlignment="Center"
                                    Keyboard="Numeric"
                                    MaxLength="3"
                                    Text="{Binding DurationText}"/>

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <VerticalStackLayout
            Grid.Row="3"
            Spacing="10">

            <Label
                FontAttributes="Italic"
                FontSize="12"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding HasStatusMessage}"
                Text="{Binding StatusMessage}"/>

            <Button
                Command="{Binding SaveCommand}"
                Text="{Binding SaveButtonText}"/>

        </VerticalStackLayout>

    </Grid>

</ContentPage>