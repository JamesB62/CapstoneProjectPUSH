<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Workouts"
             x:Class="CapstoneProjectPUSH.Views.Workouts.CreateWorkoutPage"
             x:DataType="vm:CreateWorkoutViewModel"
             Title="{Binding PageTitle}">

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30"
            Spacing="20">

            <!-- Workout form -->
            <VerticalStackLayout>

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Title"/>

                <Entry
                    MaxLength="100"
                    Placeholder="Enter a title here"
                    Text="{Binding WorkoutTitle}"/>

            </VerticalStackLayout>

            <VerticalStackLayout>

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Category"/>

                <Picker
                    ItemDisplayBinding="{Binding Title, x:DataType=models:Category}"
                    ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding SelectedCategory}"
                    Title="Choose a category"/>

            </VerticalStackLayout>

            <!-- Exercises -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Exercises"/>

                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding Items}"
                    Spacing="10">

                    <!-- Empty view -->
                    <BindableLayout.EmptyView>

                        <Grid
                            HeightRequest="150">

                            <VerticalStackLayout
                                HorizontalOptions="Center"
                                VerticalOptions="Center">

                                <Label
                                    FontAttributes="Italic"
                                    HorizontalTextAlignment="Center"
                                    Text="No exercises added yet."/>

                                <Label
                                    FontAttributes="Italic"
                                    HorizontalTextAlignment="Center"
                                    Text="Tap Add Exercises to pick some."/>

                            </VerticalStackLayout>

                        </Grid>

                    </BindableLayout.EmptyView>

                    <!-- Item template -->
                    <BindableLayout.ItemTemplate>

                        <DataTemplate
                            x:DataType="vm:WorkoutExerciseDraft">

                            <!-- Card -->
                            <Border
                                Style="{StaticResource Card}">

                                <VerticalStackLayout
                                    Spacing="10">

                                    <!-- Header with order and remove buttons -->
                                    <Grid
                                        ColumnDefinitions="*,Auto,Auto,Auto"
                                        ColumnSpacing="5">

                                        <Label
                                            Grid.Column="0"
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Exercise.Title}"
                                            VerticalOptions="Center"/>

                                        <Button
                                            Grid.Column="1"
                                            BackgroundColor="Transparent"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CreateWorkoutViewModel}}, Path=MoveUpCommand}"
                                            CommandParameter="{Binding .}"
                                            HeightRequest="30"
                                            Padding="0"
                                            Text="▲"
                                            TextColor="Black"
                                            WidthRequest="30"/>

                                        <Button
                                            Grid.Column="2"
                                            BackgroundColor="Transparent"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CreateWorkoutViewModel}}, Path=MoveDownCommand}"
                                            CommandParameter="{Binding .}"
                                            HeightRequest="30"
                                            Padding="0"
                                            Text="▼"
                                            TextColor="Black"
                                            WidthRequest="30"/>

                                        <Button
                                            Grid.Column="3"
                                            BackgroundColor="Transparent"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CreateWorkoutViewModel}}, Path=RemoveItemCommand}"
                                            CommandParameter="{Binding .}"
                                            HeightRequest="30"
                                            Padding="0"
                                            Text="✕"
                                            TextColor="Red"
                                            WidthRequest="30"/>

                                    </Grid>

                                    <!-- Sets and reps -->
                                    <Grid
                                        ColumnDefinitions="Auto,*,Auto,*"
                                        ColumnSpacing="10"
                                        IsVisible="{Binding IsNotTimed}">

                                        <Label
                                            Grid.Column="0"
                                            Text="Sets"
                                            VerticalOptions="Center"/>

                                        <Entry
                                            Grid.Column="1"
                                            HorizontalTextAlignment="Center"
                                            Keyboard="Numeric"
                                            MaxLength="2"
                                            Text="{Binding SetsText}"/>

                                        <Label
                                            Grid.Column="2"
                                            Text="Reps"
                                            VerticalOptions="Center"/>

                                        <Entry
                                            Grid.Column="3"
                                            HorizontalTextAlignment="Center"
                                            Keyboard="Numeric"
                                            MaxLength="3"
                                            Text="{Binding RepsText}"/>

                                    </Grid>

                                    <!-- Duration -->
                                    <Grid
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="10"
                                        IsVisible="{Binding IsTimed}">

                                        <Label
                                            Grid.Column="0"
                                            Text="Minutes"
                                            VerticalOptions="Center"/>

                                        <Entry
                                            Grid.Column="1"
                                            HorizontalTextAlignment="Center"
                                            Keyboard="Numeric"
                                            MaxLength="3"
                                            Text="{Binding DurationText}"/>

                                    </Grid>

                                </VerticalStackLayout>

                            </Border>

                        </DataTemplate>

                    </BindableLayout.ItemTemplate>

                </VerticalStackLayout>

                <Button
                    Command="{Binding AddExercisesCommand}"
                    Text="Add Exercises"/>

            </VerticalStackLayout>

            <!-- Community visibility -->
            <VerticalStackLayout>

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="10"
                    Margin="0,-15">

                    <Label
                        Grid.Column="0"
                        FontSize="14"
                        Text="Share with the PUSH community"
                        VerticalOptions="Center"/>

                    <Switch
                        Grid.Column="1"
                        IsToggled="{Binding IsPublic}"
                        VerticalOptions="Center"/>

                </Grid>

            </VerticalStackLayout>
            
            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Text="{Binding ErrorMessage}"
                TextColor="Red"/>

            <!-- Buttons -->
            <VerticalStackLayout
                Margin="0,5,0,0"
                Spacing="10">

                <Button
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Text="{Binding SaveButtonText}"/>

                <Button
                    Command="{Binding CancelCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Text="Cancel"/>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>