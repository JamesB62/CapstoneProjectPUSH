<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Workouts"
             x:Class="CapstoneProjectPUSH.Views.Workouts.CreateWorkoutPage"
             x:DataType="vm:CreateWorkoutViewModel"
             Title="{Binding PageTitle}">

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30,20,30,20"
            Spacing="20">

            <!-- Title -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Title"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Entry
                        MaxLength="100"
                        Placeholder="Enter a title here"
                        SemanticProperties.Hint="Workout title"
                        Text="{Binding WorkoutTitle}"/>

                </Border>

            </VerticalStackLayout>

            <!-- Category -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Category"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Picker
                        ItemDisplayBinding="{Binding Title, x:DataType=models:Category}"
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory}"
                        SemanticProperties.Hint="Category"
                        Title="Choose a category"/>

                </Border>

            </VerticalStackLayout>

            <!-- Exercises -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Exercises"/>

                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding Items}"
                    Spacing="15">

                    <!-- Empty view -->
                    <BindableLayout.EmptyView>

                        <Grid
                            HeightRequest="100">

                            <VerticalStackLayout
                                HorizontalOptions="Center"
                                Spacing="5"
                                VerticalOptions="Center">

                                <Label
                                    Style="{StaticResource EmptyLabel}"
                                    Text="No exercises added yet."/>

                                <Label
                                    Style="{StaticResource EmptyLabel}"
                                    Text="Tap Add Exercises to pick some."/>

                            </VerticalStackLayout>

                        </Grid>

                    </BindableLayout.EmptyView>

                    <!-- Item template -->
                    <BindableLayout.ItemTemplate>

                        <DataTemplate
                            x:DataType="vm:WorkoutExerciseDraft">

                            <!-- Card -->
                            <Border
                                Style="{StaticResource Card}">

                                <VerticalStackLayout
                                    Spacing="10">

                                    <!-- Header with order and remove buttons -->
                                    <Grid
                                        ColumnDefinitions="*,Auto,Auto,Auto"
                                        ColumnSpacing="0">

                                        <Label
                                            Grid.Column="0"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="2"
                                            Style="{StaticResource CardTitle}"
                                            Text="{Binding Exercise.Title}"
                                            VerticalOptions="Center"/>

                                        <Button
                                            Grid.Column="1"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CreateWorkoutViewModel}}, Path=MoveUpCommand}"
                                            CommandParameter="{Binding .}"
                                            SemanticProperties.Description="{Binding Exercise.Title, StringFormat='Move {0} up'}"
                                            Style="{StaticResource IconButton}"
                                            Text="▲"/>

                                        <Button
                                            Grid.Column="2"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CreateWorkoutViewModel}}, Path=MoveDownCommand}"
                                            CommandParameter="{Binding .}"
                                            SemanticProperties.Description="{Binding Exercise.Title, StringFormat='Move {0} down'}"
                                            Style="{StaticResource IconButton}"
                                            Text="▼"/>

                                        <Button
                                            Grid.Column="3"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CreateWorkoutViewModel}}, Path=RemoveItemCommand}"
                                            CommandParameter="{Binding .}"
                                            SemanticProperties.Description="{Binding Exercise.Title, StringFormat='Remove {0}'}"
                                            Style="{StaticResource IconButton}"
                                            Text="✕"
                                            TextColor="{StaticResource Error}"/>

                                    </Grid>

                                    <!-- Sets and reps -->
                                    <Grid
                                        ColumnDefinitions="Auto,*,Auto,*"
                                        ColumnSpacing="10"
                                        IsVisible="{Binding IsNotTimed}">

                                        <Label
                                            Grid.Column="0"
                                            AutomationProperties.IsInAccessibleTree="False"
                                            Style="{StaticResource CardBody}"
                                            Text="Sets"
                                            VerticalOptions="Center"/>

                                        <Border
                                            Grid.Column="1"
                                            Style="{StaticResource InputFrame}">

                                            <Entry
                                                HorizontalTextAlignment="Center"
                                                Keyboard="Numeric"
                                                MaxLength="2"
                                                SemanticProperties.Hint="{Binding Exercise.Title, StringFormat='Sets for {0}'}"
                                                Text="{Binding SetsText}"/>

                                        </Border>

                                        <Label
                                            Grid.Column="2"
                                            AutomationProperties.IsInAccessibleTree="False"
                                            Style="{StaticResource CardBody}"
                                            Text="Reps"
                                            VerticalOptions="Center"/>

                                        <Border
                                            Grid.Column="3"
                                            Style="{StaticResource InputFrame}">

                                            <Entry
                                                HorizontalTextAlignment="Center"
                                                Keyboard="Numeric"
                                                MaxLength="2"
                                                SemanticProperties.Hint="{Binding Exercise.Title, StringFormat='Reps for {0}'}"
                                                Text="{Binding RepsText}"/>

                                        </Border>

                                    </Grid>

                                    <!-- Duration -->
                                    <Grid
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="10"
                                        IsVisible="{Binding IsTimed}">

                                        <Label
                                            Grid.Column="0"
                                            AutomationProperties.IsInAccessibleTree="False"
                                            Style="{StaticResource CardBody}"
                                            Text="Minutes"
                                            VerticalOptions="Center"/>

                                        <Border
                                            Grid.Column="1"
                                            Style="{StaticResource InputFrame}">

                                            <Entry
                                                HorizontalTextAlignment="Center"
                                                Keyboard="Numeric"
                                                MaxLength="3"
                                                SemanticProperties.Hint="{Binding Exercise.Title, StringFormat='Minutes for {0}'}"
                                                Text="{Binding DurationText}"/>

                                        </Border>

                                    </Grid>

                                </VerticalStackLayout>

                            </Border>

                        </DataTemplate>

                    </BindableLayout.ItemTemplate>

                </VerticalStackLayout>

                <Button
                    Command="{Binding AddExercisesCommand}"
                    Margin="0,5,0,0"
                    Style="{StaticResource SecondaryButton}"
                    Text="Add Exercises"/>

            </VerticalStackLayout>

            <!-- Community visibility -->
            <VerticalStackLayout
                Spacing="10">

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="10">

                    <Label
                        Grid.Column="0"
                        AutomationProperties.IsInAccessibleTree="False"
                        Style="{StaticResource FieldLabel}"
                        Text="Share with the PUSH community"
                        VerticalOptions="Center"/>

                    <Switch
                        Grid.Column="1"
                        IsToggled="{Binding IsPublic}"
                        SemanticProperties.Description="Share with the PUSH community"
                        SemanticProperties.Hint="Public workouts appear on the Community Workouts page"
                        VerticalOptions="Center"/>

                </Grid>

                <Label
                    AutomationProperties.IsInAccessibleTree="False"
                    Style="{StaticResource HintLabel}"
                    Text="Public workouts appear in the Community Workouts page for all registered users."/>

            </VerticalStackLayout>
            
            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"/>

            <!-- Buttons -->
            <VerticalStackLayout
                Spacing="10">

                <Button
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Text="{Binding SaveButtonText}"/>

                <Button
                    Command="{Binding CancelCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource SecondaryButton}"
                    Text="Cancel"/>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>