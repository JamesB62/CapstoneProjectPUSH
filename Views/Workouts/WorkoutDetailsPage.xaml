<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Workouts"
             x:Class="CapstoneProjectPUSH.Views.Workouts.WorkoutDetailsPage"
             x:DataType="vm:WorkoutDetailsViewModel"
             Title="PUSH Workout Details">

    <Grid
        IsVisible="{Binding IsNotBusy}"
        RowDefinitions="*,Auto">

        <ScrollView
            Grid.Row="0">

            <VerticalStackLayout
                MaximumWidthRequest="500"
                Padding="30,15"
                Spacing="15">

                <!-- Title and category -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="15">

                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Grid.Column="0"
                        LineBreakMode="WordWrap"
                        Text="{Binding Workout.Title}"
                        VerticalOptions="Center"/>

                    <Border
                        Grid.Column="1"
                        Style="{StaticResource Pill}"
                        VerticalOptions="Start">

                        <Label
                            FontSize="12"
                            Text="{Binding Workout.CategoryTitle}"/>

                    </Border>

                </Grid>

                <!-- Exercises -->
                <Label
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="Exercises"/>

                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding Exercises}"
                    Spacing="10">

                    <BindableLayout.EmptyView>

                        <Grid
                            HeightRequest="100"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">

                            <Label
                                FontAttributes="Italic"
                                HorizontalTextAlignment="Center"
                                Text="No exercises found."/>

                        </Grid>

                    </BindableLayout.EmptyView>

                    <BindableLayout.ItemTemplate>

                        <DataTemplate
                            x:DataType="models:WorkoutExercise">

                            <Border
                                Style="{StaticResource Card}">

                                <Grid
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="15">

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        Grid.Column="0"
                                        Text="{Binding DisplayNumber}"
                                        VerticalOptions="Center"/>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="5">

                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding ExerciseTitle}"/>

                                        <Label
                                            FontAttributes="Italic"
                                            FontSize="12"
                                            Text="{Binding TargetText}"/>

                                    </VerticalStackLayout>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </BindableLayout.ItemTemplate>

                </VerticalStackLayout>

                <!-- Notes -->
                <Label
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="Notes"/>

                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding Notes}"
                    Spacing="10">

                    <BindableLayout.EmptyView>

                        <Grid
                            HeightRequest="100"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">

                            <Label
                                FontAttributes="Italic"
                                HorizontalTextAlignment="Center"
                                Text="No notes found."/>

                        </Grid>

                    </BindableLayout.EmptyView>

                    <BindableLayout.ItemTemplate>

                        <DataTemplate
                            x:DataType="models:Note">

                            <Border
                                Style="{StaticResource Card}">

                                <VerticalStackLayout
                                    Spacing="10">

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding Title}"/>

                                    <Label
                                        Text="{Binding Content}"/>

                                    <Label
                                        FontAttributes="Italic"
                                        FontSize="12"
                                        Text="{Binding DateTimeCreated, StringFormat='Date created: {0:d MMMM yyyy}'}"/>

                                </VerticalStackLayout>

                            </Border>

                        </DataTemplate>

                    </BindableLayout.ItemTemplate>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </ScrollView>

        <Button
            Command="{Binding StartWorkoutCommand}"
            Grid.Row="1"
            Margin="30,0,30,15"
            MaximumWidthRequest="500"
            Text="Start Workout"/>

    </Grid>

</ContentPage>