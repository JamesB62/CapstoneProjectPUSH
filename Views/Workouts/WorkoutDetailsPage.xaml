<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Workouts"
             x:Class="CapstoneProjectPUSH.Views.Workouts.WorkoutDetailsPage"
             x:DataType="vm:WorkoutDetailsViewModel"
             Title="PUSH Workout Details">

    <Grid
        RowDefinitions="*,Auto">

        <ScrollView
            Grid.Row="0">

            <VerticalStackLayout
                MaximumWidthRequest="500"
                Padding="30,15"
                Spacing="15">

                <!-- Title and category -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="15">

                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Grid.Column="0"
                        LineBreakMode="WordWrap"
                        Text="{Binding Workout.Title}"
                        VerticalOptions="Center"/>

                    <Border
                        Grid.Column="1"
                        Style="{StaticResource Pill}"
                        VerticalOptions="Start">

                        <Label
                            FontSize="12"
                            Text="{Binding Workout.CategoryTitle}"/>

                    </Border>

                </Grid>

                <!-- Author -->
                <Label
                    FontAttributes="Italic"
                    FontSize="12"
                    IsVisible="{Binding IsNotOwner}"
                    Text="{Binding Workout.UserDisplayName, StringFormat='Created by: {0}'}"/>
                
                <!-- ADD PRIVACY LABEL -->
                
                <!-- Exercises -->
                <Label
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="Exercises"/>

                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding Exercises}"
                    Spacing="10">

                    <BindableLayout.EmptyView>

                        <Grid
                            HeightRequest="100"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">

                            <Label
                                FontAttributes="Italic"
                                HorizontalTextAlignment="Center"
                                Text="No exercises found."/>

                        </Grid>

                    </BindableLayout.EmptyView>

                    <BindableLayout.ItemTemplate>

                        <DataTemplate
                            x:DataType="models:WorkoutExercise">

                            <Border
                                Style="{StaticResource Card}">

                                <Grid
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="15">

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        Grid.Column="0"
                                        Text="{Binding DisplayNumber}"
                                        VerticalOptions="Center"/>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="5">

                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding ExerciseTitle}"/>

                                        <Label
                                            FontAttributes="Italic"
                                            FontSize="12"
                                            Text="{Binding TargetText}"/>

                                    </VerticalStackLayout>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </BindableLayout.ItemTemplate>

                </VerticalStackLayout>

                <!-- Notes -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="15">

                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        Grid.Column="0"
                        Text="Notes"
                        VerticalOptions="Center"/>

                    <Button
                        Command="{Binding AddNoteCommand}"
                        Grid.Column="1"
                        Text="Add Note"/>

                </Grid>

                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding Notes}"
                    Spacing="10">

                    <BindableLayout.EmptyView>

                        <Grid
                            HeightRequest="100"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">

                            <Label
                                FontAttributes="Italic"
                                HorizontalTextAlignment="Center"
                                Text="No notes found."/>

                        </Grid>

                    </BindableLayout.EmptyView>

                    <BindableLayout.ItemTemplate>

                        <DataTemplate
                            x:DataType="models:Note">

                            <Border
                                Style="{StaticResource Card}">

                                <VerticalStackLayout
                                    Spacing="10">

                                    <Grid
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="15">

                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            Grid.Column="0"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Title}"
                                            VerticalOptions="Center"/>

                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="5">

                                            <Border
                                                Grid.Column="1"
                                                HorizontalOptions="End"
                                                Style="{StaticResource Pill}"
                                                VerticalOptions="Start">

                                                <Label
                                                    FontSize="12"
                                                    Text="Private"/>

                                            </Border>

                                        </VerticalStackLayout>

                                    </Grid>

                                    <Label
                                        Text="{Binding Content}"/>

                                    <Label
                                        FontAttributes="Italic"
                                        FontSize="12"
                                        Text="{Binding DateTimeCreated, StringFormat='Date created: {0:d MMMM yyyy}'}"/>

                                    <HorizontalStackLayout
                                        HorizontalOptions="End"
                                        Spacing="10">

                                        <Button
                                            Command="{Binding EditNoteCommand, Source={RelativeSource AncestorType={x:Type vm:WorkoutDetailsViewModel}}, x:DataType=vm:WorkoutDetailsViewModel}"
                                            CommandParameter="{Binding .}"
                                            Text="Edit"/>

                                        <Button
                                            Command="{Binding DeleteNoteCommand, Source={RelativeSource AncestorType={x:Type vm:WorkoutDetailsViewModel}}, x:DataType=vm:WorkoutDetailsViewModel}"
                                            CommandParameter="{Binding .}"
                                            Text="Delete"/>

                                    </HorizontalStackLayout>

                                </VerticalStackLayout>

                            </Border>

                        </DataTemplate>

                    </BindableLayout.ItemTemplate>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </ScrollView>

        <VerticalStackLayout
            Grid.Row="1"
            Margin="30,0,30,15"
            Spacing="10"
            MaximumWidthRequest="500">

            <Button
                Command="{Binding EditWorkoutCommand}"
                IsVisible="{Binding IsOwner}"
                Text="Edit"/>

            <Button
                Command="{Binding StartWorkoutCommand}"
                Text="Start Workout"/>

        </VerticalStackLayout>
        
    </Grid>

</ContentPage>