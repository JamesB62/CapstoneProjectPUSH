<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Workouts"
             x:Class="CapstoneProjectPUSH.Views.Workouts.WorkoutDetailsPage"
             x:DataType="vm:WorkoutDetailsViewModel"
             Title="PUSH Workout Details">

    <ContentPage.ToolbarItems>

        <ToolbarItem
            x:Name="EditToolbarItem"
            Command="{Binding EditWorkoutCommand}"
            Order="Secondary"
            Text="Edit Workout"/>

        <ToolbarItem
            x:Name="DeleteToolbarItem"
            Command="{Binding DeleteWorkoutCommand}"
            Order="Secondary"
            Text="Delete Workout"/>

        <ToolbarItem
            x:Name="ReportToolbarItem"
            Command="{Binding ReportWorkoutCommand}"
            Order="Secondary"
            Text="Report Workout"/>
        
    </ContentPage.ToolbarItems>

    <Grid
        RowDefinitions="*,Auto">

        <!-- Scrolling content -->
        <ScrollView
            Grid.Row="0">

            <VerticalStackLayout
                MaximumWidthRequest="500"
                Padding="30,20,30,20"
                Spacing="20">

                <!-- Title, category and favourite -->
                <Grid
                    ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="10">

                    <Label
                        Grid.Column="0"
                        Style="{StaticResource DetailTitle}"
                        Text="{Binding Workout.Title}"/>

                    <Border
                        Grid.Column="1"
                        Style="{StaticResource Pill}"
                        VerticalOptions="Start">

                        <Label
                            Style="{StaticResource PillLabel}"
                            Text="{Binding Workout.CategoryTitle}"/>

                    </Border>

                    <!-- Favourite star (registered accounts only) -->
                    <Button
                        Command="{Binding ToggleFavouriteCommand}"
                        Grid.Column="2"
                        IsVisible="{Binding IsLoggedIn}"
                        SemanticProperties.Description="Add to favourites"
                        Style="{StaticResource FavouriteStar}"
                        Text="{Binding FavouriteIcon}"
                        VerticalOptions="Start">

                        <Button.Triggers>

                            <DataTrigger
                                Binding="{Binding FavouriteIcon}"
                                TargetType="Button"
                                Value="★">

                                <Setter
                                    Property="SemanticProperties.Description"
                                    Value="Remove from favourites"/>

                            </DataTrigger>

                        </Button.Triggers>

                    </Button>

                </Grid>

                <!-- Credit and privacy -->
                <VerticalStackLayout
                    Spacing="5">

                    <Label
                        IsVisible="{Binding IsNotOwner}"
                        Style="{StaticResource CardCredit}">

                        <Label.Text>

                            <MultiBinding
                                StringFormat="Created by {0} on {1:d MMM yyyy}">

                                <Binding
                                    Path="Workout.UserDisplayName"/>

                                <Binding
                                    Path="Workout.DateTimeCreated"/>

                            </MultiBinding>

                        </Label.Text>

                    </Label>

                    <Label
                        IsVisible="{Binding IsOwner}"
                        Style="{StaticResource CardCredit}"
                        Text="{Binding Workout.DateTimeCreated, StringFormat='Created on {0:d MMM yyyy}'}"/>

                    <Label
                        IsVisible="{Binding IsOwner}"
                        Style="{StaticResource CardCredit}"
                        Text="{Binding PrivacyText, StringFormat='Visibility: {0}'}"/>

                </VerticalStackLayout>

                <!-- Exercises -->
                <Label
                    Style="{StaticResource SectionHeader}"
                    Text="Exercises"/>

                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding Exercises}"
                    Spacing="15">

                    <!-- Empty view -->
                    <BindableLayout.EmptyView>

                        <Grid
                            HeightRequest="100">

                            <Label
                                HorizontalOptions="Center"
                                Style="{StaticResource EmptyLabel}"
                                Text="This workout has no exercises yet."
                                VerticalOptions="Center"/>

                        </Grid>

                    </BindableLayout.EmptyView>

                    <!-- Item template -->
                    <BindableLayout.ItemTemplate>

                        <DataTemplate
                            x:DataType="models:WorkoutExercise">

                            <Border
                                Style="{StaticResource Card}">

                                <Grid
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="15">

                                    <!-- Exercise order number -->
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        Grid.Column="0"
                                        Text="{Binding DisplayNumber}"
                                        TextColor="{StaticResource Accent}"
                                        VerticalOptions="Center"/>

                                    <!-- Title and target -->
                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="5">

                                        <Label
                                            LineBreakMode="TailTruncation"
                                            MaxLines="2"
                                            Style="{StaticResource CardTitle}"
                                            Text="{Binding ExerciseTitle}"/>

                                        <Label
                                            Style="{StaticResource CardBody}"
                                            Text="{Binding TargetText}"/>

                                    </VerticalStackLayout>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </BindableLayout.ItemTemplate>

                </VerticalStackLayout>

                <!-- Notes header, add button and swipe hint -->
                <VerticalStackLayout
                    Spacing="5">

                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="10">

                        <Label
                            Grid.Column="0"
                            Style="{StaticResource SectionHeader}"
                            Text="My Notes"
                            VerticalOptions="Center"/>

                        <Button
                            Grid.Column="1"
                            Command="{Binding AddNoteCommand}"
                            IsVisible="{Binding IsLoggedIn}"
                            Style="{StaticResource SecondaryButton}"
                            Text="Add Note"/>

                    </Grid>

                    <Label
                        IsVisible="{Binding IsLoggedIn}"
                        Style="{StaticResource HintLabel}"
                        Text="Swipe right to edit or left to delete."/>

                </VerticalStackLayout>

                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding Notes}"
                    Spacing="15">

                    <!-- Empty view -->
                    <BindableLayout.EmptyView>

                        <Grid
                            HeightRequest="100">

                            <VerticalStackLayout
                                HorizontalOptions="Center"
                                Spacing="5"
                                VerticalOptions="Center">

                                <Label
                                    Style="{StaticResource EmptyLabel}"
                                    Text="No notes for this workout yet."/>

                                <Label
                                    IsVisible="{Binding IsLoggedIn}"
                                    Style="{StaticResource EmptyLabel}"
                                    Text="Tap Add Note to create one."/>

                            </VerticalStackLayout>

                        </Grid>

                    </BindableLayout.EmptyView>

                    <!-- Item template -->
                    <BindableLayout.ItemTemplate>

                        <DataTemplate
                            x:DataType="models:Note">

                            <Border
                                Style="{StaticResource SwipeClip}">

                                <SwipeView>

                                    <!-- Swipe actions (registered accounts only) -->
                                    <SwipeView.LeftItems>

                                        <SwipeItems>

                                            <SwipeItem
                                                BackgroundColor="{StaticResource SwipeEdit}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutDetailsViewModel}}, Path=EditNoteCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutDetailsViewModel}}, Path=IsLoggedIn}"
                                                Text="Edit"/>

                                        </SwipeItems>

                                    </SwipeView.LeftItems>

                                    <SwipeView.RightItems>

                                        <SwipeItems>

                                            <SwipeItem
                                                BackgroundColor="{StaticResource SwipeDelete}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutDetailsViewModel}}, Path=DeleteNoteCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutDetailsViewModel}}, Path=IsLoggedIn}"
                                                Text="Delete"/>

                                        </SwipeItems>

                                    </SwipeView.RightItems>

                                    <!-- Card -->
                                    <Border
                                        Style="{StaticResource SwipeCard}">

                                        <VerticalStackLayout
                                            Spacing="10">

                                            <Label
                                                LineBreakMode="TailTruncation"
                                                MaxLines="2"
                                                Style="{StaticResource CardTitle}"
                                                Text="{Binding Title}"/>

                                            <Label
                                                Style="{StaticResource CardBody}"
                                                Text="{Binding Content}"/>

                                            <Label
                                                Style="{StaticResource CardCredit}"
                                                Text="{Binding DateTimeCreated, StringFormat='Created on {0:d MMM yyyy}'}"/>

                                        </VerticalStackLayout>

                                    </Border>

                                </SwipeView>

                            </Border>

                        </DataTemplate>

                    </BindableLayout.ItemTemplate>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </ScrollView>

        <VerticalStackLayout
            Grid.Row="1"
            MaximumWidthRequest="500"
            Padding="30,10,30,20"
            Spacing="10">

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"/>

            <Button
                Command="{Binding StartWorkoutCommand}"
                IsVisible="{Binding HasExercises}"
                Text="Start Workout"/>

        </VerticalStackLayout>

    </Grid>

</ContentPage>