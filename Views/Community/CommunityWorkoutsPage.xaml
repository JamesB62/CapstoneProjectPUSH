<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Community"
             x:Class="CapstoneProjectPUSH.Views.Community.CommunityWorkoutsPage"
             x:DataType="vm:CommunityWorkoutsViewModel"
             Title="PUSH Community Workouts">

    <Grid
        MaximumWidthRequest="500"
        Padding="30,20,30,0"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="20">

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="20">

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"/>

            <!-- Search bar -->
            <Border
                Style="{StaticResource InputFrame}">

                <SearchBar
                    Placeholder="Search by title, category or creator..."
                    SemanticProperties.Hint="Search community workouts"
                    Text="{Binding SearchText}"/>

            </Border>

        </VerticalStackLayout>

        <!-- Workout count -->
        <Label
            Grid.Row="1"
            Style="{StaticResource StatusLabel}"
            Text="{Binding StatusMessage}"/>

        <RefreshView
            Command="{Binding LoadWorkoutsCommand}"
            Grid.Row="2"
            IsRefreshing="{Binding IsBusy}">

            <CollectionView
                ItemsSource="{Binding Workouts}"
                SelectedItem="{Binding SelectedWorkout, Mode=TwoWay}"
                SelectionMode="Single">

                <!-- Empty view -->
                <CollectionView.EmptyView>

                    <Grid>

                        <VerticalStackLayout
                            HorizontalOptions="Center"
                            Spacing="5"
                            VerticalOptions="Center">

                            <Label
                                Style="{StaticResource EmptyLabel}"
                                Text="No workouts found."/>

                            <Label
                                Style="{StaticResource EmptyLabel}"
                                Text="Share one of yours or pull down to try again."/>

                        </VerticalStackLayout>

                    </Grid>

                </CollectionView.EmptyView>

                <!-- Items layout -->
                <CollectionView.ItemsLayout>

                    <LinearItemsLayout
                        ItemSpacing="15"
                        Orientation="Vertical"/>

                </CollectionView.ItemsLayout>

                <!-- Item template -->
                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:Workout">

                        <Border
                            Style="{StaticResource Card}">

                            <VerticalStackLayout
                                Spacing="10">

                                <!-- Title, favourite star and category pill -->
                                <Grid
                                    ColumnDefinitions="*,Auto,Auto"
                                    ColumnSpacing="10">

                                    <Label
                                        Grid.Column="0"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2"
                                        Text="{Binding Title}"
                                        Style="{StaticResource CardTitle}"
                                        VerticalOptions="Center"/>

                                    <!-- Favourite star (registered accounts only) -->
                                    <Label
                                        FontSize="16"
                                        Grid.Column="1"
                                        IsVisible="{Binding IsFavourite}"
                                        SemanticProperties.Description="Favourite"
                                        Text="★"
                                        TextColor="{StaticResource Favourite}"
                                        VerticalOptions="Start"/>

                                    <Border
                                        Grid.Column="2"
                                        Style="{StaticResource Pill}"
                                        VerticalOptions="Start">

                                        <Label
                                            Style="{StaticResource PillLabel}"
                                            Text="{Binding CategoryTitle}"/>

                                    </Border>

                                </Grid>

                                <!-- Info -->
                                <VerticalStackLayout
                                    Spacing="5">

                                    <Label
                                        Style="{StaticResource CardBody}"
                                        Text="{Binding ExerciseCountText}"/>

                                    <Label
                                        IsVisible="{Binding HasSets}"
                                        Style="{StaticResource CardBody}"
                                        Text="{Binding SetCount, StringFormat='Sets: {0}'}"/>

                                    <Label
                                        IsVisible="{Binding HasMinutes}"
                                        Style="{StaticResource CardBody}"
                                        Text="{Binding TotalMinutes, StringFormat='Time: {0} min'}"/>

                                </VerticalStackLayout>

                                <!-- Credit -->
                                <Label
                                    LineBreakMode="TailTruncation"
                                    Style="{StaticResource CardCredit}">

                                    <Label.Text>

                                        <MultiBinding
                                            StringFormat="Created by {0} on {1:d MMM yyyy}">

                                            <Binding
                                                Path="UserDisplayName"/>

                                            <Binding
                                                Path="DateTimeCreated"/>

                                        </MultiBinding>

                                    </Label.Text>

                                </Label>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>