<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Community"
             x:Class="CapstoneProjectPUSH.Views.Community.CommunityWorkoutsPage"
             x:DataType="vm:CommunityWorkoutsViewModel"
             Title="PUSH Community Workouts">

    <Grid
        MaximumWidthRequest="500"
        Padding="30,15,30,0"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="20">

        <!-- Search bar -->
        <SearchBar
            Grid.Row="0"
            Placeholder="Search by title, category or creator..."
            Text="{Binding SearchText}"/>

        <VerticalStackLayout
            Grid.Row="1"
            Spacing="15">

            <Label
                Text="{Binding StatusMessage}"/>

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Text="{Binding ErrorMessage}"
                TextColor="Red"/>

        </VerticalStackLayout>

        <RefreshView
            Command="{Binding LoadWorkoutsCommand}"
            Grid.Row="2"
            IsRefreshing="{Binding IsBusy}">

            <CollectionView
                ItemsSource="{Binding Workouts}"
                SelectedItem="{Binding SelectedWorkout, Mode=TwoWay}"
                SelectionMode="Single">

                <!-- Empty view -->
                <CollectionView.EmptyView>

                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Label
                            FontAttributes="Italic"
                            HorizontalTextAlignment="Center"
                            Text="No workouts found."/>

                        <Label
                            FontAttributes="Italic"
                            HorizontalTextAlignment="Center"
                            Text="Share one of yours or pull down to try again."/>

                    </VerticalStackLayout>

                </CollectionView.EmptyView>

                <!-- Item layout -->
                <CollectionView.ItemsLayout>

                    <LinearItemsLayout
                        ItemSpacing="10"
                        Orientation="Vertical"/>

                </CollectionView.ItemsLayout>

                <!-- Item template -->
                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:Workout">

                        <Border
                            Style="{StaticResource Card}">

                            <VerticalStackLayout
                                Spacing="10">

                                <Grid
                                    ColumnDefinitions="*,Auto,Auto"
                                    ColumnSpacing="10">

                                    <Label
                                        Grid.Column="0"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding Title}"
                                        VerticalOptions="Center"/>

                                    <Border
                                        Grid.Column="1"
                                        Style="{StaticResource Pill}">

                                        <Label
                                            FontSize="12"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding CategoryTitle}"/>

                                    </Border>

                                    <!-- Favourite star (registered accounts only) -->
                                    <Label
                                        FontSize="21"
                                        Grid.Column="2"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:CommunityWorkoutsViewModel}}, Path=IsLoggedIn}"
                                        Margin="0,-4,0,0"
                                        Text="{Binding FavouriteIcon}"
                                        TextColor="Goldenrod"
                                        VerticalOptions="Center"/>

                                </Grid>

                                <!-- Info -->
                                <VerticalStackLayout
                                    Spacing="3">

                                    <Label
                                        Text="{Binding ExerciseCount, StringFormat='• Exercises: {0}'}"/>

                                    <Label
                                        IsVisible="{Binding HasSets}"
                                        Text="{Binding SetCount, StringFormat='• Sets: {0}'}"/>

                                    <Label
                                        IsVisible="{Binding HasMinutes}"
                                        Text="{Binding TotalMinutes, StringFormat='• Time: {0} min'}"/>

                                </VerticalStackLayout>

                                <!-- Credit -->
                                <Label
                                    FontAttributes="Italic"
                                    FontSize="12"
                                    LineBreakMode="TailTruncation">

                                    <Label.Text>

                                        <MultiBinding
                                            StringFormat="Created by {0} on {1:d MMM yyyy}">

                                            <Binding
                                                Path="UserDisplayName"/>

                                            <Binding
                                                Path="DateTimeCreated"/>

                                        </MultiBinding>

                                    </Label.Text>

                                </Label>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>