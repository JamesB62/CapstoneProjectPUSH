<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CapstoneProjectPUSH.Views.Controls.MainNavBar">

    <Grid
        Padding="10,8"
        BackgroundColor="#D1D5DB"
        ColumnDefinitions="*,*,*,*,*"
        ColumnSpacing="6">

        <Button
            x:Name="HomeButton"
            Grid.Column="0"
            Padding="0"
            Clicked="OnHomeClicked"
            CornerRadius="10"
            FontSize="11"
            Text="Home"/>

        <Button
            x:Name="WorkoutsButton"
            Grid.Column="1"
            Padding="0"
            Clicked="OnWorkoutsClicked"
            CornerRadius="10"
            FontSize="11"
            Text="Workouts"/>

        <Button
            x:Name="StatsButton"
            Grid.Column="2"
            Padding="0"
            Clicked="OnStatsClicked"
            CornerRadius="10"
            FontSize="11"
            Text="Stats"/>

        <Button
            x:Name="TrainersButton"
            Grid.Column="3"
            Padding="0"
            Clicked="OnTrainersClicked"
            CornerRadius="10"
            FontSize="11"
            Text="Trainers"/>

        <Button
            x:Name="ProfileButton"
            Grid.Column="4"
            Padding="0"
            Clicked="OnProfileClicked"
            CornerRadius="10"
            FontSize="11"
            Text="Profile"/>

    </Grid>

</ContentView>
