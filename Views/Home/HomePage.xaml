<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Home"
             x:Class="CapstoneProjectPUSH.Views.Home.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="PUSH Home">

    <ContentPage.ToolbarItems>

        <ToolbarItem
            x:Name="AddArticleToolbarItem"
            Command="{Binding AddArticleCommand}"
            Order="Secondary"
            Text="Add Article"/>

    </ContentPage.ToolbarItems>

    <Grid
        MaximumWidthRequest="500"
        Padding="30,20,30,0"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="20">

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="20">

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"/>

            <!-- My workouts -->
            <Label
                Style="{StaticResource SectionHeader}"
                Text="My Workouts"/>

        </VerticalStackLayout>

        <!-- Collection view -->
        <CollectionView
            Grid.Row="1"
            HeightRequest="150"
            ItemsSource="{Binding FeaturedWorkouts}"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedWorkout, Mode=TwoWay}">

            <!-- Empty view -->
            <CollectionView.EmptyView>

                <Grid>

                    <Label
                        HorizontalOptions="Center"
                        Style="{StaticResource EmptyLabel}"
                        Text="No workouts yet."
                        VerticalOptions="Center"/>

                </Grid>

            </CollectionView.EmptyView>

            <!-- Items layout -->
            <CollectionView.ItemsLayout>

                <LinearItemsLayout
                    ItemSpacing="15"
                    Orientation="Horizontal"/>

            </CollectionView.ItemsLayout>

            <!-- Item template -->
            <CollectionView.ItemTemplate>

                <DataTemplate
                    x:DataType="models:Workout">

                    <Border
                        Style="{StaticResource Card}"
                        WidthRequest="175">

                        <Grid
                            RowDefinitions="Auto,Auto,*,Auto"
                            RowSpacing="5">

                            <!-- Title and favourite star -->
                            <Grid
                                Grid.Row="0"
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="5">

                                <Label
                                    Grid.Column="0"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2"
                                    Style="{StaticResource CardTitle}"
                                    Text="{Binding Title}"/>

                                <Label
                                    Grid.Column="1"
                                    IsVisible="{Binding IsFavourite}"
                                    SemanticProperties.Description="Favourite"
                                    Text="★"
                                    TextColor="{StaticResource Favourite}"
                                    VerticalOptions="Start"/>

                            </Grid>

                            <!-- Exercise count -->
                            <Label
                                Grid.Row="1"
                                Style="{StaticResource StatusLabel}"
                                FontSize="12"
                                Text="{Binding ExerciseCountText}"/>

                            <!-- Category pill -->
                            <Border
                                Grid.Row="3"
                                HorizontalOptions="Start"
                                Style="{StaticResource Pill}">

                                <Label
                                    Style="{StaticResource PillLabel}"
                                    Text="{Binding CategoryTitle}"/>

                            </Border>

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Articles -->
        <VerticalStackLayout
            Grid.Row="2"
            Spacing="5">

            <Label
                Style="{StaticResource SectionHeader}"
                Text="Articles"/>

            <Label
                IsVisible="{Binding IsCurrentUserAdmin}"
                Style="{StaticResource HintLabel}"
                Text="Swipe right to edit or left to delete."/>

        </VerticalStackLayout>

        <!-- Collection view -->
        <CollectionView
            Grid.Row="3"
            ItemsSource="{Binding FeaturedArticles}"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedArticle, Mode=TwoWay}">

            <!-- Empty view -->
            <CollectionView.EmptyView>

                <Grid>

                    <Label
                        HorizontalOptions="Center"
                        Style="{StaticResource EmptyLabel}"
                        Text="No articles available."
                        VerticalOptions="Center"/>

                </Grid>

            </CollectionView.EmptyView>

            <!-- Items layout -->
            <CollectionView.ItemsLayout>

                <LinearItemsLayout
                    ItemSpacing="15"
                    Orientation="Vertical"/>

            </CollectionView.ItemsLayout>

            <!-- Item template -->
            <CollectionView.ItemTemplate>

                <DataTemplate
                    x:DataType="models:Article">

                    <Border
                        Style="{StaticResource SwipeClip}">
                    
                        <SwipeView>

                            <!-- Swipe actions (admins only) -->
                            <SwipeView.LeftItems>

                                <SwipeItems>

                                    <SwipeItem
                                        BackgroundColor="{StaticResource SwipeEdit}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=EditArticleCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=IsCurrentUserAdmin}"
                                        Text="Edit"/>

                                </SwipeItems>

                            </SwipeView.LeftItems>

                            <SwipeView.RightItems>

                                <SwipeItems>

                                    <SwipeItem
                                        BackgroundColor="{StaticResource SwipeDelete}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=DeleteArticleCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=IsCurrentUserAdmin}"
                                        Text="Delete"/>

                                </SwipeItems>

                            </SwipeView.RightItems>

                            <Border
                                Style="{StaticResource SwipeCard}">

                                <VerticalStackLayout
                                    Spacing="10">

                                    <Grid
                                        ColumnDefinitions="*,auto"
                                        ColumnSpacing="10">

                                        <!-- Title and category pill -->
                                        <Label
                                            Grid.Column="0"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="2"
                                            Style="{StaticResource CardTitle}"
                                            Text="{Binding Title}"
                                            VerticalOptions="Center"/>

                                        <Border
                                            Grid.Column="1"
                                            Style="{StaticResource Pill}"
                                            VerticalOptions="Start">

                                            <Label
                                                Style="{StaticResource PillLabel}"
                                                Text="{Binding Topic}"/>

                                        </Border>

                                    </Grid>

                                    <!-- Content preview -->
                                    <Label
                                        AutomationProperties.IsInAccessibleTree="False"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="3"
                                        Style="{StaticResource CardBody}"
                                        Text="{Binding Content}"/>

                                    <!-- Credit -->
                                    <Label
                                        LineBreakMode="TailTruncation"
                                        Style="{StaticResource CardCredit}">

                                        <Label.Text>

                                            <MultiBinding
                                                StringFormat="Written by {0} on {1:d MMM yyyy}">

                                                <Binding
                                                    Path="Citation"/>
                                            
                                                <Binding
                                                    Path="DateTimePublished"/>

                                            </MultiBinding>

                                        </Label.Text>

                                    </Label>

                                </VerticalStackLayout>

                            </Border>

                        </SwipeView>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>