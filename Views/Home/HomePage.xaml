<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Home"
             x:Class="CapstoneProjectPUSH.Views.Home.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="PUSH Home">

    <Grid
        MaximumWidthRequest="500"
        Padding="30,15"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="15">

        <Border IsVisible="{Binding IsGuest}" Padding="15" StrokeShape="RoundRectangle 10">
            <VerticalStackLayout Spacing="10">
                <Label Text="You're browsing as a guest. Log in to see and create your own workouts." />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="Log In" Command="{Binding GoToLoginCommand}" />
                    <Button Grid.Column="1" Text="Register" Command="{Binding GoToRegisterCommand}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Label
            Grid.Row="0"
            FontAttributes="Bold"
            FontSize="16"
            Text="Your Workouts"
            IsVisible="{Binding IsLoggedIn}"/>

        <CollectionView
            Grid.Row="1"
            HeightRequest="150"
            ItemsSource="{Binding FeaturedWorkouts}"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedWorkout, Mode=TwoWay}"
            IsVisible="{Binding IsLoggedIn}">

            <!-- Empty view -->
            <CollectionView.EmptyView>

                <Label
                    FontAttributes="Italic"
                    HorizontalTextAlignment="Center"
                    Text="No workouts found."
                    VerticalTextAlignment="Center"/>

            </CollectionView.EmptyView>

            <!-- Item layout -->
            <CollectionView.ItemsLayout>
                
                <LinearItemsLayout
                    ItemSpacing="10"
                    Orientation="Horizontal"/>
                
            </CollectionView.ItemsLayout>

            <!-- Item template -->
            <CollectionView.ItemTemplate>
                
                <DataTemplate
                    x:DataType="models:Workout">

                    <Border
                        Style="{StaticResource Card}"
                        WidthRequest="150">

                        <VerticalStackLayout
                            Spacing="10"
                            VerticalOptions="Center">

                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                Text="{Binding Title}"/>

                            <Border
                                HorizontalOptions="Center"
                                Style="{StaticResource Pill}">

                                <Label
                                    FontSize="12"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding CategoryTitle}"/>

                            </Border>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
                
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Featured Articles -->
        <Label
            Grid.Row="2"
            FontAttributes="Bold"
            FontSize="16"
            Text="Featured Articles"/>

        <CollectionView
            Grid.Row="3"
            ItemsSource="{Binding FeaturedArticles}"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedArticle, Mode=TwoWay}">

            <CollectionView.EmptyView>
                
                <Label
                    FontAttributes="Italic"
                    HorizontalTextAlignment="Center"
                    Text="No articles available."/>
                
            </CollectionView.EmptyView>

            <CollectionView.ItemsLayout>
                
                <LinearItemsLayout
                    ItemSpacing="10"
                    Orientation="Vertical"/>
                
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                
                <DataTemplate
                    x:DataType="models:Article">

                    <Border
                        Style="{StaticResource Card}">

                        <VerticalStackLayout
                            Spacing="10">

                            <Grid
                                ColumnDefinitions="*,auto"
                                ColumnSpacing="10">

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Grid.Column="0"
                                    LineBreakMode="WordWrap"
                                    MaxLines="2"
                                    Text="{Binding Title}"
                                    VerticalOptions="Center"/>

                                <Border
                                    Grid.Column="1"
                                    Style="{StaticResource Pill}">

                                    <Label
                                        FontSize="12"
                                        Text="{Binding CategoryTitle}"/>

                                </Border>

                            </Grid>

                            <VerticalStackLayout
                                Spacing="3">

                                <Label
                                    FontAttributes="Italic"
                                    FontSize="12"
                                    Text="{Binding ReadingTime, StringFormat='• Reading time: {0}min'}"/>

                                <Label
                                    FontAttributes="Italic"
                                    FontSize="12"
                                    Text="{Binding Citation, StringFormat='• Written by: {0}'}"/>

                                <Label
                                    FontAttributes="Italic"
                                    FontSize="12"
                                    Text="{Binding DateTimePublished, StringFormat='• Date published: {0:d MMMM yyyy}'}"/>

                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
                
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
    
</ContentPage>