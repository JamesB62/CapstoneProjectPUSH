<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Home"
             x:Class="CapstoneProjectPUSH.Views.Home.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="PUSH Home">

    <ContentPage.ToolbarItems>

        <ToolbarItem
            x:Name="AddArticleToolbarItem"
            Command="{Binding AddArticleCommand}"
            Text="+ Add"/>

    </ContentPage.ToolbarItems>

    <Grid
        MaximumWidthRequest="500"
        Padding="30,15,30,0"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="20">

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="15">

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Text="{Binding ErrorMessage}"
                TextColor="Red"/>

            <!-- Featured workouts -->
            <Label
                FontAttributes="Bold"
                FontSize="16"
                Text="Your Workouts"/>

        </VerticalStackLayout>

        <CollectionView
            Grid.Row="1"
            HeightRequest="150"
            ItemsSource="{Binding FeaturedWorkouts}"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedWorkout, Mode=TwoWay}">

            <!-- Empty view -->
            <CollectionView.EmptyView>

                <VerticalStackLayout
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Label
                        FontAttributes="Italic"
                        HorizontalTextAlignment="Center"
                        Text="No workouts yet."/>

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <!-- Item layout -->
            <CollectionView.ItemsLayout>
                
                <LinearItemsLayout
                    ItemSpacing="10"
                    Orientation="Horizontal"/>
                
            </CollectionView.ItemsLayout>

            <!-- Item template -->
            <CollectionView.ItemTemplate>
                
                <DataTemplate
                    x:DataType="models:Workout">

                    <Border
                        Style="{StaticResource Card}"
                        WidthRequest="150">

                        <VerticalStackLayout
                            Spacing="10"
                            VerticalOptions="Center">

                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                Text="{Binding Title}"/>

                            <Border
                                HorizontalOptions="Center"
                                Style="{StaticResource Pill}">

                                <Label
                                    FontSize="12"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding CategoryTitle}"/>

                            </Border>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
                
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Articles -->
        <Label
            Grid.Row="2"
            FontAttributes="Bold"
            FontSize="16"
            Text="Articles"/>

        <CollectionView
            Grid.Row="3"
            ItemsSource="{Binding FeaturedArticles}"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedArticle, Mode=TwoWay}">

            <!-- Empty view -->
            <CollectionView.EmptyView>
                
                <Label
                    FontAttributes="Italic"
                    HorizontalTextAlignment="Center"
                    Text="No articles available."/>
                
            </CollectionView.EmptyView>

            <!-- Item layout -->
            <CollectionView.ItemsLayout>
                
                <LinearItemsLayout
                    ItemSpacing="10"
                    Orientation="Vertical"/>
                
            </CollectionView.ItemsLayout>

            <!-- Item template -->
            <CollectionView.ItemTemplate>
                
                <DataTemplate
                    x:DataType="models:Article">

                    <SwipeView>

                        <!-- Swipe actions (admins only) -->
                        <SwipeView.LeftItems>

                            <SwipeItems>

                                <SwipeItem
                                    BackgroundColor="#6B7280"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=EditArticleCommand}"
                                    CommandParameter="{Binding .}"
                                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=IsCurrentUserAdmin}"
                                    Text="Edit"/>

                            </SwipeItems>

                        </SwipeView.LeftItems>

                        <SwipeView.RightItems>

                            <SwipeItems>

                                <SwipeItem
                                    BackgroundColor="Red"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=DeleteArticleCommand}"
                                    CommandParameter="{Binding .}"
                                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=IsCurrentUserAdmin}"
                                    Text="Delete"/>

                            </SwipeItems>

                        </SwipeView.RightItems>

                        <Border
                            Style="{StaticResource Card}">

                            <VerticalStackLayout
                                Spacing="10">

                                <Grid
                                    ColumnDefinitions="*,auto"
                                    ColumnSpacing="10">

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        Grid.Column="0"
                                        LineBreakMode="WordWrap"
                                        MaxLines="2"
                                        Text="{Binding Title}"
                                        VerticalOptions="Center"/>

                                    <Border
                                        Grid.Column="1"
                                        Style="{StaticResource Pill}">

                                        <Label
                                            FontSize="12"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Topic}"/>

                                    </Border>

                                </Grid>

                                <VerticalStackLayout
                                    Spacing="3">

                                    <Label
                                        Text="{Binding ReadingTime, StringFormat='• Reading time: {0}min'}"/>

                                    <Label
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding Citation, StringFormat='• Written by: {0}'}"/>

                                </VerticalStackLayout>

                                <Label
                                    FontAttributes="Italic"
                                    FontSize="12"
                                    Text="{Binding DateTimePublished, StringFormat='Published on {0:d MMM yyyy}'}"/>

                            </VerticalStackLayout>

                        </Border>

                    </SwipeView>

                </DataTemplate>
                
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
    
</ContentPage>