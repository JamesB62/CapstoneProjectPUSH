<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Home"
             x:Class="CapstoneProjectPUSH.Views.Home.ArticleDetailsPage"
             x:DataType="vm:ArticleDetailsViewModel"
             Title="PUSH Article">

    <ContentPage.ToolbarItems>

        <ToolbarItem
            x:Name="EditToolbarItem"
            Command="{Binding EditArticleCommand}"
            Order="Secondary"
            Text="Edit Article"/>

        <ToolbarItem
            x:Name="DeleteToolbarItem"
            Command="{Binding DeleteArticleCommand}"
            Order="Secondary"
            Text="Delete Article"/>

    </ContentPage.ToolbarItems>

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30,20,30,20"
            Spacing="20">

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"/>

            <!-- Image (hidden from screen readers) -->
            <Border
                StrokeShape="RoundRectangle 12"
                StrokeThickness="0">

                <Image
                    Aspect="AspectFill"
                    AutomationProperties.IsInAccessibleTree="False"
                    MaximumHeightRequest="200"
                    Source="{Binding Article.Image}"/>

            </Border>

            <!-- Title, topic and info -->
            <VerticalStackLayout
                Spacing="10">

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="10">

                    <Label
                        Grid.Column="0"
                        Style="{StaticResource DetailTitle}"
                        Text="{Binding Article.Title}"/>

                    <Border
                        Grid.Column="1"
                        Style="{StaticResource Pill}"
                        VerticalOptions="Start">

                        <Label
                            Style="{StaticResource PillLabel}"
                            Text="{Binding Article.Topic}"/>

                    </Border>

                </Grid>

                <VerticalStackLayout
                    Spacing="5">

                    <Label
                        Style="{StaticResource CardCredit}"
                        Text="{Binding Article.ReadingTime, StringFormat='{0} min read'}"/>

                    <Label
                        Style="{StaticResource CardCredit}"
                        Text="{Binding Article.DateTimePublished, StringFormat='Published on {0:d MMM yyyy}'}"/>

                </VerticalStackLayout>

            </VerticalStackLayout>

            <!-- Content -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource SectionHeader}"
                    Text="Article Content"/>

                <Label
                    Style="{StaticResource LongText}"
                    Text="{Binding Article.Content}"/>

            </VerticalStackLayout>

            <!-- Source -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource SectionHeader}"
                    Text="Source"/>

                <!-- Tappable when there's a link -->
                <Label
                    IsVisible="{Binding HasSourceLink}"
                    SemanticProperties.Hint="Opens the source in your browser"
                    Style="{StaticResource LinkLabel}"
                    Text="{Binding Article.Citation}">

                    <Label.GestureRecognizers>

                        <TapGestureRecognizer
                            Command="{Binding OpenSourceCommand}"/>

                    </Label.GestureRecognizers>

                </Label>

                <!-- Plain text when there's no link -->
                <Label
                    IsVisible="{Binding HasNoSourceLink}"
                    Style="{StaticResource CardBody}"
                    Text="{Binding Article.Citation}"/>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>