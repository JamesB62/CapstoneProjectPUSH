<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Home"
             x:Class="CapstoneProjectPUSH.Views.Home.ArticleDetailsPage"
             x:DataType="vm:ArticleDetailsViewModel"
             Title="PUSH Article">

    <ContentPage.ToolbarItems>

        <ToolbarItem
            x:Name="EditToolbarItem"
            Command="{Binding EditArticleCommand}"
            Order="Secondary"
            Text="Edit Article"/>

        <ToolbarItem
            x:Name="DeleteToolbarItem"
            Command="{Binding DeleteArticleCommand}"
            Order="Secondary"
            Text="Delete Article"/>

    </ContentPage.ToolbarItems>

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30"
            Spacing="20">

            <Border
                StrokeShape="RoundRectangle 12"
                StrokeThickness="0">

                <Image
                    Aspect="AspectFill"
                    MaximumHeightRequest="200"
                    Source="{Binding Article.Image}"/>

            </Border>

            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="10">

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Grid.Column="0"
                    LineBreakMode="WordWrap"
                    Text="{Binding Article.Title}"
                    VerticalOptions="Center"/>

                <Border
                    Grid.Column="1"
                    Style="{StaticResource Pill}">

                    <Label
                        FontSize="12"
                        Text="{Binding Article.Topic}"/>

                </Border>

            </Grid>

            <!-- Info -->
            <VerticalStackLayout
                Spacing="3">

                <Label
                    Text="{Binding Article.ReadingTime, StringFormat='• Reading time: {0} min'}"/>

                <Label
                    Text="{Binding Article.DateTimePublished, StringFormat='• Published: {0:d MMM yyyy}'}"/>

            </VerticalStackLayout>

            <!-- Content -->
            <Label
                FontAttributes="Bold"
                FontSize="16"
                Text="Article Content"/>

            <Label
                Text="{Binding Article.Content}"/>

            <!-- Source -->
            <Label
                FontAttributes="Bold"
                FontSize="16"
                Text="Source"/>

            <!-- Tappable when there's a link -->
            <Label
                IsVisible="{Binding HasSourceLink}"
                Text="{Binding Article.Citation}"
                TextDecorations="Underline">

                <Label.GestureRecognizers>

                    <TapGestureRecognizer
                        Command="{Binding OpenSourceCommand}"/>

                </Label.GestureRecognizers>

            </Label>

            <!-- Plain text when there's no link -->
            <Label
                IsVisible="{Binding HasNoSourceLink}"
                Text="{Binding Article.Citation}"/>

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Text="{Binding ErrorMessage}"
                TextColor="Red"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>