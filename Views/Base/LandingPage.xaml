<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Base"
             x:Class="CapstoneProjectPUSH.Views.Base.LandingPage"
             x:DataType="vm:LandingViewModel"
             Title=""
             Shell.FlyoutBehavior="Disabled">

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30,20,30,20"
            Spacing="20"
            VerticalOptions="Center">

            <!-- Branding -->
            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="10">

                <!-- Logo -->
                <Image
                    AutomationProperties.IsInAccessibleTree="False"
                    HeightRequest="50"
                    Source="push.svg"
                    WidthRequest="50"/>

                <Label
                    Style="{StaticResource BrandTitle}"
                    Text="PUSH"/>

            </HorizontalStackLayout>

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"/>

            <!-- Buttons -->
            <VerticalStackLayout
                Spacing="10">

                <Button
                    Command="{Binding GoToLoginCommand}"
                    Text="Log In"/>

                <Button
                    Command="{Binding GoToRegisterCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Text="Register"/>

                <!-- Guest -->
                <Button
                    Command="{Binding GuestLoginCommand}"
                    SemanticProperties.Hint="Browse PUSH with limited features, no account needed"
                    Style="{StaticResource TertiaryButton}"
                    Text="Continue as Guest"/>

            </VerticalStackLayout>

            <!-- Privacy statement link -->
            <Label
                HorizontalOptions="Center"
                SemanticProperties.Hint="Opens the privacy statement"
                Style="{StaticResource LinkLabel}"
                Text="View Privacy Statement">

                <Label.GestureRecognizers>

                    <TapGestureRecognizer
                        Command="{Binding GoToPrivacyCommand}"/>

                </Label.GestureRecognizers>

            </Label>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>