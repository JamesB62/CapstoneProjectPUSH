<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CapstoneProjectPUSH.Views.Base.LandingPage"
             Title=""
             NavigationPage.HasNavigationBar="False">
    
    <Grid
        Padding="30,0,30,30"
        VerticalOptions="Fill">

        <Border
            Padding="30"
            StrokeShape="RoundRectangle 12"
            VerticalOptions="Center">

            <VerticalStackLayout
                Spacing="15">

                <!-- Branding -->
                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="10">
                    
                    <!-- Placeholder logo -->
                    <Border
                        HeightRequest="50"
                        StrokeShape="RoundRectangle 12"
                        WidthRequest="50">

                        <Label
                            FontAttributes="Bold"
                            FontSize="10"
                            HorizontalOptions="Center"
                            Text="Logo"
                            VerticalOptions="Center"/>

                    </Border>

                    <Label
                        FontSize="26"
                        FontAttributes="Bold"
                        Text="PUSH"
                        VerticalOptions="Center"/>
                    
                </HorizontalStackLayout>

                <!-- Buttons -->
                <Button
                    Clicked="LoginButtonClicked"
                    FontAttributes="Bold"
                    Text="Login"/>

                <Button
                    Clicked="RegisterButtonClicked"
                    FontAttributes="Bold"
                    Text="Register"/>

                <!-- Privacy link -->
                <Label
                    FontAttributes="Bold"
                    Text="View Privacy Statement">

                    <Label.GestureRecognizers>

                        <TapGestureRecognizer
                            Tapped="PrivacyPageButton"/>

                    </Label.GestureRecognizers>

                </Label>

            </VerticalStackLayout>
            
        </Border>
        
    </Grid>
    
</ContentPage>