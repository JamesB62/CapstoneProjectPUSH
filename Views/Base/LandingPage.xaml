<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Base"
             x:Class="CapstoneProjectPUSH.Views.Base.LandingPage"
             x:DataType="vm:LandingViewModel"
             Title=""
             Shell.FlyoutBehavior="Disabled">

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30,0,30,30"
            Spacing="15"
            VerticalOptions="Center">

            <!-- Branding -->
            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="10">

                <!-- Logo placeholder -->
                <Border
                    HeightRequest="50"
                    StrokeShape="RoundRectangle 10"
                    WidthRequest="50">

                    <Label
                        FontAttributes="Bold"
                        FontSize="10"
                        HorizontalOptions="Center"
                        Text="Logo"
                        VerticalOptions="Center"/>

                </Border>

                <Label
                    FontSize="21"
                    FontAttributes="Bold"
                    Text="PUSH"
                    VerticalOptions="Center"/>

            </HorizontalStackLayout>

            <!-- Buttons -->
            <VerticalStackLayout
                Spacing="10">

                <Button
                    Command="{Binding GoToLoginCommand}"
                    FontAttributes="Bold"
                    Text="Log In"/>

                <Button
                    Command="{Binding GoToRegisterCommand}"
                    FontAttributes="Bold"
                    Text="Register"/>

                    <!-- Guest button -->
                <Button
                    Command="{Binding GuestLoginCommand}"
                    FontAttributes="Bold"
                    Text="Continue as Guest"
                    BackgroundColor="Transparent"
                    BorderWidth="1"
                    BorderColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}"/>


            </VerticalStackLayout>

            <!-- Privacy statement link -->
            <Label
                Text="View Privacy Statement"
                TextDecorations="Underline">

                <Label.GestureRecognizers>

                    <TapGestureRecognizer
                        Command="{Binding GoToPrivacyCommand}"/>

                </Label.GestureRecognizers>

            </Label>

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Text="{Binding ErrorMessage}"
                TextColor="Red"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>