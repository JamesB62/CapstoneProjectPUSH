<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CapstoneProjectPUSH.Views.Base.FirstLoadingPage"
             Title=""
             Shell.FlyoutBehavior="Disabled">

    <VerticalStackLayout
        Padding="30,0,30,30"
        Spacing="30"
        VerticalOptions="Center">

        <!-- Splash text -->
        <VerticalStackLayout
            Spacing="5">

            <Label 
                FontAttributes="Bold"
                FontSize="21"
                HorizontalOptions="Center"
                Text="Welcome to PUSH"/>

            <Label
                HorizontalOptions="Center"
                Text="Preparing your exercise journey..."/>

        </VerticalStackLayout>

        <!-- Loading bar -->
        <ProgressBar
            x:Name="MyProgressBar"/>

    </VerticalStackLayout>
    
</ContentPage>