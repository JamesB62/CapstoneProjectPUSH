<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CapstoneProjectPUSH.Views.Base.FirstLoadingPage"
             Title=""
             Shell.FlyoutBehavior="Disabled">

    <VerticalStackLayout
        MaximumWidthRequest="500"
        Padding="30,20,30,20"
        Spacing="20"
        VerticalOptions="Center">

        <!-- Branding -->
        <VerticalStackLayout
            Spacing="10">

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="10">

                <!-- Logo -->
                <Image
                    AutomationProperties.IsInAccessibleTree="False"
                    HeightRequest="50"
                    Source="push.svg"
                    WidthRequest="50"/>

                <Label
                    Style="{StaticResource BrandTitle}"
                    Text="PUSH"/>

            </HorizontalStackLayout>

            <Label
                HorizontalOptions="Center"
                Style="{StaticResource CardBody}"
                Text="Preparing your exercise journey..."/>

        </VerticalStackLayout>

        <!-- Loading bar -->
        <ProgressBar
            x:Name="MyProgressBar"
            SemanticProperties.Description="Loading PUSH"/>

    </VerticalStackLayout>
    
</ContentPage>