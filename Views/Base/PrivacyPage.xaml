<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CapstoneProjectPUSH.Views.Base.PrivacyPage"
             Title="PUSH Privacy Statement">

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30,20,30,20"
            Spacing="20">

            <!-- Prototype notice -->
            <Border
                Style="{StaticResource NoticeCard}">

                <Label
                    Style="{StaticResource CardBody}"
                    Text="PUSH is a student project built for a capstone project. Your information is stored in a remote database and send over a secure connection."/>

            </Border>

            <!-- What information is collected -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource SectionHeader}"
                    Text="What Information Is Collected"/>

                <Label
                    Style="{StaticResource LongText}"
                    Text="When you create an account, PUSH collects your display name, email address, and password. As you use the app, it also stores the content you create: your workouts, notes and any reports you submit. You can also choose to add a profile picture and a favourite gym."/>

            </VerticalStackLayout>

            <!-- Why your information is collected -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource SectionHeader}"
                    Text="Why Your Information Is Collected"/>

                <Label
                    Style="{StaticResource LongText}"
                    Text="Your information lets PUSH sign you in, show your display name on workouts you share, save your workouts and notes, and track useful workout stats."/>

            </VerticalStackLayout>

            <!-- How your information is used -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource SectionHeader}"
                    Text="How Your Information Is Used"/>

                <Label
                    Style="{StaticResource LongText}"
                    Text="Your information is only used to power PUSH features. It isn't sold, shared with third parties or used for advertising."/>

            </VerticalStackLayout>

            <!-- Who can see your information -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource SectionHeader}"
                    Text="Who Can See Your Information"/>
                
                <Label
                    Style="{StaticResource LongText}"
                    Text="Private workouts and your notes are only visible to you. Workouts you make public appear on the Community Workouts page with your display name, where other signed-in users can view them."/>

            </VerticalStackLayout>

            <!-- Where your information is stored -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource SectionHeader}"
                    Text="Where Your Information Is Stored"/>

                <Label
                    Style="{StaticResource LongText}"
                    Text="Your information is securely in a remote database and sent over a secure HTTPS connection through the PUSH web API. Passwords are never stored in plain text – they're hashed, so your actual password can't be seen by anyone, including administrators."/>

            </VerticalStackLayout>

            <!-- How you can correct your information -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource SectionHeader}"
                    Text="How You Can Correct Your Information"/>

                <Label
                    Style="{StaticResource LongText}"
                    Text="You can update your display name, email address, password, profile picture and favourite gym from your profile at any time. You can also edit any workout or note you've created."/>

            </VerticalStackLayout>

            <!-- How you can delete your information -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource SectionHeader}"
                    Text="How You Can Delete Your Information"/>

                <Label
                    Style="{StaticResource LongText}"
                    Text="You can delete any workout or note you've created, and you can permanently delete your account at any time from your profile. Once confirmed, deleted information is removed and can't be recovered."/>

            </VerticalStackLayout>

            <!-- What administrators can see -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource SectionHeader}"
                    Text="What Administrators Can See"/>

                <Label
                    Style="{StaticResource LongText}"
                    Text="Administrators can view basic account information (display name, email address, role, account status and join date) to manage users and deactivate accounts. They can also view reported workouts and the reason provided. Administrators can't see your password or your private notes."/>

            </VerticalStackLayout>

        </VerticalStackLayout>
        
    </ScrollView>
    
</ContentPage>