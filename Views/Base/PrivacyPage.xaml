<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CapstoneProjectPUSH.Views.Base.PrivacyPage"
             Title="">

    <ScrollView>

        <VerticalStackLayout
            Padding="30,0,30,30"
            Spacing="15">

            <!-- All statements need to be updated -->
            <Label
                FontAttributes="Bold"
                FontSize="21"
                Text="Privacy Statement"/>

            <Border
                StrokeThickness="0"
                BackgroundColor="#EEF2FF"
                StrokeShape="RoundRectangle 10"
                Padding="10">

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="10">

                    <Label
                        FontSize="18"
                        Grid.Column="0"
                        Text="&#128274;"
                        VerticalOptions="Center"/>

                    <Label
                        Grid.Column="1"
                        LineBreakMode="WordWrap"
                        Text="This is a prototype app. Your data is stored securely in a remote database, accessed through a .NET Web API."
                        TextColor="#4F46E5"
                        VerticalOptions="Center"/>

                </Grid>

            </Border>

            <VerticalStackLayout
                Spacing="10">

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="What Information Is Collected"/>

                <Label
                    LineBreakMode="WordWrap"
                    Text="When you create a PUSH account, we collect your display name, email address, and password. We also store the workouts you create and application usage data for statistical purposes."/>

            </VerticalStackLayout>

            <VerticalStackLayout
                Spacing="10">

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Why Your Information Is Collected"/>

                <Label
                    LineBreakMode="WordWrap"
                    Text="The information collected so the application can sign you in, attribute content to your account, track your progress, and save shared workouts."/>

            </VerticalStackLayout>

            <VerticalStackLayout
                Spacing="10">

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="How Your Information Is Used"/>

                <Label
                    LineBreakMode="WordWrap"
                    Text="Your information is only used to power app features. It is not shared with any third parties or used for any other purpose outside the app."/>

            </VerticalStackLayout>

            <VerticalStackLayout
                Spacing="10">

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Where Your Information Is Stored"/>

                <Label
                    LineBreakMode="WordWrap"
                    Text="Your information is stored securely in a remote database. Passwords are never stored in plain text – they're hashed, so your password cannot be exposed."/>

            </VerticalStackLayout>

            <VerticalStackLayout
                Spacing="10">

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="How You Can Correct Your Information"/>

                <Label
                    LineBreakMode="WordWrap"
                    Text="You can update your account details or edit any workout or note at any time – just open the item, make changes, and save."/>

            </VerticalStackLayout>

            <VerticalStackLayout
                Spacing="10">

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="How You Can Delete Your Information"/>

                <Label
                    LineBreakMode="WordWrap"
                    Text="You can delete any workout or note you've created at any time. Once confirmed, it's permanently removed and cannot be recovered."/>

            </VerticalStackLayout>

            <VerticalStackLayout
                Spacing="10">

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="What Administrators Can See"/>

                <Label
                    LineBreakMode="WordWrap"
                    Text="Administrators can view reported workouts as part of the moderation process, and can view basic account information to manage users. Administrators do not have access to your password or personal notes."/>

            </VerticalStackLayout>

        </VerticalStackLayout>
        
    </ScrollView>
    
</ContentPage>