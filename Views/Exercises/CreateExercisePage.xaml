<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Exercises"
             x:Class="CapstoneProjectPUSH.Views.Exercises.CreateExercisePage"
             x:DataType="vm:CreateExerciseViewModel"
             Title="{Binding PageTitle}">

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30,20,30,20"
            Spacing="20">

            <!-- Photo -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Photo"/>

                <Grid
                    ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="10">

                    <Label
                        Grid.Column="0"
                        Style="{StaticResource CardBody}"
                        Text="{Binding PhotoStatusText}"
                        VerticalOptions="Center"/>

                    <Button                        
                        Command="{Binding ChangePhotoCommand}"
                        Grid.Column="1"
                        SemanticProperties.Description="Change photo"
                        Style="{StaticResource SecondaryButton}"
                        Text="Change"/>

                    <Button
                        Command="{Binding RemovePhotoCommand}"
                        Grid.Column="2"
                        IsVisible="{Binding HasExerciseImage}"
                        SemanticProperties.Description="Remove photo"
                        Style="{StaticResource SecondaryButton}"
                        Text="Remove"/>

                </Grid>

            </VerticalStackLayout>

            <!-- Title -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Title"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Entry
                        MaxLength="100"
                        Placeholder="Enter the exercise's title here"
                        SemanticProperties.Hint="Title"
                        Text="{Binding Title}"/>

                </Border>

            </VerticalStackLayout>

            <!-- Category -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Category"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Picker
                        ItemDisplayBinding="{Binding Title, x:DataType=models:Category}"
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory}"
                        SemanticProperties.Hint="Category"
                        Title="Choose a category"/>

                </Border>

            </VerticalStackLayout>

            <!-- Difficulty -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Difficulty"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Picker
                        ItemsSource="{Binding DifficultyOptions}"
                        SelectedIndex="{Binding SelectedDifficultyIndex}"
                        SemanticProperties.Hint="Difficulty"
                        Title="Choose a difficulty"/>

                </Border>

            </VerticalStackLayout>

            <!-- Description -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource FieldLabel}"
                    Text="Description"/>

                <Border
                    Style="{StaticResource InputFrame}">

                    <Editor
                        AutoSize="TextChanges"
                        MaxLength="1000"
                        MinimumHeightRequest="100"
                        Placeholder="Explain how to perform the exercise"
                        SemanticProperties.Hint="Description"
                        Text="{Binding Description}"/>

                </Border>

            </VerticalStackLayout>

            <!-- Timed -->
            <VerticalStackLayout
                Spacing="10">

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="10">

                    <Label
                        AutomationProperties.IsInAccessibleTree="False"
                        Grid.Column="0"
                        Style="{StaticResource FieldLabel}"
                        Text="Timed exercise"
                        VerticalOptions="Center"/>

                    <Switch
                        Grid.Column="1"
                        IsToggled="{Binding IsTimed}"
                        SemanticProperties.Description="Timed exercise"
                        SemanticProperties.Hint="Turn on for exercises done for a length of time instead of reps"
                        VerticalOptions="Center"/>

                </Grid>

                <Label
                    AutomationProperties.IsInAccessibleTree="False"
                    Style="{StaticResource HintLabel}"
                    Text="Turn on for exercises done for a length of time instead of reps."/>

            </VerticalStackLayout>

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"/>

            <!-- Buttons -->
            <VerticalStackLayout
                Spacing="10">

                <Button
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Text="{Binding SaveButtonText}"/>

                <Button
                    Command="{Binding CancelCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource SecondaryButton}"
                    Text="Cancel"/>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>