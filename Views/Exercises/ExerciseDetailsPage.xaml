<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Exercises"
             x:Class="CapstoneProjectPUSH.Views.Exercises.ExerciseDetailsPage"
             x:DataType="vm:ExerciseDetailsViewModel"
             Title="PUSH Exercise Details">

    <ContentPage.ToolbarItems>

        <ToolbarItem
            x:Name="EditToolbarItem"
            Command="{Binding EditExerciseCommand}"
            Order="Secondary"
            Text="Edit Exercise"/>

        <ToolbarItem
            x:Name="DeleteToolbarItem"
            Command="{Binding DeleteExerciseCommand}"
            Order="Secondary"
            Text="Delete Exercise"/>

    </ContentPage.ToolbarItems>

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30"
            Spacing="20">

            <!-- Placeholder image -->
            <Border
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12">

                <Image
                    Aspect="AspectFill"
                    MaximumHeightRequest="400"
                    Source="{Binding Exercise.Image}"/>

            </Border>

            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="15">

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Grid.Column="0"
                    LineBreakMode="WordWrap"
                    Text="{Binding Exercise.Title}"
                    VerticalOptions="Center"/>

                <Border
                    Grid.Column="1"
                    Style="{StaticResource Pill}">

                    <Label
                        FontSize="12"
                        Text="{Binding Exercise.CategoryTitle}"/>

                </Border>

            </Grid>

            <Label
                FontAttributes="Bold"
                FontSize="16"
                Text="About This Exercise"/>

            <Label
                Text="{Binding Exercise.Description}"/>

            <Label
                Text="{Binding Exercise.DifficultyLabel, StringFormat='• Difficulty: {0}'}"/>

            <!-- Add recommended reps/duration? -->

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Text="{Binding ErrorMessage}"
                TextColor="Red"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>