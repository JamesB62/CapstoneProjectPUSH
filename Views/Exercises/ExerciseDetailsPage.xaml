<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Exercises"
             x:Class="CapstoneProjectPUSH.Views.Exercises.ExerciseDetailsPage"
             x:DataType="vm:ExerciseDetailsViewModel"
             Title="PUSH Exercise Details">

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30,15"
            Spacing="15">

            <!-- Placeholder image -->
            <Border
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12">

                <Image
                    Aspect="AspectFill"
                    MaximumHeightRequest="400"
                    Source="{Binding Exercise.Image}"/>

            </Border>

            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="15">

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Grid.Column="0"
                    LineBreakMode="WordWrap"
                    Text="{Binding Exercise.Title}"
                    VerticalOptions="Center"/>

                <Border
                    Grid.Column="1"
                    Style="{StaticResource Pill}">

                    <Label
                        FontSize="12"
                        Text="{Binding Exercise.CategoryTitle}"/>

                </Border>

            </Grid>

            <Label
                FontAttributes="Bold"
                FontSize="16"
                Text="About This Exercise"/>

            <Label
                Text="{Binding Exercise.Description}"/>

            <Label
                FontAttributes="Italic"
                Text="{Binding Exercise.DifficultyLabel, StringFormat='•  Difficulty: {0}'}"/>

            <!-- Add recommended reps/duration? -->
            
        </VerticalStackLayout>

    </ScrollView>

</ContentPage>