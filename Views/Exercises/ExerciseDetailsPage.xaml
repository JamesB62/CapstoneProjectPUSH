<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Exercises"
             x:Class="CapstoneProjectPUSH.Views.Exercises.ExerciseDetailsPage"
             x:DataType="vm:ExerciseDetailsViewModel"
             Title="PUSH Exercise Details">

    <ScrollView>

        <VerticalStackLayout
            Padding="30,0,30,0"
            Spacing="15">

            <!-- Placeholder image !!!MUST CHANGE BEFORE DEPLOYMENT!!! -->
            <Border
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12">

                <Image
                    Aspect="AspectFill"
                    MaximumHeightRequest="400"
                    Source="exercise_placeholder.jpg"/>

            </Border>

            <!-- Add placeholder image here? -->
            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="15">

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Grid.Column="0"
                    LineBreakMode="WordWrap"
                    Text="{Binding Exercise.Title}"
                    VerticalOptions="Center"/>

                <Border
                    Grid.Column="1"
                    Padding="10,5"
                    StrokeShape="RoundRectangle 50"
                    VerticalOptions="Start">

                    <Label
                        FontSize="12"
                        Text="{Binding Exercise.CategoryName}"/>

                </Border>

            </Grid>

            <Label
                FontAttributes="Bold"
                FontSize="16"
                Text="About This Exercise"/>

            <Label
                Text="{Binding Exercise.Description}"/>

            <Label
                FontAttributes="Italic"
                Text="{Binding Exercise.Difficulty, StringFormat='•  Difficulty: {0}'}"/>

            <!-- Add recommended reps/duration? -->
            
        </VerticalStackLayout>

    </ScrollView>

</ContentPage>