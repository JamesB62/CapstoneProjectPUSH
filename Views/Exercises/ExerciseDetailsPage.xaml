<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Exercises"
             x:Class="CapstoneProjectPUSH.Views.Exercises.ExerciseDetailsPage"
             x:DataType="vm:ExerciseDetailsViewModel"
             Title="PUSH Exercise Details">

    <ContentPage.ToolbarItems>

        <ToolbarItem
            x:Name="EditToolbarItem"
            Command="{Binding EditExerciseCommand}"
            Order="Secondary"
            Text="Edit Exercise"/>

        <ToolbarItem
            x:Name="DeleteToolbarItem"
            Command="{Binding DeleteExerciseCommand}"
            Order="Secondary"
            Text="Delete Exercise"/>

    </ContentPage.ToolbarItems>

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            Padding="30,20,30,20"
            Spacing="20">

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"/>

            <!-- Placeholder image -->
            <Border
                StrokeShape="RoundRectangle 12"
                StrokeThickness="0">

                <Image
                    Aspect="AspectFill"
                    AutomationProperties.IsInAccessibleTree="False"
                    MaximumHeightRequest="400"
                    Source="{Binding Exercise.Image}"/>

            </Border>

            <!-- Title, category and difficulty -->
            <VerticalStackLayout
                Spacing="10">

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="10">

                    <Label
                        Grid.Column="0"
                        Style="{StaticResource DetailTitle}"
                        Text="{Binding Exercise.Title}"
                        VerticalOptions="Center"/>

                    <Border
                        Grid.Column="1"
                        Style="{StaticResource Pill}"
                        VerticalOptions="Start">

                        <Label
                            Style="{StaticResource PillLabel}"
                            Text="{Binding Exercise.CategoryTitle}"/>

                    </Border>

                </Grid>

                <Label
                    Margin="0,8,0,0"
                    Style="{StaticResource CardCredit}"
                    Text="{Binding Exercise.DifficultyLabel, StringFormat='Difficulty: {0}'}"/>

            </VerticalStackLayout>
            
            <!-- About -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Style="{StaticResource SectionHeader}"
                    Text="About This Exercise"/>

                <Label
                    Style="{StaticResource LongText}"
                    Text="{Binding Exercise.Description}"/>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>