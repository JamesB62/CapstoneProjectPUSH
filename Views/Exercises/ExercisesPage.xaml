<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Exercises"
             x:Class="CapstoneProjectPUSH.Views.Exercises.ExercisesPage"
             x:DataType="vm:ExercisesViewModel"
             Title="PUSH Exercises">

    <ContentPage.ToolbarItems>

        <ToolbarItem
            x:Name="AddExerciseToolbarItem"
            Command="{Binding AddExerciseCommand}"
            Order="Secondary"
            Text="Add Exercise"/>

    </ContentPage.ToolbarItems>

    <Grid
        MaximumWidthRequest="500"
        Padding="30,20,30,0"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="20">

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="20">

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"/>

            <!-- Search bar -->
            <Border
                Style="{StaticResource InputFrame}">

                <SearchBar
                    Placeholder="Search by title or category..."
                    SemanticProperties.Hint="Search exercises"
                    Text="{Binding SearchText}"/>

            </Border>

        </VerticalStackLayout>

        <!-- Count and swipe hint (admins only) -->
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="5">

            <Label
                Style="{StaticResource StatusLabel}"
                Text="{Binding StatusMessage}"/>

            <Label
                IsVisible="{Binding IsCurrentUserAdmin}"
                Style="{StaticResource HintLabel}"
                Text="Swipe right to edit or left to delete."/>

        </VerticalStackLayout>

        <RefreshView
            Command="{Binding LoadExercisesCommand}"
            Grid.Row="2"
            IsRefreshing="{Binding IsBusy}">

            <CollectionView
                ItemsSource="{Binding Exercises}"
                SelectedItem="{Binding SelectedExercise, Mode=TwoWay}"
                SelectionMode="Single">

                <!-- Empty view -->
                <CollectionView.EmptyView>

                    <Grid>

                        <VerticalStackLayout
                            HorizontalOptions="Center"
                            Spacing="5"
                            VerticalOptions="Center">

                            <Label
                                Style="{StaticResource EmptyLabel}"
                                Text="No exercises found."/>

                            <Label
                                Style="{StaticResource EmptyLabel}"
                                Text="Pull down to try again."/>

                        </VerticalStackLayout>

                    </Grid>

                </CollectionView.EmptyView>

                <!-- Items layout -->
                <CollectionView.ItemsLayout>

                    <LinearItemsLayout
                        ItemSpacing="15"
                        Orientation="Vertical"/>

                </CollectionView.ItemsLayout>

                <!-- Item template -->
                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:Exercise">

                        <Border
                            Style="{StaticResource SwipeClip}">

                            <SwipeView>

                                <!-- Swipe actions (admins only) -->
                                <SwipeView.LeftItems>

                                    <SwipeItems>

                                        <SwipeItem
                                            BackgroundColor="{StaticResource SwipeEdit}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExercisesViewModel}}, Path=EditExerciseCommand}"
                                            CommandParameter="{Binding .}"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ExercisesViewModel}}, Path=IsCurrentUserAdmin}"
                                            Text="Edit"/>

                                    </SwipeItems>

                                </SwipeView.LeftItems>

                                <SwipeView.RightItems>

                                    <SwipeItems>

                                        <SwipeItem
                                            BackgroundColor="{StaticResource SwipeDelete}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExercisesViewModel}}, Path=DeleteExerciseCommand}"
                                            CommandParameter="{Binding .}"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ExercisesViewModel}}, Path=IsCurrentUserAdmin}"
                                            Text="Delete"/>

                                    </SwipeItems>

                                </SwipeView.RightItems>

                                <!-- Card -->
                                <Border
                                    Style="{StaticResource SwipeCard}">

                                    <VerticalStackLayout
                                        Spacing="10">

                                        <!-- Title and category pill -->
                                        <Grid
                                            ColumnDefinitions="*,auto"
                                            ColumnSpacing="10">

                                            <Label
                                                Grid.Column="0"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="2"
                                                Style="{StaticResource CardTitle}"
                                                Text="{Binding Title}"/>

                                            <Border
                                                Grid.Column="1"
                                                Style="{StaticResource Pill}"
                                                VerticalOptions="Start">

                                                <Label
                                                    Style="{StaticResource PillLabel}"
                                                    Text="{Binding CategoryTitle}"/>

                                            </Border>

                                        </Grid>

                                        <!-- Description preview -->
                                        <Label
                                            AutomationProperties.IsInAccessibleTree="False"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="2"
                                            Style="{StaticResource CardBody}"
                                            Text="{Binding Description}"/>

                                        <!-- Difficulty -->
                                        <Label
                                            Style="{StaticResource CardCredit}"
                                            Text="{Binding DifficultyLabel, StringFormat='Difficulty: {0}'}"/>

                                    </VerticalStackLayout>

                                </Border>
                            
                            </SwipeView>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>
    
</ContentPage>