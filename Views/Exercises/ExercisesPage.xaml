<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CapstoneProjectPUSH.Models"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Exercises"
             x:Class="CapstoneProjectPUSH.Views.Exercises.ExercisesPage"
             x:DataType="vm:ExercisesViewModel"
             Title="PUSH Exercises">

    <ContentPage.ToolbarItems>

        <ToolbarItem
            x:Name="AddExerciseToolbarItem"
            Command="{Binding AddExerciseCommand}"
            Text="+ Add"/>

    </ContentPage.ToolbarItems>

    <Grid
        MaximumWidthRequest="500"
        Padding="30,15,30,0"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="20">

        <!-- Search bar -->
        <SearchBar
            Grid.Row="0"
            Placeholder="Search by title or category..."
            Text="{Binding SearchText}"/>

        <VerticalStackLayout
            Grid.Row="1"
            Spacing="15">

            <!-- Status message -->
            <Label
                Text="{Binding StatusMessage}"/>

            <!-- Error message -->
            <Label
                IsVisible="{Binding HasErrorMessage}"
                Text="{Binding ErrorMessage}"
                TextColor="Red"/>

        </VerticalStackLayout>

        <RefreshView
            Command="{Binding LoadExercisesCommand}"
            Grid.Row="2"
            IsRefreshing="{Binding IsBusy}">

            <CollectionView
                ItemsSource="{Binding Exercises}"
                SelectedItem="{Binding SelectedExercise, Mode=TwoWay}"
                SelectionMode="Single">

                <!-- Empty view -->
                <CollectionView.EmptyView>

                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Label
                            FontAttributes="Italic"
                            HorizontalTextAlignment="Center"
                            Text="No exercises found."/>

                        <Label
                            FontAttributes="Italic"
                            HorizontalTextAlignment="Center"
                            Text="Pull down to try again."/>

                    </VerticalStackLayout>

                </CollectionView.EmptyView>

                <!-- Item layout -->
                <CollectionView.ItemsLayout>

                    <LinearItemsLayout
                        ItemSpacing="10"
                        Orientation="Vertical"/>

                </CollectionView.ItemsLayout>

                <!-- Item template -->
                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:Exercise">

                        <SwipeView>

                            <!-- Swipe actions (admins only) -->
                            <SwipeView.LeftItems>

                                <SwipeItems>

                                    <SwipeItem
                                        BackgroundColor="#6B7280"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExercisesViewModel}}, Path=EditExerciseCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ExercisesViewModel}}, Path=IsCurrentUserAdmin}"
                                        Text="Edit"/>

                                </SwipeItems>

                            </SwipeView.LeftItems>

                            <SwipeView.RightItems>

                                <SwipeItems>

                                    <SwipeItem
                                        BackgroundColor="Red"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExercisesViewModel}}, Path=DeleteExerciseCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ExercisesViewModel}}, Path=IsCurrentUserAdmin}"
                                        Text="Delete"/>

                                </SwipeItems>

                            </SwipeView.RightItems>

                            <!-- Card -->
                            <Border
                                Style="{StaticResource Card}">

                                <VerticalStackLayout
                                    Spacing="10">

                                    <Grid
                                        ColumnDefinitions="*,auto"
                                        ColumnSpacing="10">

                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            Grid.Column="0"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Title}"
                                            VerticalOptions="Center"/>

                                        <Border
                                            Grid.Column="1"
                                            Style="{StaticResource Pill}">

                                            <Label
                                                FontSize="12"
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding CategoryTitle}"/>

                                        </Border>

                                    </Grid>

                                    <!-- Description -->
                                    <Label
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2"
                                        Text="{Binding Description}"/>

                                    <!-- Info -->
                                    <Label
                                        Text="{Binding DifficultyLabel, StringFormat='• Difficulty: {0}'}"/>

                                </VerticalStackLayout>

                            </Border>
                            
                        </SwipeView>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>
    
</ContentPage>