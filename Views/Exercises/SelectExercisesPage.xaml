<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CapstoneProjectPUSH.ViewModels.Exercises"
             x:Class="CapstoneProjectPUSH.Views.Exercises.SelectExercisesPage"
             x:DataType="vm:ExercisesViewModel"
             Title="SelectExercisesPage">

             
    <Grid RowDefinitions="*,Auto">

        <Grid Grid.Row="0"
              Padding="20,20,20,0"
              RowDefinitions="Auto,*"
              RowSpacing="15">

            <SearchBar Grid.Row="0"
                       Placeholder="Search exercises"
                       Text="{Binding SearchText}"/>

            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding Exercises}"
                            SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="10"
                            Orientation="Vertical"/>
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <Label HorizontalOptions="Center"
                           Text="No exercises found."
                           VerticalOptions="Center"/>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SelectableExercise">
                        <Border Padding="15"
                                BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#2C2C31}"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="0">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleCommand}"/>
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="*,Auto"
                                    ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0"
                                        Spacing="4">
                                    <Label FontAttributes="Bold"
                                            Text="{Binding Exercise.Title}"/>
                                    <Label FontSize="12"
                                            Text="{Binding CategoryName}"/>
                                    <Label FontSize="12"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2"
                                           Text="{Binding Exercise.Description}"/>
                                </VerticalStackLayout>

                                <CheckBox Grid.Column="1"
                                          InputTransparent="True"
                                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Button Grid.Row="1"
                Margin="20"
                Command="{Binding DoneCommand}"
                Text="{Binding SelectedCount, StringFormat='Done ({0})'}"/>
    </Grid>

</ContentPage>